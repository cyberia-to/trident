  "probe_wrapper_source": "program compiler_pipeline_fixture\nuse vm.io.mem\nuse vm.core.convert\nuse std.compiler.pipeline\nfn main() {\nlet n = pub_read()\nassert(convert.as_u32(n) < convert.as_u32(1025))\nfor i in 0..n bounded 1024 { mem.write(1000 + convert.as_field(i), pub_read()) }\nmem.write(2000 + 0,1000)\nmem.write(2000 + 1,n)\nmem.write(2000 + 4,1)\nmem.write(2000 + 5,5)\nmem.write(2000 + 6,10)\nmem.write(2000 + 7,3)\nmem.write(2000 + 8,16)\nmem.write(2000 + 9,1073741824)\nmem.write(2000 + 10,100000)\npipeline.compile(2000)\n\nlet count = mem.read(2003)\nlet base = mem.read(2002)\npub_write(count)\npub_write(mem.read(2011))\nfor i in 0..count bounded 1024 {\npub_write(mem.read(base + convert.as_field(i) * 4 + 0))\npub_write(mem.read(base + convert.as_field(i) * 4 + 1))\npub_write(mem.read(base + convert.as_field(i) * 4 + 2))\npub_write(mem.read(base + convert.as_field(i) * 4 + 3))\n}\n}\n",
