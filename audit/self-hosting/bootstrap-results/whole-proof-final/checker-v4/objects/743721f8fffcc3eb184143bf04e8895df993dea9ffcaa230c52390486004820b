class CompositeTests(unittest.TestCase):
    def setUp(self):
        old=[dict(name=n) for n in common.PRIOR]
        additional=[dict(name=n) for n in common.ADDITIONAL]
        self.prior=dict(controls=[dict(name='original-fresh-verification'),dict(name='rechain')],
                        original_v2=dict(rejections=old),additional_v3=dict(rejections=additional))
        self.profile={'p':1};self.positive={'proof':{'bytes':1,'sha256':'a'*64}}
        self.suite=dict(schema='trident/whole-self-build-certificate-completion/v4',status='passed-completion',
                        generation=2,profile=self.profile,original_proof=self.positive['proof'],prior_cases=self.prior,
                        immutable_inputs_before={'i':1},rejections=[dict(name=n) for n in common.NEW],
                        immutable_inputs_after={'i':1},ended_ns=100)

    def review(self):cases.suite_contract(self.suite,2,self.prior,self.positive,self.profile)

    def test_exact_composite(self):self.review()

    def test_no_fabricated_fresh_controls(self):
        self.suite['controls']=self.prior['controls']
        with self.assertRaises(ValueError):self.review()

    def test_incomplete_suite_not_promoted(self):
        self.suite['status']='running'
        with self.assertRaises(ValueError):self.review()

    def test_failed_suite_not_promoted(self):
        self.suite['status']='failed'
        with self.assertRaises(ValueError):self.review()

    def test_hidden_input_failure(self):
        self.suite['input_error']='input changed'
        with self.assertRaises(ValueError):self.review()

    def test_wrong_original_proof(self):
        self.suite['original_proof']={'bytes':2,'sha256':'b'*64}
        with self.assertRaises(ValueError):self.review()

    def test_prelude_exact_serializer_reconstruction(self):
        snapshot=dict(self.suite,status='running',rejections=[self.suite['rejections'][0]])
        snapshot.pop('immutable_inputs_after');snapshot.pop('ended_ns')
        raw=(json.dumps(snapshot,indent=2)+'\n').encode()
        self.assertEqual(dict(bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),transitions.prelude_snapshot(self.suite))

    def test_prelude_binds_original_cost_row(self):
        original=transitions.prelude_snapshot(self.suite)
        self.suite['rejections'][0]={'name':'generation'}
        self.assertNotEqual(original,transitions.prelude_snapshot(self.suite))

    def test_prelude_binds_prior_admission(self):
        original=transitions.prelude_snapshot(self.suite)
        self.suite['prior_cases']={'changed':True}
        self.assertNotEqual(original,transitions.prelude_snapshot(self.suite))

    def test_failed_snapshot_cannot_reconstruct_success(self):
        self.suite['error']='failure'
        with self.assertRaises(ValueError):transitions.prelude_snapshot(self.suite)

    def test_partial_source_review_cannot_activate(self):
        with patch.object(check,'load',side_effect=[{'x':1},{'status':'passed-source-review','sources':{}}]),self.assertRaises(ValueError):
            check.source_gate()


