"""Offline exact draft predicates: no external transfer or collector execution."""
import ast,json,sys
from pathlib import Path
D=Path(__file__).resolve().parent/'draft-1'
sys.path.insert(0,str(D))
import http_policy as policy
from collection_common import require,SCOPES,GIB
response={'status':503,'fields':{'retry-after':['Thu, 01 Jan 1970 00:18:40 GMT']}}
runtime=policy.retry(22,response,now=1000)
replay=policy.retry(22,response,now=1001)
assert (runtime,replay)==(120,119)
module=ast.parse((D/'validate.py').read_text())
fn=next(n for n in module.body if isinstance(n,ast.FunctionDef) and n.name=='admit')
start=next(i for i,n in enumerate(fn.body) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='accounting' for t in n.targets))
nodes=fn.body[start:start+3]
assert isinstance(nodes[0],ast.Assign) and isinstance(nodes[1],ast.Expr) and isinstance(nodes[2],ast.For)
code=compile(ast.fix_missing_locations(ast.Module(body=nodes,type_ignores=[])),str(D/'validate.py'),'exec')
bad={'peak_bytes':-1,'scans':1,'reconciliations':[{'bytes':-1,'scope_bytes':[-1]+[0]*(len(SCOPES)-1)}]}
exec(code,{'r':{'accounting':bad},'require':require,'GIB':GIB,'SCOPES':SCOPES})
print(json.dumps({'status':'both draft findings reproduced','runtime_delay':runtime,'replay_delay':replay,'negative_accounting_accepted':True}))
