"""Offline peer-launch admission, independent of the collector's mutable state."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent
R2 = ROOT.parents[1]
COLLECTOR = ROOT.parent / 'pr117-completion-v4'
OWNER = ROOT.parent / 'pr117-completion-v4-owner-replay-1'
