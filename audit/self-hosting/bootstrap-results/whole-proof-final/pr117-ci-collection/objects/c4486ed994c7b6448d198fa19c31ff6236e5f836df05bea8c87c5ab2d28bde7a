PYTHON = Path('/opt/homebrew/Cellar/python@3.14/3.14.5/Frameworks/Python.framework/Versions/3.14/bin/python3.14')
MIB = 1024 ** 2
GIB = 1024 ** 3
SOURCE = dict(bytes=16156, sha256='5530745285c1b0090bf0dfb542e13b97b7279af64b78c363d1e7f11461ea7baf')
REVIEW = dict(bytes=20776, sha256='1f46cf59a522b5b3aa1ab36fbd7b821bb9fce6f09cd204a10ad348b4b36d6fee')
ORIGIN = dict(run_id='37002840888', run_attempt='1', head_sha='10772124836b68a2df011c912b5776b2454a511f')
