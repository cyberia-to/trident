            require(not raw.stderr,'quiet committed source read');(implementation/name).write_bytes(raw.stdout);source_records[name]=dict(command=command,identity=identity(implementation/name))
        for name in ('selfhost-bootstrap.yml','selfhost-bootstrap-repeat.yml'):
            raw=subprocess.run(['git','show',head+':.github/workflows/'+name],cwd=args.git_repo,capture_output=True,timeout=30,check=True);require(not raw.stderr,'quiet committed workflow read');(implementation/name).write_bytes(raw.stdout)
        text=(implementation/'selfhost-bootstrap.yml').read_text();pairs=re.findall(r'"(joy|nox|hemera|strata|zheng|bbg|lens|neuron)":"([0-9a-f]{40})"',text)
        pins=dict(pairs);pins['trident']=head;require(len(pins)==9 and all(v==pins[k] for k,v in pairs),'exact committed nine-repository workflow pins')
        require('--rust-version 1.95.0' in (implementation/'selfhost-bootstrap-repeat.yml').read_text(),'exact existing native Rust1.95 profile')
        sys.path.insert(0,str(implementation));spec=importlib.util.spec_from_file_location('bootstrap_phase_checks',implementation/'bootstrap_phase_checks.py');check=importlib.util.module_from_spec(spec);spec.loader.exec_module(check)
        expected_names={f'bootstrap-phase-{target}-repeat-{repeat}-{role}-attempt-{attempt}':(target,repeat,role) for target in check.B.TARGETS for repeat in (1,2) for role in ('producer','c2','c3')}
        aggregate_name=f'bootstrap-phase-matrix-comparison-attempt-{attempt}';require({a['name'] for a in assets}==set(expected_names)|{aggregate_name},'exact original platform/phase/repetition inventory')
        reports=[];selected_jobs=set()
