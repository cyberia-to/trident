        compiler=check.compare_matrix(reports,origin);require(compiler==COMPILER,'all12 native C2/C3 pairs and24 compiler corpora independently replayed')
        aggregate_root=Path(collected['archives'][aggregate_name]['storage']['tree']);aggregate=load(aggregate_root/'receipt.json');require(aggregate['schema']==check.SCHEMA and aggregate['phase']=='matrix' and aggregate['status']=='passed' and aggregate['ci_origin']==origin and aggregate['implementation']==check.implementation() and aggregate['compiler_sha256']==compiler,'original Actions aggregate agrees')
        original={Path(r['path'].replace('\\','/')).parent.name:r['sha256'] for r in aggregate['phase_reports']}
        require(len(aggregate['phase_reports'])==len(original)==36 and original=={r.name:identity(r/'receipt.json')['sha256'] for r,_ in reports},'all36 original aggregate receipt identities')
        require(load(aggregate_root/'files.json')=={} and {k:aggregate['files'][k] for k in ('bytes','sha256')}==identity(aggregate_root/'files.json'),'original aggregate manifest')
        require(identity(data/'receipt.json')==report['collection'],'original collection stayed unchanged')
        report.update(status='passed-original-matrix-replay-completion',compiler_sha256=compiler,source_pins=pins,checker_sources=source_records,native_producers=12,native_corpus_jobs=24,observations_per_corpus_job=sum(check.B.CORPORA.values()))
    except BaseException:
