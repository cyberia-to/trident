MIB=1024**2
COMPILER='76a07c08265bd2ef525164472b6b53ac3f0e6cbbedce3250c4202f40ffba34c8'

def require(value,reason):
    if not value:raise ValueError(reason)

def identity(path):
    require(path.is_file() and not path.is_symlink(),'regular retained file')
    with path.open('rb') as source:digest=hashlib.file_digest(source,'sha256').hexdigest()
    return dict(bytes=path.stat().st_size,sha256=digest)

def load(path):
    require(path.stat().st_size<=32*MIB,'bounded metadata JSON')
    return json.loads(path.read_text())

def tree(path):
    paths=list(path.rglob('*'));require(len(paths)<=50000 and all(not p.is_symlink() for p in paths),'bounded ordinary retained tree')
    return {str(p.relative_to(path)):identity(p) for p in paths if p.is_file()}

def zip_members(path):
    result={}
    with zipfile.ZipFile(path) as archive:
        members=archive.infolist();require(len(members)<=10000,'bounded original archive entries')
        require(sum(m.file_size for m in members)<=1024**3,'bounded original archive expansion')
        for member in members:
            if member.is_dir():continue
            require(member.filename not in result,'distinct original archive member')
            with archive.open(member) as source:digest=hashlib.file_digest(source,'sha256').hexdigest()
            result[member.filename]=dict(bytes=member.file_size,sha256=digest)
    return result

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--collection',type=Path,required=True);parser.add_argument('--git-repo',type=Path,required=True);parser.add_argument('--output',type=Path,required=True);args=parser.parse_args()
    require(not args.output.exists(),'new isolated replay output');args.output.mkdir();start=time.time_ns()
    report=dict(schema='trident/original-native-phase-matrix-replay-completion/v4',status='running',started_ns=start,checker=identity(Path(__file__)),command=[sys.executable,*sys.argv],scope='Complete original Actions metadata/ZIP/member receipt replay with the exact committed phase checker; no compiler, prover, native executable or corpus rerun; separate from SH7/SH8 proof acceptance')
