        require(run_value['id']==run and run_value['head_sha']==head and run_value['run_attempt']==attempt and run_value['conclusion']=='success' and run_value['status']=='completed','exact entire original run passed')
        require(jobs['total_count']==len(jobs['jobs'])==37 and all(j['run_id']==run and j['head_sha']==head and j['run_attempt']==attempt and j['conclusion']=='success' and j['status']=='completed' for j in jobs['jobs']),'all37 actual native jobs passed')
        require(len(assets)==37 and len(collected['archives'])==38 and len(collected['members'])==38,'all37 original artifacts plus original attempt logs')
        report.update(origin=origin,collection=identity(data/'receipt.json'),reused_original_archives=5,reused_v2_archives=11,reused_v3_archives=6,continuation_original_archives=15,previous_failed_continuation=collected['history']['v3'],cumulative_attempt_history=collected['prior_attempts'],final_accounting=identity(data/'final-accounting.json'),original_metadata={name:identity(OLD/(name+'.json')) for name in ('run','jobs','artifacts')},archives={},phases=[])
        for name,wanted in collected['archives'].items():
            plain={k:wanted[k] for k in ('bytes','sha256')};require(identity(Path(wanted['storage']['zip']))==plain,'original ZIP whole identity')
            require(tree(Path(wanted['storage']['tree']))==collected['members'][name]==zip_members(Path(wanted['storage']['zip'])),'all original ZIP members and restored bytes independently equal')
