                asset=matches[0];require(asset['digest']=='sha256:'+plain['sha256'] and asset['size_in_bytes']==plain['bytes'] and asset['workflow_run']['id']==run and asset['workflow_run']['head_sha']==head,'server digest/run/size binding')
            report['archives'][name]=dict(**plain,files=len(collected['members'][name]),decoded_bytes=sum(v['bytes'] for v in collected['members'][name].values()))
        # validate.admit checked every successful and failed original/new transport row.
        implementation=args.output/'implementation';implementation.mkdir();source_records={}
        for name in ('bootstrap-runner.py','bootstrap-phases.py','bootstrap_phase_checks.py'):
