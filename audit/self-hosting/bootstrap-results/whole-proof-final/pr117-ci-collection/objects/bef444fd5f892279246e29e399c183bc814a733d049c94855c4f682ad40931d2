            require(value['ci_origin']==origin and value['implementation']==check.implementation(),'exact original checker/CI source')
            job_name=f'Bootstrap {target} repeat {repeat} / '+('Self-build C2 and C3' if role=='producer' else 'Corpus C'+role[1]);matches=[j for j in jobs['jobs'] if j['name']==job_name]
            require(len(matches)==1 and matches[0]['id'] not in selected_jobs,'distinct corresponding original native job');selected_jobs.add(matches[0]['id'])
            if role=='producer':
