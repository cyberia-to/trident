"""Explicit curl attempts; all byte streams and waits are bounded and retained."""
import os,selectors,subprocess,sys,time,traceback
from pathlib import Path
from collection_common import ROOT,PROFILE,RATE,MIB,identity,save,sources,require
import http_policy as policy
sys.path.insert(0,str(ROOT.parents[1]/'whole-retention-adoption'))
from transport import stop

class RetryableTransport(Exception):pass

class Transport:
    def __init__(self,out,curl,budget,receipt,token,allowed,source_check=sources):
        self.out=out;self.curl=curl;self.budget=budget;self.receipt=receipt;self.config=policy.token_config(token);self.allowed=allowed;self.source_check=source_check;self.expected_sources=source_check();self.timeout=1200
