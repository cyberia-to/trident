"""Create a separate exact-text delivery; preserve the rejected preparation."""
import hashlib
import importlib.util
import json
import shutil
import stat
import sys
import time
from pathlib import Path

R = Path('/Users/master/cyber/.worktrees/selfhost-0.4-finalization-20261002')
W = R / 'whole-proof-ci'
OLD = W / 'pr117-v4-delivery'
NEW = W / 'pr117-v4-delivery-v2'
PREP = Path(__file__).resolve().parent
CACHE = 'a8606ae30201c655de8201af7f830be56d78853370c059d091b50b355be3a0ff'
JSONL = 'f0b5c8f00a1ee9b2dc678ee0d557eb09fb15a4325c9f4e2319892723e870103e'
sys.path.insert(0, str(R / 'whole-proof-final-delivery-preparation'))
import privacy


def identity(path):
    assert stat.S_ISREG(path.lstat().st_mode)
    raw = path.read_bytes()
    return dict(bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def write_json(path, value):
    with path.open('x') as out:
        out.write(json.dumps(value, indent=2) + '\n')


def public(raw):
    digest = hashlib.sha256(raw).hexdigest()
    if digest == JSONL:
        privacy.inspect_text(raw)
        lines = raw.decode().splitlines()
        assert len(lines) == 15 and all(lines)
        for line in lines:
            privacy.inspect(json.loads(line))
    else:
        privacy.public_bytes(raw)


old_manifest = json.loads((OLD / 'delivery-files.json').read_text())
assert {str(p.relative_to(OLD)) for p in OLD.rglob('*') if p.is_file()} == set(old_manifest['files']) | {'delivery-files.json'}
assert all(identity(OLD / name) == value for name, value in old_manifest['files'].items())
old_before = {str(p.relative_to(OLD)): identity(p) for p in OLD.rglob('*') if p.is_file()}
rows = json.loads((OLD / 'retained-files.json').read_text())
removed = [row for row in rows if row['sha256'] == CACHE]
assert len(removed) == 1 and removed[0]['bytes'] == 13817
assert removed[0]['original'].endswith('/__pycache__/admission.cpython-314.pyc')
rows = {row['original']: row for row in rows if row['sha256'] != CACHE}
assert len(rows) == 440
NEW.mkdir()
replaced = {'.gitattributes', 'README.md', 'COPY.md', 'retained-files.json',
            'delivery-files.json', 'final-preparation.json', 'validation-final.json',
            'validation-final.stdout', 'validation-final.stderr'}
for source in sorted(OLD.rglob('*')):
    if not source.is_file():
        continue
    relative = str(source.relative_to(OLD))
    if relative == 'objects/' + CACHE or relative in replaced:
        continue
    raw = source.read_bytes()
    public(raw)
    destination = NEW / relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    with destination.open('xb') as out:
        out.write(raw)

superseded = NEW / 'superseded-v1'
superseded.mkdir()
for name in sorted(replaced):
    with (superseded / name).open('xb') as out:
        out.write((OLD / name).read_bytes())
history = [OLD / name for name in sorted(replaced)]
history += [W / 'pr117-v4-delivery-finalization/delivery-receipt.json',
            W / 'pr117-v4-delivery-root-preflight-1/receipt.json', Path(__file__)]
selection_path = R / 'integration/helper-tooling-readiness-15fa/retention.json'
selection = json.loads(selection_path.read_text())
assert len(selection['originals']) == 37
history.append(selection_path)
for selected in selection['originals']:
    path = Path(selected['path'])
    assert identity(path) == {key: selected[key] for key in ('bytes', 'sha256')}
    history.append(path)
for path in history:
    raw = path.read_bytes()
    assert len(raw) <= 2 * 1024 * 1024
    public(raw)
    ident = identity(path)
    row = dict(original=str(path), **ident, stored='objects/' + ident['sha256'])
    if str(path) in rows:
        assert rows[str(path)] == row
    target = NEW / row['stored']
    if not target.exists():
        with target.open('xb') as out:
            out.write(raw)
    assert identity(target) == identity(path) == ident
    rows[str(path)] = row
assert not any(row['original'].endswith('.pyc') or '/__pycache__/' in row['original'] for row in rows.values())
write_json(NEW / 'retained-files.json', list(rows.values()))
write_json(NEW / 'v2-reference-only.json', dict(
