    reason='Compiled Python cache is local history, not reviewed public text. Original cache and rejected stage remain unchanged.',
    compiled_cache=dict(path=removed[0]['original'], bytes=removed[0]['bytes'],
                        sha256=CACHE, public_body_copied=False),
    superseded_delivery=dict(path=str(OLD), manifest=identity(OLD / 'delivery-files.json'),
                             original_map=identity(OLD / 'retained-files.json')),
    readiness_references_only=selection['references_only']))
attrs = '* -text\n'
for digest in ('cfb659af99f30efb0d5e73e075d5db6cb3704afbec9573ff10832bf411c70a31',
               'd3f06c8f02c30b2c598006da34ba4119072221f4e0f497e42ce5959e07ab7aee',
               'a03dcc874ff630fbf764260cf462855573fab4300c4bb7e82adef8dbf3d89e55'):
