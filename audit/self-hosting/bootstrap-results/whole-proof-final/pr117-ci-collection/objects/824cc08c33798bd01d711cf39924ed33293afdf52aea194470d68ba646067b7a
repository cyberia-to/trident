def require(value, reason):
    if not value:
        raise ValueError(reason)


def identity(path):
    path = Path(path)
    require(path.is_file() and not path.is_symlink(), 'ordinary evidence file')
    before = path.stat()
    with path.open('rb') as stream:
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    after = path.stat()
    require((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
            (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns), 'stable evidence read')
    return dict(bytes=after.st_size, sha256=digest)


def load(path):
    path = Path(path)
    require(path.is_file() and not path.is_symlink() and path.stat().st_size <= 32 * MIB,
            'bounded ordinary JSON')
    def unique(pairs):
        result = {}
        for key, value in pairs:
            require(key not in result, 'unique JSON keys')
            result[key] = value
        return result
    return json.loads(path.read_text(), object_pairs_hook=unique)


def reference(path):
    return dict(path=str(path), **identity(path))


def plain(value):
    return {key: value[key] for key in ('bytes', 'sha256')}


def check_outer_streams(wrapper, identify=identity):
    for name, field in (('outer.stdout', 'outer_stdout'), ('outer.stderr', 'outer_stderr')):
        require(identify(COLLECTOR / name) == wrapper[field], 'unchanged collector outer stream')


def source_closure():
    require(identity(COLLECTOR / 'sources.json') == SOURCE, 'exact accepted collector source map')
    require(identity(COLLECTOR / 'independent-review.json') == REVIEW, 'exact accepted root gate')
    sources = load(COLLECTOR / 'sources.json')
    require(len(sources) == 72, 'complete accepted source closure')
    for name, wanted in sources.items():
        require(Path(name).is_absolute() and identity(name) == wanted, 'unchanged accepted source')
    tools = load(COLLECTOR / 'toolchain.json')
    require(tools['python']['path'] == str(PYTHON) and identity(PYTHON) == plain(tools['python']),
            'exact selected Python')
    return sources


def check_result(value, collection, accounting):
    require(value['schema'] == 'trident/original-native-phase-matrix-replay-completion/v4'
            and value['status'] == 'passed-original-matrix-replay-completion', 'successful frozen replay')
    require(value['origin'] == ORIGIN, 'same original run and commit')
    require(value['collection'] == collection and value['final_accounting'] == accounting,
            'same completed collection and accounting')
    require(value['native_producers'] == 12 and value['native_corpus_jobs'] == 24
            and len(value['phases']) == 36 and len(value['archives']) == 38,
            'complete native matrix and logs')
    require(value['compiler_sha256'] == COMPILER, 'same native self-host compiler')
    require(value['reused_original_archives'] == 5 and value['reused_v2_archives'] == 11
            and value['reused_v3_archives'] == 6 and value['continuation_original_archives'] == 15,
            'distinct original archive provenance')


def check_terminal(wrapper, collection, ids, authorized):
    require(wrapper['status']=='passed' and wrapper['exit_code']==0 and wrapper['sources_unchanged'] is True,'collector terminal success')
    require(wrapper['command']==authorized['command'] and wrapper['cwd']==str(COLLECTOR),'authorized collector argv')
    require(wrapper['source_manifest']==SOURCE and wrapper['review']==REVIEW,'accepted collector source/review')
    require(wrapper['completed/receipt.json']==ids['collection'] and wrapper['completed/final-accounting.json']==ids['accounting'],'terminal result identities')
    require(collection['schema']=='trident/exact-attempt-actions-collection-completion/v4' and collection['status']=='passed-completion','completed original collection')
    require((collection['run'],collection['attempt'],collection['head'])==(int(ORIGIN['run_id']),1,ORIGIN['head_sha']),'original run coordinates')
    require(collection['review']==REVIEW and wrapper['started_ns']<=collection['started_ns']<=collection['ended_ns']<=wrapper['ended_ns'],'review and terminal ordering')


def admit(selection_path,review_path):
    selection=load(selection_path);require(selection['schema']=='trident/pr117-owner-replay-selection/v1','explicit owner selection')
    own=load(ROOT/'sources.json');review=load(review_path);require(review['status']=='passed-source-review' and review['sources']==own,'reviewed owner wrapper')
    for name,wanted in own.items():require(identity(name)==wanted,'exact owner wrapper source')
    source_closure();paths=dict(wrapper=COLLECTOR/'launch-completed.json',collection=COLLECTOR/'completed/receipt.json',accounting=COLLECTOR/'completed/final-accounting.json')
    require(set(selection['inputs'])==set(paths),'exact three terminal inputs');ids={}
    for key,path in paths.items():require(selection['inputs'][key]==reference(path),'selected terminal identity');ids[key]=identity(path)
    require(not (COLLECTOR/'completed/terminal-failure.json').exists(),'no failed collection terminal')
    wrapper=load(paths['wrapper']);collection=load(paths['collection']);check_terminal(wrapper,collection,ids,load(COLLECTOR/'independent-review.json')['authorized_launch'])
    for name,key in [('outer.stdout','outer_stdout'),('outer.stderr','outer_stderr')]:require(identity(COLLECTOR/name)==wrapper[key],'exact original wrapper streams')
    return dict(inputs={k:reference(p) for k,p in paths.items()},selected=reference(selection_path),launcher_review=reference(review_path),launcher_sources=identity(ROOT/'sources.json'),collector_sources=SOURCE,collector_review=REVIEW,checker=identity(COLLECTOR/'replay.py'),git=reference('/usr/bin/git'))
