name: One native self-host repetition

on:
  workflow_call:
    inputs:
      target:
        required: true
        type: string
      runner:
        required: true
        type: string
      architecture:
        required: true
        type: string
      repeat:
        required: true
        type: number
      head-sha:
        required: true
        type: string
      pins-json:
        required: true
        type: string

permissions:
  contents: read

env:
  PYTHONUTF8: '1'
  PYTHONDONTWRITEBYTECODE: '1'
  BOOTSTRAP_TARGET: ${{ inputs.target }}
  BOOTSTRAP_REPEAT: ${{ inputs.repeat }}
  BOOTSTRAP_HEAD_SHA: ${{ inputs.head-sha }}
  BOOTSTRAP_PINS: ${{ inputs.pins-json }}

jobs:
  producer:
    name: Self-build C2 and C3
    runs-on: ${{ inputs.runner }}
    timeout-minutes: 350
    defaults:
      run:
        shell: pwsh
    steps:
      - name: Preserve tracked bytes on every platform
        run: git config --global core.autocrlf false
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ inputs.head-sha }}
          persist-credentials: false
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: '3.13'
          architecture: ${{ inputs.architecture }}
      - name: Install the exact native Rust toolchain
        run: rustup toolchain install "1.95.0-$env:BOOTSTRAP_TARGET" --profile minimal
      - name: Check orchestration failure boundaries
        run: python -m unittest audit/self-hosting/test_bootstrap_runner.py audit/self-hosting/test_bootstrap_phases.py
      - name: Build the seed and execute both complete self-builds
        timeout-minutes: 330
        run: >-
          python audit/self-hosting/bootstrap-phases.py --phase producer
          --target "$env:BOOTSTRAP_TARGET"
          --repeat "$env:BOOTSTRAP_REPEAT"
          --rust-version 1.95.0
          --work "$env:RUNNER_TEMP/producer-work"
          --output "$env:RUNNER_TEMP/phase-evidence"
      - name: Retain exact producer tools, compilers and success or failure evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: bootstrap-phase-${{ inputs.target }}-repeat-${{ inputs.repeat }}-producer-attempt-${{ github.run_attempt }}
          path: ${{ runner.temp }}/phase-evidence
          if-no-files-found: error
          include-hidden-files: true
          compression-level: 6
          retention-days: 14

  corpus:
    name: Corpus C${{ matrix.generation }}
    needs: producer
    runs-on: ${{ inputs.runner }}
    timeout-minutes: 350
    strategy:
      fail-fast: false
      matrix:
        generation: [2, 3]
    defaults:
      run:
        shell: pwsh
    env:
      BOOTSTRAP_GENERATION: ${{ matrix.generation }}
    steps:
      - name: Preserve tracked bytes on every platform
        run: git config --global core.autocrlf false
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ inputs.head-sha }}
          persist-credentials: false
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: '3.13'
          architecture: ${{ inputs.architecture }}
      - name: Install the exact native Rust toolchain
        run: rustup toolchain install "1.95.0-$env:BOOTSTRAP_TARGET" --profile minimal
      - name: Download this repetition's original producer
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: bootstrap-phase-${{ inputs.target }}-repeat-${{ inputs.repeat }}-producer-attempt-${{ github.run_attempt }}
          path: ${{ runner.temp }}/producer-evidence
      - name: Execute all six corpora on the exact supplied compiler and Joy
        timeout-minutes: 330
        run: >-
          python audit/self-hosting/bootstrap-phases.py --phase corpus
          --producer "$env:RUNNER_TEMP/producer-evidence"
          --generation "$env:BOOTSTRAP_GENERATION"
          --target "$env:BOOTSTRAP_TARGET"
          --repeat "$env:BOOTSTRAP_REPEAT"
          --rust-version 1.95.0
          --work "$env:RUNNER_TEMP/corpus-work"
          --output "$env:RUNNER_TEMP/phase-evidence"
      - name: Retain supplied-compiler success and failure evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: bootstrap-phase-${{ inputs.target }}-repeat-${{ inputs.repeat }}-c${{ matrix.generation }}-attempt-${{ github.run_attempt }}
          path: ${{ runner.temp }}/phase-evidence
          if-no-files-found: error
          include-hidden-files: true
          compression-level: 6
          retention-days: 14
