class CurlOriginTests(unittest.TestCase):
    def test_actual_short_permanent_http_response_is_not_retried(self):
        for status in (401,403,404,418):
            with self.subTest(status=status),tempfile.TemporaryDirectory() as temp:
                seen=[]
                class Short(http.server.BaseHTTPRequestHandler):
                    def do_GET(self):
                        seen.append(self.path);self.send_response(status);self.send_header('Content-Length','100');self.send_header('Retry-After','60');self.end_headers();self.wfile.write(b'x')
                    def log_message(self,*args):pass
                server=http.server.HTTPServer(('127.0.0.1',0),Short);thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start();root=Path(temp);out=root/'out';out.mkdir()
                t=Transport(out,dict(path='/usr/bin/curl',**identity('/usr/bin/curl')),Budget([root],limit=16*MIB,free_floor=0,seconds=30),dict(commands=[],requests=[],backoffs=[],prior_attempts={}),TOKEN,{ENDPOINT},source_check=lambda:{})
                def local_args(curl,_endpoint,_body,fd):return [curl,'-q','--silent','--show-error','--fail-with-body','--http1.1','--proto','=http','--max-time','5','--config','-','--dump-header',f'/dev/fd/{fd}','--url',f'http://127.0.0.1:{server.server_port}/short']
                try:
                    with patch('transfer.policy.argv',side_effect=local_args),patch.object(t,'wait') as wait,self.assertRaisesRegex(ValueError,'permanent'):t.get('body',ENDPOINT,100,True)
                    self.assertEqual(len(seen),1);self.assertEqual(len(t.receipt['commands']),1);wait.assert_not_called();row=t.receipt['commands'][0]
                    self.assertEqual(row['exit_code'],18);self.assertEqual(row['http']['status'],status);self.assertIsNone(row['retry_delay_seconds']);self.assertFalse(row['retryable']);self.assertEqual((out/'body-attempt-1.zip').read_bytes(),b'x');self.assertTrue(row['cleanup']['group_empty'])
                finally:server.shutdown();server.server_close();thread.join(timeout=2)
    def redirect(self,target_host):
        seen=[]
        class Target(http.server.BaseHTTPRequestHandler):
            def do_GET(self):seen.append(('target',self.headers.get('Authorization')));self.send_response(200);self.end_headers();self.wfile.write(b'okay')
            def log_message(self,*args):pass
        target=http.server.HTTPServer(('127.0.0.1',0),Target)
        class Origin(http.server.BaseHTTPRequestHandler):
            def do_GET(self):seen.append(('origin',self.headers.get('Authorization')));self.send_response(302);self.send_header('Location',f'http://{target_host}:{target.server_port}/file');self.end_headers()
            def log_message(self,*args):pass
        origin=http.server.HTTPServer(('127.0.0.1',0),Origin);threads=[];read_fd,write_fd=os.pipe()
        try:
            for server in (target,origin):
                thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start();threads.append(thread)
            args=['/usr/bin/curl','-q','--silent','--show-error','--location','--max-redirs','1','--connect-timeout','2','--max-time','5','--proto','=http','--proto-redir','=http','--config','-','--dump-header',f'/dev/fd/{write_fd}','--url',f'http://127.0.0.1:{origin.server_port}/file']
            with subprocess.Popen(args,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,pass_fds=(write_fd,),env={'PATH':'','LANG':'C'}) as child:
                os.close(write_fd);write_fd=None;stdout,stderr=child.communicate(policy.token_config(TOKEN),timeout=10)
            raw=os.read(read_fd,65536);self.assertEqual(child.returncode,0);self.assertEqual(stderr,b'');self.assertEqual(stdout,b'okay');self.assertEqual(seen,[('origin','Bearer '+TOKEN.decode()),('target',None)]);self.assertEqual(policy.headers(raw,True)['statuses'],[302,200])
        finally:
            for server in (origin,target):server.shutdown();server.server_close()
            for thread in threads:thread.join(timeout=2)
            os.close(read_fd)
            if write_fd is not None:os.close(write_fd)
    def test_actual_curl_strips_auth_same_hostname_different_port(self):self.redirect('127.0.0.1')
    def test_actual_curl_strips_auth_different_hostname(self):self.redirect('localhost')

class ReferenceTests(unittest.TestCase):
    def test_identity_and_owned_path_are_required(self):
        with tempfile.TemporaryDirectory() as temp:
            root=Path(temp);b=Budget([root],limit=MIB,free_floor=0);r=reference(root,'map',{'file':{'bytes':1,'sha256':'a'*64}},b)
            self.assertEqual(referenced(r,root,'map')['file']['bytes'],1)
            wrong=dict(r,path=str(root.parent/'map.json'))
            with self.assertRaisesRegex(ValueError,'owned inventory'):referenced(wrong,root,'map')
            (root/'map.json').write_text('{}')
            with self.assertRaisesRegex(ValueError,'owned inventory'):referenced(r,root,'map')
    def test_reference_single_file_cap_and_boolean_length(self):
        with tempfile.TemporaryDirectory() as temp:
            root=Path(temp);b=Budget([root],limit=64*MIB,free_floor=0)
            with self.assertRaisesRegex(ValueError,'inventory reference cap'):reference(root,'too-big','x'*(32*MIB),b)
            self.assertFalse((root/'too-big.json').exists());r=reference(root,'small',{},b);r['bytes']=True
            with self.assertRaisesRegex(ValueError,'reference schema'):referenced(r,root,'small')

