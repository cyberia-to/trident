    def test_http_retry_after_exact_timestamp_and_ceiling(self):
        raw=b'HTTP/1.1 503 Unavailable\r\nRetry-After: Thu, 01 Jan 1970 00:18:40 GMT\r\n\r\n';response=policy.headers(raw,True)
        self.assertEqual(policy.retry(22,response,now=1000),120);self.assertEqual(policy.retry(22,response,now=1001),119)
        self.assertEqual(policy.retry(22,policy.headers(b'HTTP/1.1 429 Slow\r\nRetry-After: 90\r\n\r\n')),90)
        with self.assertRaisesRegex(ValueError,'exceeds finite'):policy.retry(22,policy.headers(b'HTTP/1.1 429 Slow\r\nRetry-After: 121\r\n\r\n'))
        with self.assertRaisesRegex(ValueError,'unambiguous'):policy.retry(22,policy.headers(b'HTTP/1.1 503 Slow\r\nRetry-After: 60\r\nRetry-After: 90\r\n\r\n'))
    def test_wait_keeps_deadline_active_and_records_declared_delay(self):
        with tempfile.TemporaryDirectory() as temp:
            t=fake(Path(temp),'pass\n')
