            self.assertEqual(t.receipt['backoffs'][0]['seconds'],60);self.assertEqual(t.receipt['backoffs'][0]['elapsed_monotonic_seconds'],61)
            t.budget.tick-=31
            with self.assertRaisesRegex(ValueError,'total deadline'):t.wait('next',60)
