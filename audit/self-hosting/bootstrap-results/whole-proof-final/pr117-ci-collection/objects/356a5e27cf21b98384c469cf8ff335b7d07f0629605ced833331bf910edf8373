def fake(root,script):
    exe=root/'fake-curl';exe.write_text('#!'+sys.executable+'\nimport sys,os\nconfig=sys.stdin.buffer.read()\nfd=int(sys.argv[sys.argv.index("--dump-header")+1].rsplit("/",1)[1])\n'+script);exe.chmod(0o700)
    out=root/'out';out.mkdir();budget=Budget([root],limit=16*MIB,free_floor=0,seconds=30);r=dict(commands=[],requests=[],backoffs=[],prior_attempts={});t=Transport(out,dict(path=str(exe),**identity(exe)),budget,r,TOKEN,{ENDPOINT},source_check=lambda:{})
    return t

class HttpTests(unittest.TestCase):
    def test_transport_failure_retained_then_exact_success(self):
        with tempfile.TemporaryDirectory() as temp:
            root=Path(temp);counter=root/'counter'
            script='from pathlib import Path\np=Path('+repr(str(counter))+')\nn=int(p.read_text()) if p.exists() else 0\np.write_text(str(n+1))\nif n==0:\n sys.stdout.write("p");sys.exit(35)\nos.write(fd,b"HTTP/1.1 200 OK\\r\\nContent-Length: 4\\r\\n\\r\\n")\nsys.stdout.write("okay")\n'
            t=fake(root,script)
            with patch.object(t,'wait') as wait:path,name=t.get('body',ENDPOINT,4,True,dict(bytes=4,sha256=hashlib.sha256(b'okay').hexdigest()))
            self.assertEqual(path.read_bytes(),b'okay');self.assertEqual((t.out/'body-attempt-1.zip').read_bytes(),b'p');self.assertEqual(name,'body-attempt-2');wait.assert_called_once_with('body-attempt-1',60)
            self.assertTrue(t.receipt['commands'][0]['cleanup']['group_empty']);self.assertNotIn(TOKEN,json.dumps(t.receipt).encode())
    def test_three_failures_no_fourth_and_cumulative_prior_preserved(self):
        with tempfile.TemporaryDirectory() as temp:
            t=fake(Path(temp),'sys.exit(35)\n');prior=[dict(scope='v3',name=f'body-attempt-{n}') for n in (1,2)];t.receipt['prior_attempts']={'body':prior}
            with patch.object(t,'wait') as wait,self.assertRaises(RetryableTransport):t.get('body',ENDPOINT,4,True)
            self.assertEqual(len(t.receipt['commands']),3);self.assertEqual(wait.call_count,2);self.assertFalse((t.out/'body-attempt-4.zip').exists());self.assertEqual(len(t.receipt['requests'][0]['cumulative_attempts']),5);self.assertEqual(len(prior),2)
    def test_permission_http403_is_not_retried(self):
