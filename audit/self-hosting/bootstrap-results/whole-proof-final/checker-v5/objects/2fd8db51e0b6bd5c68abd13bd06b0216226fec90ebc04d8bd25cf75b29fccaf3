class CompositeTests(unittest.TestCase):
    def setUp(self):
        self.prior=dict(controls=[dict(name='original-fresh-verification'),dict(name='rechain')],
              original_v2=dict(rejections=[dict(name=n) for n in common.PRIOR]),
              additional_v3=dict(rejections=[dict(name=n) for n in common.ADDITIONAL]))
        self.profile={'profile':True};self.positive={'proof':{'bytes':1,'sha256':'a'*64}}
        self.suite=dict(schema='trident/whole-self-build-certificate-completion/v5',status='passed-completion',generation=2,
               original_proof=self.positive['proof'],profile=self.profile,prior_cases=self.prior,
               immutable_inputs_before={'f':1},immutable_inputs_after={'f':1},rejections=[dict(name=n) for n in common.NEW[1:]])
    def review(self):cases.suite_contract(self.suite,2,self.prior,self.positive,self.profile)
    def test_complete_generation_two_shape(self):self.review()
    def test_failed_current_suite_not_promoted(self):
        self.suite['status']='failed'
        with self.assertRaises(ValueError):self.review()
    def test_hidden_input_failure(self):
        self.suite['input_error']='interrupted'
        with self.assertRaises(ValueError):self.review()
    def test_wrong_original_proof(self):
        self.suite['original_proof']={'bytes':2,'sha256':'b'*64}
        with self.assertRaises(ValueError):self.review()
    def test_no_fabricated_current_controls(self):
        self.suite['controls']=self.prior['controls']
        with self.assertRaises(ValueError):self.review()
    def test_c2_selected_case_cannot_be_fresh_again(self):
        self.suite['rejections'].insert(0,dict(name='cost'))
        with self.assertRaises(ValueError):self.review()
    def test_current_inputs_changed(self):
        self.suite['immutable_inputs_after']={'different':1}
        with self.assertRaises(ValueError):self.review()

class TerminalBirthTests(unittest.TestCase):
    def setUp(self):
        self.owner=dict(pid=10,pgid=10,started='Fri Oct  2 00:00:00 2026',members={'10':'Fri Oct  2 00:00:00 2026'})
        self.empty=1790899210000000000
        self.sample=dict(time_ns=1790899300000000000,processes=[dict(pid=10,pgid=10,started='Fri Oct  2 00:00:20 2026   ')])
    def test_later_reused_pid_classified_separately(self):
        self.assertEqual(1,len(schedule.final_owners_absent(self.sample,[(self.owner,self.empty)])))
    def test_original_birth_cannot_be_ignored(self):
        self.sample['processes'][0]['started']=self.owner['started']
        with self.assertRaises(ValueError):schedule.final_owners_absent(self.sample,[(self.owner,self.empty)])
    def test_ambiguous_rounding_margin_refuses(self):
        self.sample['processes'][0]['started']='Fri Oct  2 00:00:12 2026'
        with self.assertRaises(ValueError):schedule.final_owners_absent(self.sample,[(self.owner,self.empty)])
    def test_unrelated_owner_not_claimed(self):
        self.sample['processes'][0].update(pid=11,pgid=11)
        self.assertEqual([],schedule.final_owners_absent(self.sample,[(self.owner,self.empty)]))
