def evidence_pins(base):
    entries=load(base/'whole-proof-attacks-completion-v5/prior-v4-evidence.json')
    for path,expected in entries.items():
        require(not Path(path).is_absolute() and '..' not in Path(path).parts,'relative original failure pin')
        same(base/path,expected)
    return entries


def fresh_names(generation):
    require(type(generation) is int and generation in (1,2),'known generation')
    return NEW if generation==1 else NEW[1:]


def case_partition(prior,additional,fresh,generation,selected):
    require(prior==list(PRIOR) and additional==list(ADDITIONAL) and fresh==list(fresh_names(generation)),
            'exact ordered historical and generation-specific fresh partition')
    require(selected==([] if generation==1 else ['cost']),'explicit C2-only selected V4 cost')
    require(len(set(prior+additional+fresh+selected))==23 and set(prior+additional+fresh+selected)==set(ERRORS),
            'all twenty-three distinct required rejections')
