def reference(path):
    return dict(path=str(path), **identity(path))


def v4_sources(base):
    root = base / 'whole-proof-attacks-completion-v4'
    require(identity(root/'sources.json')['sha256'] == V4_MANIFEST_SHA, 'exact 49-file v4 closure')
    require(identity(root/'independent-review.json')['sha256'] == V4_REVIEW_SHA, 'exact v4 source review')
    manifest, review = load(root/'sources.json'), load(root/'independent-review.json')
    require(len(manifest) == 49 and review['status'] == 'passed-source-review'
            and review['sources'] == manifest, 'full reviewed v4 source closure')
    for path, expected in manifest.items():
        require(Path(path).is_relative_to(base), 'local source closure path')
        same(Path(path), expected)
    return manifest


