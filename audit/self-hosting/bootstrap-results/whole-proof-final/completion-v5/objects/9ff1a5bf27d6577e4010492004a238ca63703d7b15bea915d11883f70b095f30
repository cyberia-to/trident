"""Fresh read-only UTC birth observations; raw local snapshots stay private."""
import datetime
import hashlib
import os
from pathlib import Path
import re
import subprocess
import time
from prior_pins_v5 import ROOT, require, identity, load, reference


def birth(text):
    require(re.fullmatch(r'[A-Z][a-z]{2} [A-Z][a-z]{2} +[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2} [0-9]{4}',text.strip()) is not None,
            'exact C-locale UTC process birth')
    d=datetime.datetime.strptime(text.strip(),'%a %b %d %H:%M:%S %Y').replace(tzinfo=datetime.timezone.utc)
    require(d.strftime('%a')==text.split()[0], 'consistent UTC birth weekday')
    return int(d.timestamp())*1_000_000_000


def classify(raw,owners,cutoff,observed):
    require(type(cutoff) is int and cutoff>0 and type(observed) is int and observed>=cutoff, 'ordered fresh process observation')
    groups=set(owners);seen=set();overlaps=[]
    for line in raw.decode('ascii').splitlines():
        row=line.strip().split(maxsplit=2)
        require(len(row)==3 and all(v.isascii() and v.isdecimal() for v in row[:2]), 'complete process birth row')
        pid,pgid=map(int,row[:2]);started=birth(row[2])
        require(pid>0 and pgid>=0 and pid not in seen, 'unique positive process identity')
        seen.add(pid)
        if pid in groups or pgid in groups:
            require(started>cutoff+2_000_000_000 and started<=observed, 'original or ambiguous v4 process still live')
            overlaps.append(dict(pid=pid,pgid=pgid,birth_utc=row[2],birth_ns=started,classification='reused-after-terminal-cleanup'))
    require(seen, 'nonempty process observation')
    return dict(process_rows=len(seen),overlaps=overlaps,no_live_original_owners=True,rounding_margin_ns=2_000_000_000)


def observe(base):
    shared=base/'whole-proof-attacks-completion-v4';run=load(shared/'run-1/receipt.json');admission=load(shared/'admission.json')
    require(run['status']=='failed' and run['cleanup']['status']=='passed', 'failed original run with actual completed cleanup')
    owners={r['binding']['pid']:r['binding']['started'] for r in run['generations']}
    native=load(shared/'native-processes/whole-c2-verify-cost.json');owners[native['pid']]=native['started']
    # Coordinator birth is authenticated by the original raw aggregate observations.
    for line in (shared/'run-1/resources.jsonl').read_text().splitlines():
        for process in load_row(line)['processes']:
            if process['pid']==admission['pid']:
                prior=owners.setdefault(process['pid'],process['started'])
                require(prior==process['started'] and process['pgid']==admission['pid'], 'same original coordinator birth')
    require(set(owners)=={admission['pid'],*admission['children'].values(),native['pid']}, 'all four original births bound')
    for value in owners.values():require(birth(value)<=run['ended_ns'], 'owner born before original shutdown')
    root=ROOT/'prior-quiescence-observations';root.mkdir(exist_ok=True)
    started=time.time_ns();out=root/f'{started}-{os.getpid()}';out.mkdir()
    command=['/bin/ps','-axo','pid=,pgid=,lstart='];env=dict(os.environ,TZ='UTC',LC_ALL='C',LANG='C')
    result=subprocess.run(command,capture_output=True,timeout=10,env=env)
    ended=time.time_ns();(out/'stdout').write_bytes(result.stdout);(out/'stderr').write_bytes(result.stderr)
    require(result.returncode==0 and not result.stderr and len(result.stdout)<=4*1024**2, 'successful bounded fresh process observation')
    rows=classify(result.stdout,owners,run['ended_ns'],ended)
    value=dict(schema='trident/fresh-v4-prior-quiescence/v1',status='observed-no-live-prior-owners',
               command=command,environment_overrides=dict(TZ='UTC',LC_ALL='C',LANG='C'),exit_code=result.returncode,
               started_ns=started,ended_ns=ended,cutoff_ns=run['ended_ns'],owners=owners,
               original_run=reference(shared/'run-1/receipt.json'),stdout=reference(out/'stdout'),stderr=reference(out/'stderr'),
               raw_scope='Local private process snapshot; retain identity references in publication.',**rows)
    import json
    (out/'receipt.json').write_text(json.dumps(value,indent=2)+'\n')
    return dict(receipt=reference(out/'receipt.json'),**value)


def load_row(line):
    import json
    return json.loads(line)
