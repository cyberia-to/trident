program native_function_depth

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.compiler.nox.parser
use std.compiler.nox.emit

// Real call/table generation; the Rust side independently measures DAG depth.
#[pure]
fn main(input: Noun) -> Noun {
    let data = [112,114,111,103,114,97,109,32,115,97,109,112,108,101,32,102,110,32,97,40,120,58,70,105,101,108,100,41,45,62,70,105,101,108,100,123,108,101,116,32,121,61,49,32,108,101,116,32,122,61,50,32,120,43,121,43,122,125,32,102,110,32,122,40,41,45,62,70,105,101,108,100,123,57,125,32,102,110,32,109,97,105,110,40,41,45,62,70,105,101,108,100,123,97,40,122,40,41,41,125]
    let mut source = bytes.empty()
    for i in 0..100 { source = bytes.push(source, as_u32(data[i]), as_u32(4096)) }
    let text = [115,97,109,112,108,101]
    let mut name = bytes.empty()
    for i in 0..6 { name = bytes.push(name, as_u32(text[i]), as_u32(6)) }
    let result = parser.compile(source, name, as_u32(4096), as_u32(noun.as_field(input)))
    noun.pair(noun.atom(as_field(result.error.code)), emit.artifact(result.formula))
}
