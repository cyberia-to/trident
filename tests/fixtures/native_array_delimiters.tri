program native_array_delimiters

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.type_registry
use std.compiler.nox.expression_state
use std.compiler.nox.array_parse

// The actual push at the hard limit, isolated from source-parse arena cost.
#[pure]
fn main(input: Noun) -> Noun {
    let depth = as_u32(noun.as_field(input))
    let zero = as_u32(0)
    let one = as_u32(1)
    let token = syntax.token(36, zero, one, 0)
    let context = expression_state.context(seq.empty(), noun.atom(0), seq.empty(), seq.empty(), type_registry.empty())
    let mut s = expression_state.State { operators: seq.empty(), values: seq.empty(), ops: depth, vals: zero,
        token, operand: true, done: false, error: syntax.error(0, zero, zero), capacity: as_u32(64),
        node_cap: as_u32(4096), nodes: seq.empty(), context, before_block: false,
        arguments: seq.empty(), frames: noun.atom(0), edges: noun.atom(0), needs_get: false }
    for i in 0..64 {
        if i < depth { s.operators = seq.push(s.operators, noun.atom(5), as_u32(64)) }
    }
    let source = bytes.push(bytes.empty(), as_u32(91), one)
    let parsed = array_parse.enter(source, s)
    noun.atom(as_field(parsed.error.code) * 1000 + as_field(parsed.ops))
}
