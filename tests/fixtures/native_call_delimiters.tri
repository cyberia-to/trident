program native_call_delimiters

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.signatures
use std.compiler.nox.constants
use std.compiler.nox.type_registry
use std.compiler.nox.check_scope
use std.compiler.nox.expression_state
use std.compiler.nox.call_parse
use std.compiler.nox.call_frames

// Exercise the real checked push with a prepared stack; a whole source with
// 64 nested calls hits the independent lifetime arena before this boundary.
#[pure]
fn main(input: Noun) -> Noun {
    let depth = as_u32(noun.as_field(input))
    let zero = as_u32(0)
    let token = syntax.token(1, zero, as_u32(1), 102)
    let f = signatures.Function { name: token, params: zero, count: as_u32(1), returns: noun.atom(0), open: zero, close: zero }
    let functions = seq.push(seq.empty(), signatures.pack(f), as_u32(1))
    let context = expression_state.context(seq.empty(), noun.atom(0), check_scope.Scope { functions: functions, params: seq.empty(), types: type_registry.empty(), constants: constants.empty(), pure: false })
    let mut s = expression_state.State { operators: seq.empty(), values: seq.empty(), ops: depth, vals: zero,
        token, operand: true, done: false, error: syntax.error(0, zero, zero), capacity: as_u32(64),
        node_cap: as_u32(4096), nodes: seq.empty(), context, before_block: false,
        arguments: seq.empty(), frames: noun.atom(0), edges: noun.atom(0), needs_get: false }
    for i in 0..64 {
        if i < depth {
            s.operators = seq.push(s.operators, noun.atom(as_field(expression_state.CALL_MARKER)), as_u32(64))
            let frame = call_frames.Frame { callee: zero, start: zero, ops: i, vals: zero, count: zero, head: signatures.NONE, builtin: zero }
            s.frames = noun.pair(call_frames.pack(frame), s.frames)
        }
    }
    let mut source = bytes.push(bytes.empty(), as_u32(102), as_u32(2))
    source = bytes.push(source, as_u32(40), as_u32(2))
    let parsed = call_parse.enter(source, syntax.token(5, as_u32(1), as_u32(2), 0), s)
    noun.atom(as_field(parsed.error.code) * 1000 + as_field(parsed.ops))
}
