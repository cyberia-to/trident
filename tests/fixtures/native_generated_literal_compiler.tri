program literal_compiler

// A bounded compiler for exactly: program p fn main()->Field{DIGIT}
// Joy admits JOB1 first. Unsupported source/packages deliberately trap.
#[pure]
fn main(input:Noun)->Noun {
    let fields = nox_noun_tail(input)
    let package = nox_noun_head(nox_noun_tail(fields))
    let modules = nox_noun_tail(nox_noun_head(nox_noun_tail(package)))
    assert_eq(nox_noun_as_field(nox_noun_head(modules)), 1)
    let unit = nox_noun_tail(modules)
    let entry = nox_noun_tail(nox_noun_tail(fields))
    let zero = nox_noun_atom(0)
    let path = nox_noun_pair(nox_noun_atom(1113150513), nox_noun_pair(nox_noun_atom(1), nox_noun_atom(112)))
    assert(nox_noun_eq(nox_noun_head(entry), path))
    assert(nox_noun_eq(nox_noun_head(nox_noun_tail(unit)), path))
    let name = nox_noun_pair(nox_noun_atom(1113150513), nox_noun_pair(nox_noun_atom(4), nox_noun_atom(1852399981)))
    assert(nox_noun_eq(nox_noun_head(nox_noun_tail(entry)), name))
    let options = nox_noun_tail(nox_noun_head(nox_noun_tail(nox_noun_tail(entry))))
    assert_eq(nox_noun_as_field(nox_noun_head(options)), 0)
    let profiles = nox_noun_tail(options)
    assert_eq(nox_noun_as_field(nox_noun_head(profiles)), 0)
    assert_eq(nox_noun_as_field(nox_noun_head(nox_noun_tail(profiles))), 0)
    let source = nox_noun_head(nox_noun_tail(nox_noun_tail(nox_noun_tail(nox_noun_tail(unit)))))
    let bytes = nox_noun_tail(source)
    assert_eq(nox_noun_as_field(nox_noun_head(bytes)), 29)
    let tree = nox_noun_tail(bytes)
    let first = nox_noun_head(nox_noun_head(tree))
    let second = nox_noun_tail(nox_noun_head(tree))
    let third = nox_noun_head(nox_noun_tail(tree))
    let fourth = nox_noun_tail(nox_noun_tail(tree))
    assert_eq(nox_noun_as_field(nox_noun_head(first)), 1735357040)
    assert_eq(nox_noun_as_field(nox_noun_tail(first)), 544039282)
    assert_eq(nox_noun_as_field(nox_noun_head(second)), 1852186736)
    assert_eq(nox_noun_as_field(nox_noun_tail(second)), 1767992608)
    assert_eq(nox_noun_as_field(nox_noun_head(third)), 757672046)
    assert_eq(nox_noun_as_field(nox_noun_tail(third)), 1701398078)
    assert_eq(nox_noun_as_field(nox_noun_tail(fourth)), 125)
    let word = nox_noun_as_field(nox_noun_head(fourth))
    let prefix = as_field(as_u32(word) & as_u32(16777215))
    assert_eq(prefix, 8086636)
    let digit = as_u32(sub(word, prefix) * 18446742969902956801)
    assert(as_u32(47) < digit)
    assert(digit < as_u32(58))
    let formula = nox_noun_pair(nox_noun_atom(1), nox_noun_atom(sub(as_field(digit), 48)))
    let artifact = nox_noun_pair(nox_noun_atom(1095914545), nox_noun_pair(zero, nox_noun_pair(zero, nox_noun_pair(zero, nox_noun_pair(formula, zero)))))
    let (a,b,c,d) = nox_noun_identity(input)
    let identity = nox_noun_pair(nox_noun_pair(nox_noun_atom(a), nox_noun_atom(b)), nox_noun_pair(nox_noun_atom(c), nox_noun_atom(d)))
    nox_noun_pair(nox_noun_atom(1380274993), nox_noun_pair(identity, nox_noun_pair(zero, nox_noun_pair(artifact, zero))))
}
