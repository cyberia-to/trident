module std.nox.tree

use vm.nox.noun
use vm.core.convert
use vm.core.field

// Raw indexed-tree helpers. Validated handles belong to seq and bytes.
const ZERO: U32 = 0
const MAX_HEIGHT: U32 = 32
const HALF: Field = 9223372034707292161

pub struct Shape { pub height: U32, pub capacity: Field }

// A sequential cursor retains pending right subtrees. Each branch is entered
// once across a complete walk; occupied leaves remain opaque Nouns.
pub struct Cursor { node: Noun, capacity: Field, pending: Noun, count: U32 }

#[pure]
#[ensures(result == input.count)]
pub fn remaining(input: Cursor) -> U32 { input.count }

// Requires the canonical tree shape for length, as get does.
#[pure]
#[ensures(remaining(result) == length)]
pub fn cursor(root: Noun, length: U32) -> Cursor {
    Cursor { node: root, capacity: shape(length).capacity, pending: noun.atom(0), count: length }
}

#[pure]
#[requires((length < start) == false)]
#[ensures(convert.as_field(remaining(result)) + convert.as_field(start) == convert.as_field(length))]
pub fn cursor_at(root: Noun, length: U32, start: U32) -> Cursor {
    assert((length < start) == false)
    let count = convert.as_u32(field.sub(convert.as_field(length), convert.as_field(start)))
    if count == ZERO { return cursor(noun.atom(0), ZERO) }
    let mut node = root
    let mut capacity = shape(length).capacity
    let mut offset = start
    let mut pending = noun.atom(0)
    for level in 0..32 {
        if capacity == 1 { return Cursor { node, capacity, pending, count } }
        capacity = capacity * HALF
        if offset < convert.as_u32(capacity) {
            pending = noun.pair(noun.pair(noun.tail(node), noun.atom(capacity)), pending)
            node = noun.head(node)
        } else {
            node = noun.tail(node)
            offset = convert.as_u32(field.sub(convert.as_field(offset), capacity))
        }
    }
    Cursor { node, capacity, pending, count }
}

#[pure]
fn read_leaf(node: Noun, pending: Noun, count: U32) -> (Noun, Cursor) {
    if count == ZERO {
        return (node, Cursor { node: noun.atom(0), capacity: 1, pending: noun.atom(0), count })
    }
    let next = noun.head(pending)
    (node, Cursor { node: noun.head(next), capacity: noun.as_field(noun.tail(next)), pending: noun.tail(pending), count })
}

// At most 32 descents per read and at most 32 pending right subtrees. The
// driver's own chunk bound decides when evaluator loop frames are released.
#[pure]
#[requires(ZERO < remaining(input))]
pub fn read(input: Cursor) -> (Noun, Cursor) {
    assert(ZERO < input.count)
    let mut node = input.node
    let mut capacity = input.capacity
    let mut pending = input.pending
    let count = convert.as_u32(field.sub(convert.as_field(input.count), 1))
    for level in 0..32 {
        if capacity == 1 { return read_leaf(node, pending, count) }
        capacity = capacity * HALF
        pending = noun.pair(noun.pair(noun.tail(node), noun.atom(capacity)), pending)
        node = noun.head(node)
    }
    read_leaf(node, pending, count)
}

// Canonical all-zero padding, including E(0) = atom zero.
#[pure]
#[requires((MAX_HEIGHT < height) == false)]
pub fn empty(height: U32) -> Noun {
    assert((MAX_HEIGHT < height) == false)
    let mut root = noun.atom(0)
    for level in 0..32 {
        if level == height { return root }
        root = noun.pair(root, root)
    }
    root
}

// Capacity may be 2^32. Only values up to 2^31 are narrowed for comparison.
#[pure]
#[ensures((MAX_HEIGHT < result.height) == false)]
pub fn shape(length: U32) -> Shape {
    if length == ZERO { return Shape { height: ZERO, capacity: 1 } }
    // Small compiler tables dominate shape queries. Resolve their powers directly
    // so every get/set does not allocate a loop continuation for each tree level.
    if length < convert.as_u32(33) {
        if length < convert.as_u32(3) {
            if length == convert.as_u32(1) { return Shape { height: ZERO, capacity: 1 } }
            return Shape { height: convert.as_u32(1), capacity: 2 }
        }
        if length < convert.as_u32(9) {
            if length < convert.as_u32(5) { return Shape { height: convert.as_u32(2), capacity: 4 } }
            return Shape { height: convert.as_u32(3), capacity: 8 }
        }
        if length < convert.as_u32(17) { return Shape { height: convert.as_u32(4), capacity: 16 } }
        return Shape { height: convert.as_u32(5), capacity: 32 }
    }
    if length < convert.as_u32(65) { return Shape { height: convert.as_u32(6), capacity: 64 } }
    let mut capacity: Field = 128
    for height in 7..32 {
        if (convert.as_u32(capacity) < length) == false { return Shape { height, capacity } }
        capacity = capacity * 2
    }
    Shape { height: MAX_HEIGHT, capacity }
}

// Requires the canonical tree shape for length. Occupied leaves may be pairs.
#[pure]
#[requires(index < length)]
pub fn get(root: Noun, length: U32, index: U32) -> Noun {
    assert(index < length)
    if length == convert.as_u32(1) { return root }
    let mut cursor = root
    let mut offset = index
    let mut capacity = shape(length).capacity
    for level in 0..32 {
        // Resolve the final two levels without allocating their continuation.
        // Both low bits select branches; the returned leaf stays opaque.
        if capacity == 4 {
            if offset < convert.as_u32(2) {
                if offset == ZERO { return noun.head(noun.head(cursor)) }
                return noun.tail(noun.head(cursor))
            }
            if offset == convert.as_u32(2) { return noun.head(noun.tail(cursor)) }
            return noun.tail(noun.tail(cursor))
        }
        // An odd remaining height ends in three direct selections.
        if capacity == 8 {
            if offset < convert.as_u32(4) {
                if offset < convert.as_u32(2) {
                    if offset == ZERO { return noun.head(noun.head(noun.head(cursor))) }
                    return noun.tail(noun.head(noun.head(cursor)))
                }
                if offset == convert.as_u32(2) { return noun.head(noun.tail(noun.head(cursor))) }
                return noun.tail(noun.tail(noun.head(cursor)))
            }
            if offset < convert.as_u32(6) {
                if offset == convert.as_u32(4) { return noun.head(noun.head(noun.tail(cursor))) }
                return noun.tail(noun.head(noun.tail(cursor)))
            }
            if offset == convert.as_u32(6) { return noun.head(noun.tail(noun.tail(cursor))) }
            return noun.tail(noun.tail(noun.tail(cursor)))
        }
        // The final branch selects an opaque leaf directly. Returning here
        // avoids rebuilding loop state only to return on the next iteration.
        if capacity == 2 {
            if offset == ZERO { return noun.head(cursor) }
            return noun.tail(cursor)
        }
        capacity = capacity * HALF
        let half = convert.as_u32(capacity)
        if offset < half {
            cursor = noun.head(cursor)
        } else {
            cursor = noun.tail(cursor)
            offset = convert.as_u32(field.sub(convert.as_field(offset), capacity))
        }
        // The preceding terminal cases leave at least four levels here.
        // Consume a second branch before allocating the next continuation.
        capacity = capacity * HALF
        let quarter = convert.as_u32(capacity)
        if offset < quarter {
            cursor = noun.head(cursor)
        } else {
            cursor = noun.tail(cursor)
            offset = convert.as_u32(field.sub(convert.as_field(offset), capacity))
        }
    }
    assert_eq(0, 1)
    cursor
}

// A zipper stores [direction sibling] records, deepest first on reconstruction.
#[pure]
fn zipper(root: Noun, geometry: Shape, index: U32) -> Noun {
    let mut cursor = root
    let mut offset = index
    let mut capacity = geometry.capacity
    let mut path = noun.atom(0)
    for level in 0..32 {
        if level == geometry.height { return path }
        capacity = capacity * HALF
        let half = convert.as_u32(capacity)
        if offset < half {
            path = noun.pair(noun.pair(noun.atom(0), noun.tail(cursor)), path)
            cursor = noun.head(cursor)
        } else {
            path = noun.pair(noun.pair(noun.atom(1), noun.head(cursor)), path)
            cursor = noun.tail(cursor)
            offset = convert.as_u32(field.sub(convert.as_field(offset), capacity))
        }
    }
    path
}

#[pure]
#[requires(index < length)]
pub fn set(root: Noun, length: U32, index: U32, value: Noun) -> Noun {
    assert(index < length)
    if length == convert.as_u32(1) { return value }
    let geometry = shape(length)
    let mut path = zipper(root, geometry, index)
    let mut result = value
    for level in 0..32 {
        if level == geometry.height { return result }
        let step = noun.head(path)
        if noun.as_field(noun.head(step)) == 0 {
            result = noun.pair(result, noun.tail(step))
        } else {
            result = noun.pair(noun.tail(step), result)
        }
        path = noun.tail(path)
    }
    result
}

#[pure]
#[requires(length < max_length)]
pub fn push(root: Noun, length: U32, value: Noun, max_length: U32) -> Noun {
    assert(length < max_length)
    if length == ZERO { return value }
    let next = convert.as_u32(convert.as_field(length) + 1)
    let old_shape = shape(length)
    let next_shape = shape(next)
    let mut expanded = root
    if old_shape.height < next_shape.height {
        expanded = noun.pair(root, empty(old_shape.height))
    }
    set(expanded, next, length, value)
}

// Task = [node [occupied [capacity canonical_empty]]].
#[pure]
fn task(node: Noun, occupied: U32, capacity: Field, padding: Noun) -> Noun {
    noun.pair(node, noun.pair(noun.atom(convert.as_field(occupied)), noun.pair(noun.atom(capacity), padding)))
}

// Charge before each visit, even when identical children share arena storage.
// Each call unwinds its loop frames before the driver starts the next chunk.
#[pure]
fn validate_chunk(todo: Noun, remaining: U32) -> (Noun, U32) {
    let mut work = todo
    let mut budget = remaining
    for visit in 0..128 {
        if noun.eq(work, noun.atom(0)) { return (work, budget) }
        assert(ZERO < budget)
        budget = convert.as_u32(field.sub(convert.as_field(budget), 1))
        let current = noun.head(work)
        work = noun.tail(work)
        let node = noun.head(current)
        let body = noun.tail(current)
        let occupied = convert.as_u32(noun.as_field(noun.head(body)))
        let geometry = noun.tail(body)
        let capacity = noun.as_field(noun.head(geometry))
        let padding = noun.tail(geometry)
        if occupied == ZERO {
            assert(noun.eq(node, padding))
        } else {
            if capacity == 1 {
                // The entire Noun is the occupied value; do not descend into it.
            } else {
                if capacity == 2 {
                    // Check the branch while keeping arbitrary leaf Nouns opaque.
                    // Both leaf positions retain their visit charge, but need no
                    // traversal tasks or separate validator loop iterations.
                    assert(convert.as_u32(1) < budget)
                    budget = convert.as_u32(field.sub(convert.as_field(budget), 2))
                    assert(noun.eq(noun.pair(noun.head(node), noun.tail(node)), node))
                    if occupied == convert.as_u32(1) { assert(noun.eq(noun.tail(node), noun.atom(0))) }
                } else {
                    let half_capacity = capacity * HALF
                    let half = convert.as_u32(half_capacity)
                    let mut left_count = occupied
                    let mut right_count = ZERO
                    if half < occupied {
                        left_count = half
                        right_count = convert.as_u32(field.sub(convert.as_field(occupied), half_capacity))
                    }
                    let child_padding = noun.head(padding)
                    let right = task(noun.tail(node), right_count, half_capacity, child_padding)
                    let left = task(noun.head(node), left_count, half_capacity, child_padding)
                    work = noun.pair(left, noun.pair(right, work))
                }
            }
        }
    }
    (work, budget)
}

// Returns unspent visits for a caller's payload validation pass.
#[pure]
#[ensures((remaining < result) == false)]
pub fn validate(root: Noun, length: U32, remaining: U32) -> U32 {
    let geometry = shape(length)
    let initial = task(root, length, geometry.capacity, empty(geometry.height))
    let mut work = noun.pair(initial, noun.atom(0))
    let mut budget = remaining
    // ceil(U32::MAX / 128); every chunk consumes visits or returns/fails.
    for chunk in 0..33554432 {
        (work, budget) = validate_chunk(work, budget)
        if noun.eq(work, noun.atom(0)) { return budget }
    }
    assert_eq(0, 1)
    ZERO
}
