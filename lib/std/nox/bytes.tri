module std.nox.bytes

use vm.nox.noun
use vm.core.convert
use vm.core.field
use std.nox.tree
use std.nox.seq

const TAG: Field = 1113150513
const ZERO: U32 = 0
const THREE: U32 = 3
const BYTE_LIMIT: U32 = 256
const INV4: Field = 13835058052060938241

// The root contains packed U32 words, with no embedded Seq wrapper.
pub struct Bytes { length: U32, root: Noun, words: U32 }

// Only validated Bytes enter this table. Its private storage cannot be replaced
// by untrusted Nouns between compiler stages.
pub struct BytesTable { values: seq.Seq }

#[pure]
#[ensures(table_len(result) == ZERO)]
pub fn table_empty() -> BytesTable { BytesTable { values: seq.empty() } }

#[pure]
#[ensures(result == seq.len(table.values))]
pub fn table_len(table: BytesTable) -> U32 { seq.len(table.values) }

#[pure]
#[requires(table_len(table) < max_length)]
#[ensures(convert.as_field(table_len(result)) == convert.as_field(table_len(table)) + 1)]
pub fn table_push(table: BytesTable, value: Bytes, max_length: U32) -> BytesTable {
    assert(table_len(table) < max_length)
    let stored = noun.pair(noun.atom(convert.as_field(value.length)), noun.pair(value.root, noun.atom(convert.as_field(value.words))))
    BytesTable { values: seq.push(table.values, stored, max_length) }
}

#[pure]
#[requires(index < table_len(table))]
pub fn table_get(table: BytesTable, index: U32) -> Bytes {
    let stored = seq.get(table.values, index)
    let payload = noun.tail(stored)
    Bytes { length: convert.as_u32(noun.as_field(noun.head(stored))), root: noun.head(payload), words: convert.as_u32(noun.as_field(noun.tail(payload))) }
}

#[pure]
#[ensures(len(result) == ZERO)]
pub fn empty() -> Bytes { Bytes { length: ZERO, root: noun.atom(0), words: ZERO } }

#[pure]
#[ensures(result == b.length)]
pub fn len(b: Bytes) -> U32 { b.length }

#[pure]
fn quotient(value: U32) -> U32 {
    let remainder = value & THREE
    convert.as_u32(field.sub(convert.as_field(value), convert.as_field(remainder)) * INV4)
}

#[pure]
fn word_count(length: U32) -> U32 {
    let whole = quotient(length)
    if (length & THREE) == ZERO { return whole }
    convert.as_u32(convert.as_field(whole) + 1)
}

#[pure]
#[requires(position < convert.as_u32(4))]
fn scale(position: U32) -> Field {
    let powers = [1, 256, 65536, 16777216]
    powers[position]
}

#[pure]
#[requires(index < len(b))]
#[ensures(result < BYTE_LIMIT)]
pub fn get(b: Bytes, index: U32) -> U32 {
    assert(index < b.length)
    let word = convert.as_u32(noun.as_field(tree.get(b.root, b.words, quotient(index))))
    let position = index & THREE
    // Keep this direct path for existing random readers. Sequential readers
    // call word_byte after retaining a packed word across several positions.
    if position == ZERO { return word & convert.as_u32(255) }
    if position == convert.as_u32(1) {
        return convert.as_u32(convert.as_field(word & convert.as_u32(65280)) * 18374686475393433601)
    }
    if position == convert.as_u32(2) {
        return convert.as_u32(convert.as_field(word & convert.as_u32(16711680)) * 18446462594437939201)
    }
    convert.as_u32(convert.as_field(word & convert.as_u32(4278190080)) * 18446742969902956801)
}

// Sequential readers share a traversal across packed words. Padding words are
// excluded; the final word's unused high lanes are canonical zero bytes.
#[pure]
pub fn words(b: Bytes) -> tree.Cursor { tree.cursor(b.root, b.words) }

// At least five words give the tree three levels. Treat each height-three
// subtree as one opaque leaf, including its canonical final padding words.
#[pure]
#[requires(convert.as_u32(16) < len(b))]
pub fn word_groups(b: Bytes) -> tree.Cursor {
    assert(convert.as_u32(16) < b.length)
    let remainder = b.length & convert.as_u32(31)
    let mut count = field.sub(convert.as_field(b.length), convert.as_field(remainder)) * 17870283317245378561
    if (remainder == ZERO) == false { count = count + 1 }
    tree.cursor(b.root, convert.as_u32(count))
}

// The offset addresses a byte. The first word contains that byte; at the end
// the cursor is empty even when the last word has unused high lanes.
#[pure]
#[requires((len(b) < offset) == false)]
pub fn words_from(b: Bytes, offset: U32) -> tree.Cursor {
    assert((b.length < offset) == false)
    if offset == b.length { return tree.cursor(noun.atom(0), ZERO) }
    tree.cursor_at(b.root, b.words, quotient(offset))
}

#[pure]
#[requires(offset < len(b))]
pub fn word_at(b: Bytes, offset: U32) -> U32 {
    assert(offset < b.length)
    convert.as_u32(noun.as_field(tree.get(b.root, b.words, quotient(offset))))
}

#[pure]
#[requires(position < convert.as_u32(4))]
#[ensures(result < BYTE_LIMIT)]
pub fn word_byte(word: U32, position: U32) -> U32 {
    assert(position < convert.as_u32(4))
    // The low two bits select a fixed byte lane. Direct masks avoid building
    // and indexing two temporary tables for each source byte.
    if position == ZERO { return word & convert.as_u32(255) }
    if position == convert.as_u32(1) {
        return convert.as_u32(convert.as_field(word & convert.as_u32(65280)) * 18374686475393433601)
    }
    if position == convert.as_u32(2) {
        return convert.as_u32(convert.as_field(word & convert.as_u32(16711680)) * 18446462594437939201)
    }
    convert.as_u32(convert.as_field(word & convert.as_u32(4278190080)) * 18446742969902956801)
}

#[pure]
#[requires(index < len(b))]
#[requires(value < BYTE_LIMIT)]
#[ensures(len(result) == len(b))]
#[ensures(get(result, index) == value)]
pub fn set(b: Bytes, index: U32, value: U32) -> Bytes {
    assert(index < b.length)
    assert(value < BYTE_LIMIT)
    let words = b.words
    let at = quotient(index)
    let word = convert.as_u32(noun.as_field(tree.get(b.root, words, at)))
    let factor = scale(index & THREE)
    let mask = convert.as_u32(255 * factor)
    let next = field.sub(convert.as_field(word), convert.as_field(word & mask)) + convert.as_field(value) * factor
    Bytes { length: b.length, root: tree.set(b.root, words, at, noun.atom(next)), words }
}

#[pure]
#[requires(len(b) < max_length)]
#[requires(value < BYTE_LIMIT)]
#[ensures(convert.as_field(len(result)) == convert.as_field(len(b)) + 1)]
pub fn push(b: Bytes, value: U32, max_length: U32) -> Bytes {
    assert(b.length < max_length)
    assert(value < BYTE_LIMIT)
    let length = convert.as_u32(convert.as_field(b.length) + 1)
    if (b.length & THREE) == ZERO {
        let root = tree.push(b.root, b.words, noun.atom(convert.as_field(value)), word_count(max_length))
        return Bytes { length, root, words: convert.as_u32(convert.as_field(b.words) + 1) }
    }
    // Existing high bytes are zero; exposing the next one preserves validity.
    set(Bytes { length, root: b.root, words: b.words }, b.length, value)
}

#[pure]
#[ensures(noun.as_field(noun.head(result)) == TAG)]
pub fn to_noun(b: Bytes) -> Noun {
    noun.pair(noun.atom(TAG), noun.pair(noun.atom(convert.as_field(b.length)), b.root))
}

// The byte decoder validates branches and packed payloads in one traversal.
// Full eight-word subtrees share one task and one allowance subtraction. Every
// shape visit and the historical height+1 payload charge remain accounted for.
#[pure]
fn validation_task(node: Noun, occupied: U32, capacity: Field, padding: Noun) -> Noun {
    noun.pair(node, noun.pair(noun.atom(convert.as_field(occupied)), noun.pair(noun.atom(capacity), padding)))
}

#[pure]
fn validate_eight(node: Noun) -> U32 {
    let left = noun.head(node)
    let right = noun.tail(node)
    let a = noun.head(left)
    let b = noun.tail(left)
    let c = noun.head(right)
    let d = noun.tail(right)
    // Each checked conversion must execute, including the first seven words.
    convert.as_u32(noun.as_field(noun.head(a)))
    convert.as_u32(noun.as_field(noun.tail(a)))
    convert.as_u32(noun.as_field(noun.head(b)))
    convert.as_u32(noun.as_field(noun.tail(b)))
    convert.as_u32(noun.as_field(noun.head(c)))
    convert.as_u32(noun.as_field(noun.tail(c)))
    convert.as_u32(noun.as_field(noun.head(d)))
    convert.as_u32(noun.as_field(noun.tail(d)))
}

#[pure]
fn validate_words_chunk(todo: Noun, visits: U32, cost: U32, last: U32) -> (Noun, U32, U32) {
    let mut work = todo
    let mut remaining = visits
    let mut final_word = last
    for step in 0..128 {
        if noun.eq(work, noun.atom(0)) { return (work, remaining, final_word) }
        assert(ZERO < remaining)
        remaining = convert.as_u32(field.sub(convert.as_field(remaining), 1))
        let current = noun.head(work)
        work = noun.tail(work)
        let node = noun.head(current)
        let body = noun.tail(current)
        let occupied = convert.as_u32(noun.as_field(noun.head(body)))
        let geometry = noun.tail(body)
        let capacity = noun.as_field(noun.head(geometry))
        let padding = noun.tail(geometry)
        if occupied == ZERO {
            assert(noun.eq(node, padding))
        } else if capacity == 1 {
            assert((remaining < cost) == false)
            remaining = convert.as_u32(field.sub(convert.as_field(remaining), convert.as_field(cost)))
            final_word = convert.as_u32(noun.as_field(node))
        } else if capacity == 8 {
            if occupied == convert.as_u32(8) {
                let charge = convert.as_u32(14 + convert.as_field(cost) * 8)
                assert((remaining < charge) == false)
                remaining = convert.as_u32(field.sub(convert.as_field(remaining), convert.as_field(charge)))
                final_word = validate_eight(node)
            } else {
                let half = convert.as_u32(4)
                let mut left_count = occupied
                let mut right_count = ZERO
                if half < occupied {
                    left_count = half
                    right_count = convert.as_u32(field.sub(convert.as_field(occupied), 4))
                }
                let child_padding = noun.head(padding)
                let right = validation_task(noun.tail(node), right_count, 4, child_padding)
                let left = validation_task(noun.head(node), left_count, 4, child_padding)
                work = noun.pair(left, noun.pair(right, work))
            }
        } else {
            let half_capacity = capacity * 9223372034707292161
            let half = convert.as_u32(half_capacity)
            let mut left_count = occupied
            let mut right_count = ZERO
            if half < occupied {
                left_count = half
                right_count = convert.as_u32(field.sub(convert.as_field(occupied), half_capacity))
            }
            let child_padding = noun.head(padding)
            let right = validation_task(noun.tail(node), right_count, half_capacity, child_padding)
            let left = validation_task(noun.head(node), left_count, half_capacity, child_padding)
            work = noun.pair(left, noun.pair(right, work))
        }
    }
    (work, remaining, final_word)
}

#[pure]
#[ensures((max_length < len(result)) == false)]
#[ensures(noun.eq(to_noun(result), value))]
pub fn from_noun(value: Noun, max_length: U32, max_visits: U32) -> Bytes {
    let (value, remaining) = from_noun_budget(value, max_length, max_visits)
    value
}

// Shape and payload validation leave one shared allowance for the next field.
#[pure]
#[requires((max_visits == ZERO) == false)]
pub fn from_noun_budget(value: Noun, max_length: U32, max_visits: U32) -> (Bytes, U32) {
    assert_eq(noun.as_field(noun.head(value)), TAG)
    let body = noun.tail(value)
    let length = convert.as_u32(noun.as_field(noun.head(body)))
    assert((max_length < length) == false)
    let root = noun.tail(body)
    let words = word_count(length)
    let geometry = tree.shape(words)
    let cost = convert.as_u32(convert.as_field(geometry.height) + 1)
    let initial = validation_task(root, words, geometry.capacity, tree.empty(geometry.height))
    let mut work = noun.pair(initial, noun.atom(0))
    let mut remaining = max_visits
    let mut last = ZERO
    // Each chunk consumes visits or returns/fails, including an empty tree.
    for chunk in 0..33554432 {
        (work, remaining, last) = validate_words_chunk(work, remaining, cost, last)
        if noun.eq(work, noun.atom(0)) {
            let used = length & THREE
            if (used == ZERO) == false { assert(last < convert.as_u32(scale(used))) }
            return (Bytes { length, root, words }, remaining)
        }
    }
    assert_eq(0, 1)
    (empty(), ZERO)
}
