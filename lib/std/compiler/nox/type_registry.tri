module std.compiler.nox.type_registry

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.nominal
use std.compiler.nox.types
use std.compiler.nox.type_imports
use std.compiler.nox.type_exports
use std.compiler.nox.qualified_name

pub struct Scope { pub owner: bytes.Bytes, pub records: seq.Seq, pub imports: type_imports.View }
pub struct Found { pub ty: Noun, pub exists: Bool, pub public: Bool }

#[pure]
pub fn empty() -> Scope { Scope { owner: bytes.empty(), records: seq.empty(), imports: type_imports.empty() } }

// Names retain every byte; the lexer's seven-byte keyword hint is never identity.
#[pure]
#[requires((bytes.len(source) < token.end) == false)]
#[requires((token.end < token.start) == false)]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn name(source: bytes.Bytes, token: syntax.Token) -> bytes.Bytes {
    let mut result = bytes.empty()
    let mut pos = token.start
    for step in 0..65536 {
        if pos == token.end { return result }
        result = bytes.push(result, bytes.get(source, pos), syntax.SOURCE_CAP)
        pos = syntax.inc(pos)
    }
    result
}

// Export visibility belongs to a declaration; field visibility belongs to its
// nominal layout. Keeping the two separate permits private types with pub fields.
#[pure]
pub fn record(ty: Noun, public: Bool) -> Noun {
    let mut flag: Field = 0
    if public { flag = 1 }
    noun.pair(ty, noun.atom(flag))
}

// Reverse lookup selects final local visibility without making imports bare.
#[pure]
#[requires((syntax.TABLE_CAP < seq.len(scope.records)) == false)]
pub fn position(scope: Scope, wanted: Noun) -> U32 {
    let mut index = seq.len(scope.records)
    for step in 0..4096 {
        if index == syntax.ZERO { return syntax.TABLE_CAP }
        index = syntax.dec(index)
        if noun.eq(nominal.name(noun.head(seq.get(scope.records, index))), wanted) { return index }
    }
    syntax.TABLE_CAP
}

#[pure]
pub fn lookup(scope: Scope, name: bytes.Bytes) -> Found {
    let index = position(scope, bytes.to_noun(name))
    if index == syntax.TABLE_CAP { return Found { ty: noun.atom(types.INVALID), exists: false, public: false } }
    let item = seq.get(scope.records, index)
    Found { ty: noun.head(item), exists: true, public: noun.as_field(noun.tail(item)) == 1 }
}

#[pure]
pub fn imported(source: bytes.Bytes, query: qualified_name.Name, scope: Scope) -> type_exports.Found {
    type_imports.lookup(query, name(source, query.member), scope.imports)
}
