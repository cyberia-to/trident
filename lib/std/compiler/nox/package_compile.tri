module std.compiler.nox.package_compile

use vm.nox.noun
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.job
use std.compiler.nox.module_graph
use std.compiler.nox.module_order
use std.compiler.nox.module_store
use std.compiler.nox.constant_imports
use std.compiler.nox.parser
use std.compiler.nox.module_functions
use std.compiler.nox.module_function_order
use std.compiler.nox.function_plan
use std.compiler.nox.function_gen
use std.compiler.nox.signatures

pub struct Compiled { pub formula: Noun, pub index: U32, pub error: syntax.Error }

#[pure]
fn failed(index: U32, error: syntax.Error) -> Compiled {
    Compiled { formula: noun.atom(0), index, error }
}

#[pure]
pub fn compile(view: job.View) -> Compiled {
    let header = module_graph.entry_header(view)
    if (header.error.code == syntax.ZERO) == false { return failed(view.index, header.error) }
    // No graph storage is needed when the checked header has no direct uses.
    // A one-module package can still contain a self-use and must discover it.
    if syntax.both(header.token.kind == as_u32(13), header.token.value == 7697253) == false {
        let compiled = parser.compile_at(view.source, view.name, header.token.start,
            constant_imports.empty(), view.sequence_limit, view.depth_limit)
        return Compiled { formula: compiled.formula, index: view.index, error: compiled.error }
    }
    let graph = module_graph.discover_open(view, header)
    if (graph.error.code == syntax.ZERO) == false { return failed(graph.error_index, graph.error) }
    let ordered = module_order.sort(graph)
    if (ordered.error.code == syntax.ZERO) == false { return failed(ordered.error_index, ordered.error) }
    let mut bank = module_functions.empty(seq.len(graph.modules))
    for position in 0..4096 {
        if position == seq.len(ordered.modules) {
            if bank.entry == signatures.NONE { return failed(view.index, syntax.error(3, syntax.ZERO, syntax.ZERO)) }
            let sorted = module_function_order.sort(bank.functions, bank.owners,
                graph.names, graph.sources, bank.roots, graph.capacity)
            let plan = function_plan.ordered(bank.functions, bank.bodies, sorted, bank.entry, graph.capacity)
            if (plan.error.code == syntax.ZERO) == false {
                let mut index = view.index
                if plan.error_function < seq.len(bank.owners) {
                    let owner = as_u32(noun.as_field(seq.get(bank.owners, plan.error_function)))
                    index = module_store.read(graph.modules, owner).index
                }
                return failed(index, plan.error)
            }
            let compiled = function_gen.generate(bank.bodies, plan, bank.entry,
                graph.capacity, view.depth_limit, bank.structured)
            return Compiled { formula: compiled.formula, index: view.index, error: compiled.error }
        }
        let owner = as_u32(noun.as_field(seq.get(ordered.modules, position)))
        bank = module_functions.check(graph, owner, view.index, bank)
        if (bank.error.code == syntax.ZERO) == false {
            return failed(module_store.read(graph.modules, owner).index, bank.error)
        }
    }
    failed(view.index, syntax.error(7, syntax.ZERO, syntax.ZERO))
}
