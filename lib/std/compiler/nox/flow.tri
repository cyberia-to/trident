module std.compiler.nox.flow

use vm.nox.noun
use vm.core.convert
use std.compiler.nox.formula
use std.compiler.nox.emit

// A formula and its exact noun depth travel together through every constructor.
#[pure]
pub fn axis(value: Field) -> formula.Value { formula.Value { formula: formula.axis(value), depth: as_u32(1) } }

#[pure]
pub fn literal(value: Field) -> formula.Value { formula.Value { formula: emit.literal(value), depth: as_u32(1) } }

#[pure]
pub fn cons(a: formula.Value, b: formula.Value) -> formula.Value {
    formula.Value { formula: formula.cons(a.formula, b.formula), depth: as_u32(as_field(formula.maximum(a.depth, b.depth)) + 2) }
}

#[pure]
pub fn compose(a: formula.Value, b: formula.Value) -> formula.Value {
    formula.Value { formula: formula.compose(a.formula, b.formula), depth: as_u32(as_field(formula.maximum(a.depth, as_u32(as_field(b.depth) + 1))) + 2) }
}

#[pure]
pub fn branch(condition: formula.Value, yes: formula.Value, no: formula.Value) -> formula.Value {
    let arms = noun.pair(yes.formula, no.formula)
    let depth = as_u32(as_field(formula.maximum(yes.depth, no.depth)) + 1)
    formula.Value { formula: noun.pair(noun.atom(4), noun.pair(condition.formula, arms)),
        depth: as_u32(as_field(formula.maximum(condition.depth, depth)) + 2) }
}

#[pure]
pub fn keep(subject: formula.Value) -> formula.Value { cons(literal(0), subject) }

#[pure]
pub fn returned(value: formula.Value) -> formula.Value { cons(literal(1), value) }

#[pure]
pub fn then(first: formula.Value, next: formula.Value) -> formula.Value {
    compose(first, branch(axis(2), compose(axis(3), next), axis(1)))
}

#[pure]
pub fn result(value: formula.Value) -> formula.Value {
    compose(value, branch(axis(2), literal(0), axis(3)))
}

// Evaluate the discarded expression once, and retain its original subject.
#[pure]
pub fn discard(value: formula.Value) -> formula.Value {
    compose(cons(value, axis(1)), keep(axis(3)))
}
