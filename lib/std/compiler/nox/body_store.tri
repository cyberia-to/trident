module std.compiler.nox.body_store

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.body_state
use std.compiler.nox.blocks

// Body records are compiler-owned. Public Seq handles are serialized here and
// validated once when that body reaches emission; graph reads use only edges.
#[pure]
pub fn pack(s: body_state.State, terminal: Noun) -> Noun {
    let helpers = noun.pair(noun.atom(as_field(seq.len(s.loops))), blocks.flag(s.needs_get))
    let sizes = noun.pair(noun.atom(as_field(seq.len(s.bindings))), noun.pair(noun.atom(as_field(s.root)), helpers))
    let expressions = noun.pair(seq.to_noun(s.nodes), seq.to_noun(s.arguments))
    let control = noun.pair(seq.to_noun(s.statements), noun.pair(seq.to_noun(s.blocks), seq.to_noun(s.loops)))
    let flow = noun.pair(s.returns, noun.pair(s.edges, terminal))
    noun.pair(sizes, noun.pair(expressions, noun.pair(control, flow)))
}

#[pure]
pub fn locals(value: Noun) -> U32 { as_u32(noun.as_field(noun.head(noun.head(value)))) }

#[pure]
pub fn loop_count(value: Noun) -> U32 { as_u32(noun.as_field(noun.head(noun.tail(noun.tail(noun.head(value)))))) }

#[pure]
pub fn needs_get(value: Noun) -> Bool { noun.as_field(noun.tail(noun.tail(noun.tail(noun.head(value))))) == 1 }

#[pure]
pub fn edges(value: Noun) -> Noun { noun.head(noun.tail(noun.tail(noun.tail(noun.tail(value))))) }

#[pure]
pub fn terminal(value: Noun) -> Noun { noun.tail(noun.tail(noun.tail(noun.tail(noun.tail(value))))) }

// Emission retains only checked code and the metadata needed by its consumers.
// Source token/scope/continuation state ends at pack; it is never reconstructed.
pub struct Body {
    pub nodes: seq.Seq, pub arguments: seq.Seq, pub statements: seq.Seq,
    pub blocks: seq.Seq, pub loops: seq.Seq, pub root: U32,
    pub returns: Noun, pub needs_get: Bool
}

#[pure]
pub fn checked(s: body_state.State) -> Body {
    Body { nodes: s.nodes, arguments: s.arguments, statements: s.statements,
        blocks: s.blocks, loops: s.loops, root: s.root, returns: s.returns, needs_get: s.needs_get }
}

#[pure]
#[requires((syntax.SOURCE_CAP < cap) == false)]
pub fn read(value: Noun, cap: U32) -> Body {
    let sizes = noun.head(value)
    let contents = noun.tail(value)
    let expressions = noun.head(contents)
    let tail = noun.tail(contents)
    let control = noun.head(tail)
    let flow = noun.tail(tail)
    // Public sequence handles retain complete admission checks.
    let visits = as_u32(as_field(cap) * 4 + 1)
    Body {
        nodes: seq.from_noun(noun.head(expressions), cap, visits),
        arguments: seq.from_noun(noun.tail(expressions), cap, visits),
        statements: seq.from_noun(noun.head(control), cap, visits),
        blocks: seq.from_noun(noun.head(noun.tail(control)), cap, visits),
        loops: seq.from_noun(noun.tail(noun.tail(control)), cap, visits),
        root: as_u32(noun.as_field(noun.head(noun.tail(sizes)))),
        returns: noun.head(flow), needs_get: needs_get(value)
    }
}
