module std.compiler.nox.parser

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.compiler.nox.syntax
use std.compiler.nox.ascii
use std.compiler.nox.lexer
use std.compiler.nox.ast
use std.compiler.nox.codegen
use std.compiler.nox.headers
use std.compiler.nox.check_functions
use std.compiler.nox.function_plan
use std.compiler.nox.function_gen

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn compile(source: bytes.Bytes, name: bytes.Bytes, cap: U32, depth_cap: U32) -> codegen.Compiled {
    let expected = [10,1]
    let mut pos = syntax.ZERO
    for i in 0..2 {
        let token = lexer.next(source, pos)
        if (as_field(token.kind) == expected[i]) == false {
            return codegen.Compiled { formula: noun.atom(0), error: ast.failed(token, 2) }
        }
        if syntax.both(i == as_u32(1), ascii.same(source, token.start, token.end, name) == false) {
            return codegen.Compiled { formula: noun.atom(0), error: syntax.error(3, token.start, token.end) }
        }
        pos = token.end
    }
    let mut capacity = cap
    if syntax.SOURCE_CAP < capacity { capacity = syntax.SOURCE_CAP }
    let parsed = headers.parse(source, pos, name, capacity)
    if (parsed.error.code == syntax.ZERO) == false { return codegen.Compiled { formula: noun.atom(0), error: parsed.error } }
    let checked = check_functions.check(source, parsed.functions, parsed.params, parsed.types, parsed.constants, capacity)
    if (checked.error.code == syntax.ZERO) == false { return codegen.Compiled { formula: noun.atom(0), error: checked.error } }
    let plan = function_plan.plan(source, parsed.functions, checked.bodies, parsed.entry, capacity)
    if (plan.error.code == syntax.ZERO) == false { return codegen.Compiled { formula: noun.atom(0), error: plan.error } }
    function_gen.generate(checked.bodies, plan, parsed.entry, capacity, depth_cap, parsed.structured)
}
