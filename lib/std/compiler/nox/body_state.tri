module std.compiler.nox.body_state

use std.compiler.nox.check_scope
use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.blocks
use std.compiler.nox.types

pub struct State {
    // Every parsed statement advances the token and propagates a diagnostic.
    // Keep these and statement-list writes before the cold persistent context.
    pub token: syntax.Token, pub error: syntax.Error,
    pub nodes: seq.Seq, pub statements: seq.Seq, pub current: Noun,
    pub arguments: seq.Seq, pub edges: Noun, pub loops: seq.Seq,
    pub scope: check_scope.Scope, pub returns: Noun, pub blocks: seq.Seq,
    pub bindings: seq.Seq, pub visible: Noun,
    pub frames: Noun, pub depth: U32, pub start: U32, pub end: U32,
    pub synthetic: Bool, pub returned: Bool, pub has_tail: Bool, pub tail: U32,
    pub done: Bool, pub root: U32, pub needs_get: Bool
}

#[pure]
pub fn scoped(token: syntax.Token, start: U32, returns: Noun, scope: check_scope.Scope) -> State {
    let zero = syntax.ZERO
    State { nodes: seq.empty(), arguments: seq.empty(), edges: noun.atom(0), loops: seq.empty(),
        scope, returns, statements: seq.empty(), blocks: seq.empty(),
        bindings: seq.empty(), visible: noun.atom(0), current: noun.atom(0),
        frames: noun.atom(0), depth: zero, start, end: token.start, synthetic: false,
        returned: false, has_tail: false, tail: zero, token,
        error: syntax.error(0, zero, zero), done: false, root: zero, needs_get: false }
}

#[pure]
pub fn initial(token: syntax.Token) -> State {
    scoped(token, token.start, noun.atom(types.FIELD), check_scope.empty())
}

#[pure]
pub fn append(input: State, statement: blocks.Statement, cap: U32) -> State {
    let mut s = input
    if seq.len(s.statements) == cap {
        s.error = syntax.error(7, s.token.start, s.token.end)
        return s
    }
    let id = seq.len(s.statements)
    s.statements = seq.push(s.statements, blocks.pack_statement(statement), cap)
    s.current = noun.pair(noun.atom(as_field(id)), s.current)
    s
}
