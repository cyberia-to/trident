module std.compiler.nox.body_state

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.blocks

pub struct State {
    pub nodes: seq.Seq, pub arguments: seq.Seq, pub edges: Noun,
    pub functions: seq.Seq, pub params: seq.Seq, pub returns: Field, pub statements: seq.Seq, pub blocks: seq.Seq,
    pub bindings: seq.Seq, pub visible: Noun, pub current: Noun,
    pub frames: Noun, pub depth: U32, pub start: U32, pub end: U32,
    pub synthetic: Bool, pub returned: Bool, pub has_tail: Bool, pub tail: U32,
    pub token: syntax.Token, pub error: syntax.Error, pub done: Bool, pub root: U32
}

#[pure]
pub fn initial(token: syntax.Token) -> State {
    let zero = as_u32(0)
    State { nodes: seq.empty(), arguments: seq.empty(), edges: noun.atom(0),
        functions: seq.empty(), params: seq.empty(), returns: 0, statements: seq.empty(), blocks: seq.empty(),
        bindings: seq.empty(), visible: noun.atom(0), current: noun.atom(0),
        frames: noun.atom(0), depth: zero, start: token.start, end: token.start, synthetic: false,
        returned: false, has_tail: false, tail: zero, token,
        error: syntax.error(0, zero, zero), done: false, root: zero }
}

#[pure]
pub fn append(input: State, statement: blocks.Statement, cap: U32) -> State {
    let mut s = input
    if seq.len(s.statements) == cap {
        s.error = syntax.error(7, s.token.start, s.token.end)
        return s
    }
    let id = seq.len(s.statements)
    s.statements = seq.push(s.statements, blocks.pack_statement(statement), cap)
    s.current = noun.pair(noun.atom(as_field(id)), s.current)
    s
}
