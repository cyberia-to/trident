module std.compiler.nox.codegen

use vm.nox.noun
use vm.core.convert
use vm.core.field
use std.nox.seq
use std.nox.tree
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.emit
use std.compiler.nox.formula
use std.compiler.nox.call_codegen
use std.compiler.nox.builtin_gen
use std.compiler.nox.digest_gen
use std.compiler.nox.aggregate_gen
use std.compiler.nox.record_edit_gen
use std.compiler.nox.array_gen
use std.compiler.nox.types
use std.compiler.nox.signatures
use std.compiler.nox.flow

const HALF: Field = 9223372034707292161
pub struct Compiled { pub formula: Noun, pub error: syntax.Error }
// Deepest ancestor first; every sibling axis reads the old subject.
#[pure]
fn zipper(slot: U32, shape: tree.Shape) -> Noun {
    let mut path = noun.atom(0)
    let mut offset = slot
    let mut capacity = shape.capacity
    let mut address: Field = 7
    for level in 0..12 {
        if level == shape.height { return path }
        capacity = capacity * HALF
        let mut right: Field = 0
        let mut sibling = address * 2 + 1
        address = address * 2
        if (offset < as_u32(capacity)) == false {
            right = 1
            sibling = address
            address = address + 1
            offset = as_u32(field.sub(as_field(offset), capacity))
        }
        path = noun.pair(noun.pair(noun.atom(right), noun.atom(sibling)), path)
    }
    path
}

#[pure]
fn frame(value: formula.Value) -> formula.Value {
    formula.Value { formula: formula.cons(formula.axis(2), formula.cons(formula.axis(6), value.formula)), depth: as_u32(as_field(value.depth) + 4) }
}

// The replacement occurs once; reconstruction preserves all sibling slots.
#[pure]
pub fn edit(slot: U32, shape: tree.Shape, replacement: formula.Value) -> formula.Value {
    let mut path = zipper(slot, shape)
    let mut result = replacement
    for level in 0..12 {
        if level == shape.height { return frame(result) }
        let step = noun.head(path)
        let sibling = formula.axis(noun.as_field(noun.tail(step)))
        if noun.as_field(noun.head(step)) == 0 { result.formula = formula.cons(result.formula, sibling) }
        else { result.formula = formula.cons(sibling, result.formula) }
        result.depth = as_u32(as_field(formula.maximum(result.depth, as_u32(1))) + 2)
        path = noun.tail(path)
    }
    frame(result)
}

pub struct Expressions { pub values: seq.Seq, pub next: U32, pub failed: Bool }

#[pure]
fn expression_chunk(nodes: seq.Seq, shape: tree.Shape, input: Expressions, context: call_codegen.Context, depth_cap: U32) -> Expressions {
    let mut s = input
    for turn in 0..8 {
        if s.next == seq.len(nodes) { return s }
        let node = seq.get(nodes, s.next)
        let kind = ast.kind(node)
        let mut code = emit.literal(ast.left(node))
        let mut depth = as_u32(1)
        if kind == 1 { code = formula.axis(7 * shape.capacity + ast.left(node)) }
        else if kind == ast.BUILTIN {
            let called = builtin_gen.generate(as_u32(ast.left(node)), s.values, context.arguments, as_u32(ast.right(node)))
            code = called.formula
            depth = called.depth
        }
        else if syntax.either(kind == ast.TUPLE_VALUE, kind == ast.RECORD_VALUE) {
            let aggregate = aggregate_gen.generate(s.values, context.arguments, as_u32(ast.right(node)), as_u32(ast.left(node)))
            code = aggregate.formula
            depth = aggregate.depth
        }
        else if kind == ast.ARRAY_VALUE {
            let aggregate = array_gen.values(s.values, context.arguments, as_u32(ast.right(node)), as_u32(ast.left(node)))
            code = aggregate.formula
            depth = aggregate.depth
        }
        else if kind == ast.ARRAY_INDEX {
            if context.get_slot == signatures.NONE { s.failed = true return s }
            let length = types.array_info(ast.ty(seq.get(nodes, as_u32(ast.left(node))))).length
            let indexed = array_gen.read(formula.value(s.values, as_u32(ast.left(node))), formula.value(s.values, as_u32(ast.right(node))), length, context.table, context.get_slot)
            code = indexed.formula
            depth = indexed.depth
        }
        else if kind == ast.RECORD_EDIT {
            let edited = record_edit_gen.generate(nodes, s.values, as_u32(ast.left(node)), as_u32(ast.right(node)))
            code = edited.formula
            depth = edited.depth
        }
        else if kind == ast.PROJECT {
            let projection = flow.compose(formula.value(s.values, as_u32(ast.left(node))), flow.axis(ast.right(node)))
            code = projection.formula
            depth = projection.depth
        }
        else if kind == ast.DIGEST_INDEX {
            let indexed = digest_gen.read(formula.value(s.values, as_u32(ast.left(node))), formula.value(s.values, as_u32(ast.right(node))))
            code = indexed.formula
            depth = indexed.depth
        }
        else if kind == ast.CALL {
            let called = call_codegen.generate(context, s.values, as_u32(ast.left(node)), as_u32(ast.right(node)))
            if called.failed { s.failed = true return s }
            code = called.output.formula
            depth = called.output.depth
        }
        else if syntax.either(syntax.either(kind == ast.LITERAL, kind == ast.BOOLEAN), kind == ast.UNIT_VALUE) == false {
            let left = formula.value(s.values, as_u32(ast.left(node)))
            let right = formula.value(s.values, as_u32(ast.right(node)))
            code = emit.binary(as_u32(kind), left.formula, right.formula)
            depth = as_u32(as_field(formula.maximum(left.depth, right.depth)) + 2)
        }
        // RES1 wraps ART1 with nine noun levels above the formula.
        if depth_cap < as_u32(as_field(depth) + 9) { s.failed = true return s }
        s.values = seq.push(s.values, noun.pair(noun.atom(as_field(depth)), code), seq.len(nodes))
        s.next = syntax.inc(s.next)
    }
    s
}

#[pure]
pub fn with_calls(nodes: seq.Seq, shape: tree.Shape, context: call_codegen.Context, depth_cap: U32) -> Expressions {
    let mut s = Expressions { values: seq.empty(), next: as_u32(0), failed: false }
    for block in 0..512 {
        s = expression_chunk(nodes, shape, s, context, depth_cap)
        if syntax.either(s.failed, s.next == seq.len(nodes)) { return s }
    }
    s.failed = true
    s
}

#[pure]
pub fn expressions(nodes: seq.Seq, shape: tree.Shape, depth_cap: U32) -> Expressions {
    with_calls(nodes, shape, call_codegen.empty(), depth_cap)
}

pub struct Statements { pub output: formula.Value, pub remaining: U32, pub failed: Bool }

#[pure]
fn statement_chunk(statements: seq.Seq, values: seq.Seq, shape: tree.Shape, input: Statements, depth_cap: U32) -> Statements {
    let mut s = input
    for turn in 0..8 {
        if s.remaining == as_u32(0) { return s }
        s.remaining = syntax.dec(s.remaining)
        let statement = seq.get(statements, s.remaining)
        let transformer = edit(as_u32(noun.as_field(noun.head(statement))), shape,
            formula.value(values, as_u32(noun.as_field(noun.tail(statement)))))
        s.output.formula = formula.compose(transformer.formula, s.output.formula)
        s.output.depth = as_u32(as_field(formula.maximum(transformer.depth, syntax.inc(s.output.depth))) + 2)
        if depth_cap < as_u32(as_field(s.output.depth) + 9) { s.failed = true return s }
    }
    s
}

#[pure]
pub fn statements(statements: seq.Seq, values: seq.Seq, shape: tree.Shape, result: U32, depth_cap: U32) -> Statements {
    let mut s = Statements { output: formula.value(values, result), remaining: seq.len(statements), failed: false }
    for block in 0..512 {
        s = statement_chunk(statements, values, shape, s, depth_cap)
        if syntax.either(s.failed, s.remaining == as_u32(0)) { return s }
    }
    s.failed = true
    s
}

#[pure]
#[requires((syntax.SOURCE_CAP < seq.len(nodes)) == false)]
#[requires((syntax.SOURCE_CAP < locals) == false)]
pub fn generate(nodes: seq.Seq, writes: seq.Seq, result: U32, locals: U32, depth_cap: U32) -> Compiled {
    let zero = as_u32(0)
    let failure = Compiled { formula: noun.atom(0), error: syntax.error(7, zero, zero) }
    let shape = tree.shape(locals)
    let emitted = expressions(nodes, shape, depth_cap)
    if emitted.failed { return failure }
    let folded = statements(writes, emitted.values, shape, result, depth_cap)
    if folded.failed { return failure }
    let mut output = folded.output
    if (locals == zero) == false {
        let frame = noun.pair(noun.atom(0), noun.pair(noun.atom(0), tree.empty(shape.height)))
        output.formula = formula.compose(noun.pair(noun.atom(1), frame), output.formula)
        output.depth = as_u32(as_field(formula.maximum(as_u32(as_field(shape.height) + 3), syntax.inc(output.depth))) + 2)
    }
    if depth_cap < as_u32(as_field(output.depth) + 9) { return failure }
    Compiled { formula: output.formula, error: syntax.error(0, zero, zero) }
}
