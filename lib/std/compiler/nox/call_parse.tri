module std.compiler.nox.call_parse

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.lexer
use std.compiler.nox.signatures
use std.compiler.nox.call_frames
use std.compiler.nox.expression_state
use std.compiler.nox.builtins
use std.compiler.nox.purity

#[pure]
pub fn enter(source: bytes.Bytes, opening: syntax.Token, input: expression_state.State) -> expression_state.State {
    let mut s = input
    if s.context.scope.pure {
        if purity.is_io(source, s.token) { s.error = syntax.error(5, s.token.start, s.token.end) return s }
    }
    let callee = signatures.lookup(source, s.token, s.context.scope.functions)
    let mut builtin = builtins.NONE
    if callee == signatures.NONE {
        builtin = builtins.lookup(source, s.token)
        if builtin == builtins.NONE { s.error = syntax.error(5, s.token.start, s.token.end) return s }
    }
    if s.ops == s.capacity { s.error = syntax.error(7, opening.start, opening.end) return s }
    let frame = call_frames.Frame { callee, start: s.token.start, ops: s.ops, vals: s.vals,
        count: syntax.ZERO, head: signatures.NONE, builtin }
    s.frames = noun.pair(call_frames.pack(frame), s.frames)
    s.operators = ast.store(s.operators, s.ops, noun.atom(as_field(expression_state.CALL_MARKER)), s.capacity)
    s.ops = syntax.inc(s.ops)
    s.token = lexer.next(source, opening.end)
    s.operand = true
    s
}

// Called only when the nearest delimiter is this call's operator marker.
#[pure]
pub fn finish(source: bytes.Bytes, input: expression_state.State, closing: Bool) -> expression_state.State {
    let mut s = input
    let mut frame = call_frames.read(noun.head(s.frames))
    let mut count = builtins.arity(frame.builtin)
    let mut returns = builtins.returns(frame.builtin)
    let mut params = syntax.ZERO
    if frame.builtin == builtins.NONE {
        let function = signatures.read(seq.get(s.context.scope.functions, frame.callee))
        count = function.count
        returns = function.returns
        params = function.params
    }
    if s.operand == false {
        if (s.vals == syntax.inc(frame.vals)) == false { s.error = syntax.error(2, frame.start, s.token.end) return s }
        if frame.count == count { s.error = syntax.error(5, frame.start, s.token.end) return s }
        let value = as_u32(noun.as_field(seq.get(s.values, frame.vals)))
        let argument = seq.get(s.nodes, value)
        let mut ty = builtins.parameter(frame.builtin)
        if frame.builtin == builtins.NONE {
            let parameter = seq.get(s.context.scope.params, as_u32(as_field(params) + as_field(frame.count)))
            ty = noun.tail(noun.tail(parameter))
        }
        if (noun.eq(ast.ty(argument), ty)) == false { s.error = ast.issue(5, argument) return s }
        if seq.len(s.arguments) == s.node_cap { s.error = syntax.error(7, frame.start, s.token.end) return s }
        let link = seq.len(s.arguments)
        s.arguments = seq.push(s.arguments, noun.pair(noun.atom(as_field(value)), noun.atom(as_field(frame.head))), s.node_cap)
        frame.head = link
        frame.count = syntax.inc(frame.count)
        s.vals = frame.vals
    } else if closing == false { s.error = syntax.error(2, s.token.start, s.token.end) return s }
    if closing {
        if (frame.count == count) == false { s.error = syntax.error(5, frame.start, s.token.end) return s }
        if syntax.either(seq.len(s.nodes) == s.node_cap, s.vals == s.capacity) { s.error = syntax.error(7, frame.start, s.token.end) return s }
        let id = seq.len(s.nodes)
        let mut kind = ast.CALL
        let mut target = frame.callee
        if (frame.builtin == builtins.NONE) == false { kind = ast.BUILTIN target = frame.builtin }
        s.nodes = seq.push(s.nodes, ast.typed(kind, as_field(target), as_field(frame.head), returns, frame.start, s.token.end), s.node_cap)
        s.values = ast.store(s.values, s.vals, noun.atom(as_field(id)), s.capacity)
        s.vals = syntax.inc(s.vals)
        s.ops = frame.ops
        s.frames = noun.tail(s.frames)
        if frame.builtin == builtins.NONE { s.edges = noun.pair(noun.atom(as_field(frame.callee)), s.edges) }
        s.operand = false
    } else {
        s.frames = noun.pair(call_frames.pack(frame), noun.tail(s.frames))
        s.operand = true
    }
    s.token = lexer.next(source, s.token.end)
    s
}
