module std.compiler.nox.function_plan

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.nox.tree
use std.nox.bytes
use std.compiler.nox.signatures
use std.compiler.nox.syntax
use std.compiler.nox.function_order
use std.compiler.nox.call_graph

pub struct Plan { pub order: seq.Seq, pub slots: Noun, pub next: U32, pub error: syntax.Error, pub error_function: U32 }

#[pure]
fn chunk(ordered: seq.Seq, reachable: Noun, functions: U32, input: Plan, cap: U32) -> Plan {
    let mut s = input
    for turn in 0..8 {
        if s.next == seq.len(ordered) { return s }
        let value = seq.get(ordered, s.next)
        let id = as_u32(noun.as_field(value))
        if noun.as_field(tree.get(reachable, functions, id)) == 2 {
            if seq.len(s.order) == cap { s.error = syntax.error(7, syntax.ZERO, syntax.ZERO) return s }
            // Zero is absent. Occupied table indices are stored plus one.
            s.slots = tree.set(s.slots, functions, id, noun.atom(as_field(seq.len(s.order)) + 1))
            s.order = seq.push(s.order, value, cap)
        }
        s.next = syntax.inc(s.next)
    }
    s
}

#[pure]
#[requires(entry < seq.len(functions))]
pub fn plan(source: bytes.Bytes, functions: seq.Seq, bodies: seq.Seq, entry: U32, cap: U32) -> Plan {
    ordered(functions, bodies, function_order.sort(source, functions, cap), entry, cap)
}

#[pure]
#[requires(entry < seq.len(functions))]
pub fn ordered(functions: seq.Seq, bodies: seq.Seq, sorted: function_order.Ordered, entry: U32, cap: U32) -> Plan {
    let zero = syntax.ZERO
    let mut s = Plan { order: seq.empty(), slots: tree.empty(tree.shape(seq.len(functions)).height),
        next: zero, error: syntax.error(0, zero, zero), error_function: signatures.NONE }
    if cap == zero { s.error = syntax.error(7, zero, zero) return s }
    s.error = sorted.error
    if (s.error.code == zero) == false { return s }
    let checked = call_graph.walk(functions, bodies, sorted.ids, cap)
    s.error = checked.error
    s.error_function = checked.error_function
    if (s.error.code == zero) == false { return s }
    let roots = seq.push(seq.empty(), noun.atom(as_field(entry)), cap)
    let reachable = call_graph.walk(functions, bodies, roots, cap)
    s.error = reachable.error
    s.error_function = reachable.error_function
    if (s.error.code == zero) == false { return s }
    for turn in 0..512 {
        s = chunk(sorted.ids, reachable.colors, seq.len(functions), s, cap)
        if syntax.either(s.next == seq.len(sorted.ids), (s.error.code == zero) == false) { return s }
    }
    s.error = syntax.error(7, zero, zero)
    s
}
