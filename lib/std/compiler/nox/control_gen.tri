module std.compiler.nox.control_gen

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.nox.tree
use std.compiler.nox.syntax
use std.compiler.nox.blocks
use std.compiler.nox.body_state
use std.compiler.nox.body_store
use std.compiler.nox.coverage
use std.compiler.nox.codegen
use std.compiler.nox.formula
use std.compiler.nox.flow
use std.compiler.nox.block_gen
use std.compiler.nox.call_codegen
use std.compiler.nox.loop_gen
use std.compiler.nox.entry_frame

struct Linear { writes: seq.Seq, next: U32, eligible: Bool }

#[pure]
fn linear_chunk(statements: seq.Seq, input: Linear) -> Linear {
    let mut s = input
    for turn in 0..8 {
        if s.next == seq.len(statements) { return s }
        let current = blocks.read_statement(seq.get(statements, s.next))
        if (current.kind == blocks.WRITE) == false { s.eligible = false return s }
        s.writes = seq.push(s.writes, noun.pair(noun.atom(as_field(current.a)), noun.atom(as_field(current.b))), seq.len(statements))
        s.next = syntax.inc(s.next)
    }
    s
}

// Keep the canonical formula of the already accepted straight-line subset.
#[pure]
fn linear(statements: seq.Seq) -> Linear {
    let mut s = Linear { writes: seq.empty(), next: syntax.ZERO, eligible: true }
    for turn in 0..512 {
        s = linear_chunk(statements, s)
        if syntax.either(s.eligible == false, s.next == seq.len(statements)) { return s }
    }
    s.eligible = false
    s
}

pub struct Built { pub output: formula.Value, pub loops: seq.Seq, pub failed: Bool }

// A reusable body consumes the existing [table [0 frame]] subject. Callers
// initialize parameters and local padding; body emission never resets them.
#[pure]
#[requires(s.root < seq.len(s.blocks))]
pub fn reusable(s: body_store.Body, flags: Noun, locals: U32, context: call_codegen.Context, depth_cap: U32) -> Built {
    let failure = Built { output: flow.literal(0), loops: seq.empty(), failed: true }
    let shape = tree.shape(locals)
    let expressions = codegen.with_calls(s.nodes, shape, context, depth_cap)
    if expressions.failed { return failure }
    let root = blocks.read(seq.get(s.blocks, s.root))
    if syntax.both(root.has_tail, seq.len(s.blocks) == as_u32(1)) {
        let simple = linear(s.statements)
        if simple.eligible {
            let output = codegen.statements(simple.writes, expressions.values, shape, root.tail, depth_cap)
            return Built { output: output.output, loops: seq.empty(), failed: output.failed }
        }
    }
    let emitted = block_gen.generate(s.blocks, flags, s.statements, expressions.values, shape, depth_cap, s.loops, context)
    if emitted.failed { return failure }
    let loops = loop_gen.generate(s.loops, emitted.values, shape, context, depth_cap)
    if loops.failed { return failure }
    let output = flow.result(block_gen.read(emitted.values, s.root).output)
    Built { output, loops: loops.values, failed: depth_cap < as_u32(as_field(output.depth) + 9) }
}

#[pure]
pub fn standalone(built: Built, locals: U32, depth_cap: U32, structured: Bool) -> codegen.Compiled {
    let zero = syntax.ZERO
    let failure = codegen.Compiled { formula: noun.atom(0), error: syntax.error(7, zero, zero) }
    if syntax.either(built.failed, (seq.len(built.loops) == zero) == false) { return failure }
    let mut output = built.output
    if (locals == zero) == false {
        let shape = tree.shape(locals)
        let frame = noun.pair(noun.atom(0), noun.pair(noun.atom(0), tree.empty(shape.height)))
        let mut initial = formula.Value { formula: noun.pair(noun.atom(1), frame), depth: as_u32(as_field(shape.height) + 3) }
        if structured { initial = entry_frame.subject(flow.literal(0), shape.height) }
        output = flow.compose(initial, output)
    }
    if depth_cap < as_u32(as_field(output.depth) + 9) { return failure }
    codegen.Compiled { formula: output.formula, error: syntax.error(0, zero, zero) }
}

#[pure]
#[requires(s.root < seq.len(s.blocks))]
pub fn generate(s: body_state.State, depth_cap: U32) -> codegen.Compiled {
    let marked = coverage.check(s)
    if (marked.error.code == syntax.ZERO) == false { return codegen.Compiled { formula: noun.atom(0), error: marked.error } }
    let locals = seq.len(s.bindings)
    let mut context = call_codegen.empty()
    context.arguments = s.arguments
    let built = reusable(body_store.checked(s), marked.flags, locals, context, depth_cap)
    standalone(built, locals, depth_cap, false)
}
