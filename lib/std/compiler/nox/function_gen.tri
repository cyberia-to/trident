module std.compiler.nox.function_gen

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.nox.tree
use std.compiler.nox.syntax
use std.compiler.nox.codegen
use std.compiler.nox.control_gen
use std.compiler.nox.body_store
use std.compiler.nox.function_plan
use std.compiler.nox.call_codegen
use std.compiler.nox.formula
use std.compiler.nox.flow
use std.compiler.nox.code_plan
use std.compiler.nox.entry_frame
use std.compiler.nox.array_gen

struct Emitted { table: Noun, depth: U32, next: U32, failed: Bool }

#[pure]
fn install(loops: seq.Seq, base: U32, count: U32, input: Emitted) -> Emitted {
    let mut s = input
    for id in 0..4096 {
        if id == seq.len(loops) { return s }
        let value = formula.value(loops, id)
        s.table = tree.set(s.table, count, as_u32(as_field(base) + as_field(id)), value.formula)
        s.depth = formula.maximum(s.depth, value.depth)
    }
    s
}

#[pure]
fn chunk(bodies: seq.Seq, plan: function_plan.Plan, codes: code_plan.Plan, input: Emitted, cap: U32, depth_cap: U32) -> Emitted {
    let mut s = input
    for turn in 0..8 {
        if s.next == seq.len(plan.order) { return s }
        let id = as_u32(noun.as_field(seq.get(plan.order, s.next)))
        let stored = seq.get(bodies, id)
        let body = body_store.read(stored, cap)
        let base = as_u32(noun.as_field(tree.get(codes.bases, seq.len(bodies), id)))
        let context = call_codegen.Context { arguments: body.arguments, bodies, slots: plan.slots,
            functions: seq.len(bodies), table: tree.shape(codes.count), capacity: cap, loop_base: base, get_slot: codes.get_slot }
        let built = control_gen.reusable(body, body_store.terminal(stored), body_store.locals(stored), context, depth_cap)
        if built.failed { s.failed = true return s }
        s.table = tree.set(s.table, codes.count, s.next, built.output.formula)
        s.depth = formula.maximum(s.depth, built.output.depth)
        s = install(built.loops, base, codes.count, s)
        s.next = syntax.inc(s.next)
    }
    s
}

#[pure]
#[requires(entry < seq.len(bodies))]
#[requires((syntax.SOURCE_CAP < cap) == false)]
pub fn generate(bodies: seq.Seq, plan: function_plan.Plan, entry: U32, cap: U32, depth_cap: U32, structured: Bool) -> codegen.Compiled {
    let zero = as_u32(0)
    let failure = codegen.Compiled { formula: noun.atom(0), error: syntax.error(7, zero, zero) }
    let stored = seq.get(bodies, entry)
    // An acyclic one-body closure contains no user calls. Preserve the existing
    // arithmetic, locals and control artifact identities, even with unused defs.
    if syntax.both(syntax.both(seq.len(plan.order) == as_u32(1), body_store.loop_count(stored) == zero), body_store.needs_get(stored) == false) {
        let body = body_store.read(stored, cap)
        let mut context = call_codegen.empty()
        context.arguments = body.arguments
        context.capacity = cap
        let built = control_gen.reusable(body, body_store.terminal(stored), body_store.locals(stored), context, depth_cap)
        return control_gen.standalone(built, body_store.locals(stored), depth_cap, structured)
    }
    let codes = code_plan.extend(bodies, plan, cap)
    if codes.failed { return failure }
    let shape = tree.shape(codes.count)
    let mut s = Emitted { table: tree.empty(shape.height), depth: zero, next: zero, failed: false }
    if codes.needs_get {
        let helper = array_gen.helper(shape, codes.get_slot)
        s.table = tree.set(s.table, codes.count, codes.get_slot, helper.formula)
        s.depth = helper.depth
    }
    for turn in 0..512 {
        s = chunk(bodies, plan, codes, s, cap, depth_cap)
        if s.failed { return failure }
        if s.next == seq.len(plan.order) {
            let frame = tree.shape(body_store.locals(stored))
            let subject = noun.pair(s.table, noun.pair(noun.atom(0), tree.empty(frame.height)))
            let table_depth = as_u32(as_field(s.depth) + as_field(shape.height))
            let subject_depth = syntax.inc(formula.maximum(table_depth, syntax.inc(frame.height)))
            let mut initial = formula.Value { formula: noun.pair(noun.atom(1), subject), depth: syntax.inc(subject_depth) }
            if structured {
                let table = formula.Value { formula: noun.pair(noun.atom(1), s.table), depth: syntax.inc(table_depth) }
                initial = entry_frame.subject(table, frame.height)
            }
            let occupied = noun.as_field(tree.get(plan.slots, seq.len(bodies), entry))
            let slot = syntax.dec(as_u32(occupied))
            let dispatch = formula.apply(flow.axis(1), flow.axis(2 * shape.capacity + as_field(slot)))
            let output = flow.compose(initial, dispatch)
            if depth_cap < as_u32(as_field(output.depth) + 9) { return failure }
            return codegen.Compiled { formula: output.formula, error: syntax.error(0, zero, zero) }
        }
    }
    failure
}
