module std.compiler.nox.tuple_bind

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.types
use std.compiler.nox.symbols
use std.compiler.nox.blocks
use std.compiler.nox.body_state
use std.compiler.nox.tuple_pattern

// The expression has already been parsed against the old scope. Every target
// is checked before a hidden RHS slot or any ordered component writes exist.
#[pure]
pub fn bind(source: bytes.Bytes, input: body_state.State, names: seq.Seq, writable: Bool, declaration: Bool, value: U32, cap: U32) -> body_state.State {
    let mut s = input
    let rhs = seq.get(s.nodes, value)
    let parts = types.parts(ast.ty(rhs))
    let count = seq.len(names)
    if syntax.either(parts.valid == false, (count == parts.count) == false) {
        s.error = ast.issue(5, rhs) return s
    }
    let mut targets = seq.empty()
    for i in 0..16 {
        if i < count {
            let name = tuple_pattern.name(seq.get(names, i))
            if declaration == false {
                let found = symbols.lookup(source, name, s.bindings, s.visible)
                if syntax.either(syntax.either(found.exists == false, found.writable == false), noun.eq(found.ty, types.component(parts, i)) == false) {
                    s.error = syntax.error(5, name.start, name.end) return s
                }
                targets = seq.push(targets, noun.atom(as_field(found.slot)), cap)
            }
        }
    }
    if syntax.either(seq.len(s.bindings) == cap, seq.len(s.nodes) == cap) { s.error = ast.issue(7, rhs) return s }
    let hidden = seq.len(s.bindings)
    let name = syntax.token(1, ast.start(rhs), ast.end(rhs), 0)
    s.bindings = seq.push(s.bindings, symbols.binding(name, false, ast.ty(rhs)), cap)
    s = body_state.append(s, blocks.statement(blocks.WRITE, hidden, value, syntax.ZERO), cap)
    if (s.error.code == syntax.ZERO) == false { return s }
    let base = seq.len(s.nodes)
    s.nodes = seq.push(s.nodes, ast.typed(ast.LOCAL, as_field(hidden), 0, ast.ty(rhs), ast.start(rhs), ast.end(rhs)), cap)
    let mut axis: Field = 2
    for i in 0..16 {
        if i == count { return s }
        let name = tuple_pattern.name(seq.get(names, i))
        if tuple_pattern.discard(name) == false {
            let ty = types.component(parts, i)
            if syntax.either(seq.len(s.nodes) == cap, syntax.both(declaration, seq.len(s.bindings) == cap)) { s.error = ast.issue(7, rhs) return s }
            let mut slot = seq.len(s.bindings)
            if declaration == false { slot = as_u32(noun.as_field(seq.get(targets, i))) }
            let mut projection = axis
            if parts.digest { projection = 4 + as_field(i) }
            let projected = seq.len(s.nodes)
            s.nodes = seq.push(s.nodes, ast.typed(ast.PROJECT, as_field(base), projection, ty, name.start, name.end), cap)
            s = body_state.append(s, blocks.statement(blocks.WRITE, slot, projected, syntax.ZERO), cap)
            if (s.error.code == syntax.ZERO) == false { return s }
            if declaration {
                s.bindings = seq.push(s.bindings, symbols.binding(name, writable, ty), cap)
                s.visible = noun.pair(noun.atom(as_field(slot)), s.visible)
            }
        }
        axis = axis * 2 + 2
    }
    s
}
