module std.compiler.nox.coverage

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.nox.tree
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.blocks
use std.compiler.nox.terminal
use std.compiler.nox.body_state
use std.compiler.nox.loop_records
use std.compiler.nox.types
use std.compiler.nox.halting

pub struct Checked { pub flags: Noun, pub error: syntax.Error }
struct State { flags: Noun, next: U32 }
struct Block { covered: Bool, remaining: Noun }

#[pure]
fn statement(s: blocks.Statement, nodes: seq.Seq, arguments: seq.Seq, flags: Noun, count: U32, loops: seq.Seq) -> Bool {
    if s.kind == blocks.RETURN { return true }
    if s.kind == blocks.EVAL { return halting.is_false_assert(seq.get(nodes, s.a), nodes, arguments) }
    if s.kind == blocks.FOR {
        let record = loop_records.read(seq.get(loops, s.a))
        if record.end == 4294967296 { return false }
        return syntax.both(loop_records.nonempty(record), noun.as_field(tree.get(flags, count, record.body)) == 1)
    }
    if (s.kind == blocks.IF) == false { return false }
    let yes = noun.as_field(tree.get(flags, count, s.b)) == 1
    let mut no = false
    if (s.c == blocks.NONE) == false { no = noun.as_field(tree.get(flags, count, s.c)) == 1 }
    let condition = seq.get(nodes, s.a)
    if syntax.either(ast.kind(condition) == ast.LITERAL, syntax.either(ast.kind(condition) == ast.BOOLEAN, ast.kind(condition) == ast.CONSTANT)) {
        if ast.left(condition) == 0 { return yes }
        return no
    }
    syntax.both(yes, no)
}

#[pure]
fn statement_chunk(input: Block, nodes: seq.Seq, statements: seq.Seq, arguments: seq.Seq, flags: Noun, count: U32, loops: seq.Seq) -> Block {
    let mut s = input
    for turn in 0..8 {
        if noun.eq(s.remaining, noun.atom(0)) { return s }
        let id = as_u32(noun.as_field(noun.head(s.remaining)))
        s.covered = syntax.either(s.covered, statement(blocks.read_statement(seq.get(statements, id)), nodes, arguments, flags, count, loops))
        s.remaining = noun.tail(s.remaining)
    }
    s
}

#[pure]
fn block(body: blocks.Block, terminal: Bool, nodes: seq.Seq, statements: seq.Seq, arguments: seq.Seq, flags: Noun, count: U32, loops: seq.Seq) -> Bool {
    let mut s = Block { covered: syntax.both(body.has_tail, terminal), remaining: body.statements }
    if body.has_tail {
        if terminal == false { s.covered = halting.is_false_assert(seq.get(nodes, body.tail), nodes, arguments) }
    }
    // All statements and terminal tails have already been type checked. Once
    // the tail covers this block, scanning earlier statements adds no evidence.
    if s.covered { return true }
    for turn in 0..512 {
        s = statement_chunk(s, nodes, statements, arguments, flags, count, loops)
        if noun.eq(s.remaining, noun.atom(0)) { return s.covered }
    }
    // Source-built lists contain at most SOURCE_CAP statement records.
    false
}

#[pure]
fn chunk(input: State, s: body_state.State, terminal: Noun) -> State {
    let mut state = input
    let count = seq.len(s.blocks)
    for turn in 0..8 {
        if state.next == count { return state }
        let tail_returns = noun.as_field(tree.get(terminal, count, state.next)) == 1
        let covered = block(blocks.read(seq.get(s.blocks, state.next)), tail_returns, s.nodes, s.statements, s.arguments, state.flags, count, s.loops)
        state.flags = tree.set(state.flags, count, state.next, blocks.flag(covered))
        state.next = syntax.inc(state.next)
    }
    state
}

// Type-check every terminal tail before coverage, including unselected arms.
#[pure]
#[requires(s.root < seq.len(s.blocks))]
pub fn check(s: body_state.State) -> Checked {
    let zero = syntax.ZERO
    let marked = terminal.mark(s.nodes, s.statements, s.blocks, s.arguments, s.root, s.returns)
    if (marked.error.code == zero) == false { return Checked { flags: marked.flags, error: marked.error } }
    let mut state = State { flags: tree.empty(tree.shape(seq.len(s.blocks)).height), next: zero }
    for turn in 0..512 {
        state = chunk(state, s, marked.flags)
        if state.next == seq.len(s.blocks) {
            if noun.eq(s.returns, noun.atom(types.UNIT)) { return Checked { flags: marked.flags, error: syntax.error(0, zero, zero) } }
            if noun.as_field(tree.get(state.flags, seq.len(s.blocks), s.root)) == 1 { return Checked { flags: marked.flags, error: syntax.error(0, zero, zero) } }
            let root = blocks.read(seq.get(s.blocks, s.root))
            return Checked { flags: marked.flags, error: syntax.error(5, root.start, root.end) }
        }
    }
    Checked { flags: marked.flags, error: syntax.error(7, zero, zero) }
}
