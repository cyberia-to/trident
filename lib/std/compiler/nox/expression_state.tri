module std.compiler.nox.expression_state

use std.compiler.nox.check_scope
use vm.nox.noun
use std.nox.seq
use std.compiler.nox.syntax

pub const CALL_MARKER: U32 = 27
// Internal marker: a parenthesized expression becomes a tuple at its first comma.
pub const TUPLE_MARKER: U32 = 38
pub const RECORD_MARKER: U32 = 42
pub const ARRAY_MARKER: U32 = 44
pub struct Context {
    pub bindings: seq.Seq, pub visible: Noun, pub scope: check_scope.Scope
}
pub struct Parsed {
    pub nodes: seq.Seq, pub arguments: seq.Seq, pub edges: Noun,
    pub value: U32, pub token: syntax.Token, pub error: syntax.Error, pub needs_get: Bool
}
pub struct State {
    // Delimiters update this list at every open/close. Keep it at the head of
    // the persistent record so nested groups do not rebuild its whole spine.
    pub frames: Noun, pub token: syntax.Token,
    pub ops: U32, pub operators: seq.Seq, pub nodes: seq.Seq,
    pub values: seq.Seq, pub vals: U32, pub operand: Bool,
    pub done: Bool, pub error: syntax.Error,
    pub capacity: U32, pub node_cap: U32,
    pub context: Context, pub before_block: Bool,
    pub arguments: seq.Seq, pub edges: Noun, pub needs_get: Bool
}

#[pure]
pub fn context(bindings: seq.Seq, visible: Noun, scope: check_scope.Scope) -> Context {
    Context { bindings, visible, scope }
}
