module std.compiler.nox.ast

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.types

pub const LITERAL: Field = 0
pub const LOCAL: Field = 1
pub const BOOLEAN: Field = 2
pub const ADD: Field = 3
pub const MUL: Field = 4
pub const EQUAL: Field = 5
pub const CALL: Field = 6
pub const UNIT_VALUE: Field = 7
pub const LESS: Field = 8
pub const BIT_AND: Field = 9
pub const BUILTIN: Field = 10
pub const DIGEST_INDEX: Field = 11
pub const TUPLE_VALUE: Field = 12
pub const PROJECT: Field = 13
pub const RECORD_VALUE: Field = 14
pub const RECORD_EDIT: Field = 15
pub const ARRAY_VALUE: Field = 16
pub const ARRAY_INDEX: Field = 17
pub const CONSTANT: Field = 18

// Postorder expression: [[kind [left right]] [type [start end]]].
// Child IDs precede their parent. AST operations are independent of token kinds.
#[pure]
pub fn typed(kind: Field, left: Field, right: Field, ty: Noun, start: U32, end: U32) -> Noun {
    let value = noun.pair(noun.atom(kind), noun.pair(noun.atom(left), noun.atom(right)))
    let span = noun.pair(noun.atom(as_field(start)), noun.atom(as_field(end)))
    noun.pair(value, noun.pair(ty, span))
}

// Internal component builders can omit source spans.
#[pure]
pub fn node(kind: Field, left: Field, right: Field) -> Noun {
    let mut ty = noun.atom(types.FIELD)
    if syntax.either(kind == BOOLEAN, kind == EQUAL) { ty = noun.atom(types.BOOL) }
    if kind == UNIT_VALUE { ty = noun.atom(types.UNIT) }
    if kind == LESS { ty = noun.atom(types.BOOL) }
    if kind == BIT_AND { ty = noun.atom(types.UINT32) }
    typed(kind, left, right, ty, syntax.ZERO, syntax.ZERO)
}

#[pure]
pub fn kind(node: Noun) -> Field { noun.as_field(noun.head(noun.head(node))) }

#[pure]
pub fn left(node: Noun) -> Field { noun.as_field(noun.head(noun.tail(noun.head(node)))) }

#[pure]
pub fn right(node: Noun) -> Field { noun.as_field(noun.tail(noun.tail(noun.head(node)))) }

#[pure]
pub fn ty(node: Noun) -> Noun { noun.head(noun.tail(node)) }

#[pure]
pub fn start(node: Noun) -> U32 { as_u32(noun.as_field(noun.head(noun.tail(noun.tail(node))))) }

#[pure]
pub fn end(node: Noun) -> U32 { as_u32(noun.as_field(noun.tail(noun.tail(noun.tail(node))))) }

#[pure]
pub fn issue(code: Field, node: Noun) -> syntax.Error { syntax.error(code, start(node), end(node)) }

#[pure]
pub fn store(stack: seq.Seq, length: U32, value: Noun, cap: U32) -> seq.Seq {
    if length < seq.len(stack) { return seq.set(stack, length, value) }
    seq.push(stack, value, cap)
}

#[pure]
pub fn failed(token: syntax.Token, fallback: Field) -> syntax.Error {
    if token.kind == as_u32(46) { return syntax.error(6, token.start, token.end) }
    if token.kind == as_u32(45) { return syntax.error(6, token.start, token.end) }
    if token.kind == as_u32(43) { return syntax.error(6, token.start, token.end) }
    if syntax.either(token.kind == as_u32(41), syntax.either(token.kind == as_u32(39), token.kind == as_u32(40))) { return syntax.error(6, token.start, token.end) }
    if token.kind == as_u32(35) { return syntax.error(6, token.start, token.end) }
    if syntax.either(token.kind == as_u32(34), token.kind == as_u32(28)) { return syntax.error(6, token.start, token.end) }
    if syntax.either(token.kind == as_u32(20), token.kind == as_u32(23)) { return syntax.error(6, token.start, token.end) }
    if token.kind == as_u32(14) { return syntax.error(1, token.start, token.end) }
    if syntax.either(syntax.either(syntax.either(token.kind == as_u32(13), token.kind == as_u32(10)), token.kind == as_u32(11)), token.kind == as_u32(12)) {
        return syntax.error(6, token.start, token.end)
    }
    syntax.error(fallback, token.start, token.end)
}
