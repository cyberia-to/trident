module std.compiler.nox.function_order

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.signatures

pub struct Ordered { pub ids: seq.Seq, pub next: U32, pub error: syntax.Error }
struct Insert { ids: seq.Seq, gap: U32, done: Bool }
struct Merge { output: seq.Seq, left: U32, right: U32, middle: U32, end: U32 }

#[pure]
fn before(source: bytes.Bytes, left: syntax.Token, right: syntax.Token) -> Bool {
    let mut a = left.start
    let mut b = right.start
    for turn in 0..65536 {
        if a == left.end { return (b == right.end) == false }
        if b == right.end { return false }
        let x = bytes.get(source, a)
        let y = bytes.get(source, b)
        if x < y { return true }
        if y < x { return false }
        a = syntax.inc(a)
        b = syntax.inc(b)
    }
    false
}

#[pure]
fn insert_chunk(source: bytes.Bytes, functions: seq.Seq, name: syntax.Token, input: Insert) -> Insert {
    let mut s = input
    for turn in 0..8 {
        if s.gap == syntax.ZERO { s.done = true return s }
        let previous = seq.get(s.ids, syntax.dec(s.gap))
        let declaration = signatures.read(seq.get(functions, as_u32(noun.as_field(previous))))
        if before(source, name, declaration.name) == false { s.done = true return s }
        s.ids = seq.set(s.ids, s.gap, previous)
        s.gap = syntax.dec(s.gap)
    }
    s
}

#[pure]
fn insert(source: bytes.Bytes, functions: seq.Seq, input: seq.Seq, id: U32, cap: U32) -> seq.Seq {
    let declaration = signatures.read(seq.get(functions, id))
    let value = noun.atom(as_field(id))
    let mut s = Insert { ids: seq.push(input, value, cap), gap: seq.len(input), done: false }
    for turn in 0..512 {
        s = insert_chunk(source, functions, declaration.name, s)
        if s.done { return seq.set(s.ids, s.gap, value) }
    }
    // At most TABLE_CAP final bindings can precede this insertion.
    seq.set(s.ids, s.gap, value)
}

#[pure]
fn merge_chunk(source: bytes.Bytes, functions: seq.Seq, values: seq.Seq, input: Merge, cap: U32) -> Merge {
    let mut s = input
    for step in 0..8 {
        if seq.len(s.output) == s.end { return s }
        let mut take_right = s.left == s.middle
        if syntax.both(s.left < s.middle, s.right < s.end) {
            let left = signatures.read(seq.get(functions, as_u32(noun.as_field(seq.get(values, s.left))))).name
            let right = signatures.read(seq.get(functions, as_u32(noun.as_field(seq.get(values, s.right))))).name
            take_right = before(source, right, left)
        }
        if take_right {
            s.output = seq.push(s.output, seq.get(values, s.right), cap)
            s.right = syntax.inc(s.right)
        } else {
            s.output = seq.push(s.output, seq.get(values, s.left), cap)
            s.left = syntax.inc(s.left)
        }
    }
    s
}

#[pure]
fn merge(source: bytes.Bytes, functions: seq.Seq, values: seq.Seq, width: U32, output: seq.Seq, cap: U32) -> seq.Seq {
    let start = seq.len(output)
    let mut middle = as_u32(as_field(start) + as_field(width))
    if seq.len(values) < middle { middle = seq.len(values) }
    let mut end = as_u32(as_field(middle) + as_field(width))
    if seq.len(values) < end { end = seq.len(values) }
    let mut s = Merge { output, left: start, right: middle, middle, end }
    for block in 0..512 {
        s = merge_chunk(source, functions, values, s, cap)
        if seq.len(s.output) == s.end { return s.output }
    }
    s.output
}

#[pure]
fn pass(source: bytes.Bytes, functions: seq.Seq, values: seq.Seq, width: U32, cap: U32) -> seq.Seq {
    let mut output = seq.empty()
    for run in 0..4096 {
        if seq.len(output) == seq.len(values) { return output }
        output = merge(source, functions, values, width, output, cap)
    }
    output
}

// Explicit roots already own final binding selection and original tie order.
// Package compilation calls this on one owner's bucket; no owner/rank metadata
// enters the member comparator. The ordinary sort entry keeps its old path.
#[pure]
#[requires((syntax.TABLE_CAP < seq.len(functions)) == false)]
#[requires((syntax.TABLE_CAP < cap) == false)]
#[requires((cap < seq.len(roots)) == false)]
pub fn sort_roots(source: bytes.Bytes, functions: seq.Seq, roots: seq.Seq, cap: U32) -> seq.Seq {
    let mut output = roots
    let mut width = as_u32(1)
    for level in 0..12 {
        if (width < seq.len(output)) == false { return output }
        output = pass(source, functions, output, width, cap)
        width = as_u32(as_field(width) * 2)
    }
    output
}

#[pure]
fn chunk(source: bytes.Bytes, functions: seq.Seq, input: Ordered, cap: U32) -> Ordered {
    let mut s = input
    for turn in 0..8 {
        if s.next == seq.len(functions) { return s }
        let declaration = signatures.read(seq.get(functions, s.next))
        if signatures.lookup(source, declaration.name, functions) == s.next {
            if seq.len(s.ids) == cap { s.error = syntax.error(7, declaration.name.start, declaration.name.end) return s }
            s.ids = insert(source, functions, s.ids, s.next, cap)
        }
        s.next = syntax.inc(s.next)
    }
    s
}

#[pure]
#[requires((syntax.TABLE_CAP < seq.len(functions)) == false)]
pub fn sort(source: bytes.Bytes, functions: seq.Seq, cap: U32) -> Ordered {
    let zero = syntax.ZERO
    let mut s = Ordered { ids: seq.empty(), next: zero, error: syntax.error(0, zero, zero) }
    for turn in 0..512 {
        s = chunk(source, functions, s, cap)
        if syntax.either(s.next == seq.len(functions), (s.error.code == zero) == false) { return s }
    }
    s.error = syntax.error(7, zero, zero)
    s
}
