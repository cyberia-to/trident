module std.compiler.nox.block_gen

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.nox.tree
use std.compiler.nox.syntax
use std.compiler.nox.blocks
use std.compiler.nox.codegen
use std.compiler.nox.formula
use std.compiler.nox.flow
use std.compiler.nox.loop_records
use std.compiler.nox.loop_gen
use std.compiler.nox.call_codegen

pub struct Built { pub output: formula.Value }
struct Fold { output: formula.Value, remaining: Noun, failed: Bool }
pub struct Emitted { pub values: seq.Seq, pub next: U32, pub failed: Bool }

#[pure]
pub fn read(values: seq.Seq, id: U32) -> Built {
    Built { output: formula.value(values, id) }
}

#[pure]
fn statement(s: blocks.Statement, values: seq.Seq, emitted: seq.Seq, shape: tree.Shape, loops: seq.Seq, context: call_codegen.Context) -> Built {
    if s.kind == blocks.WRITE { return Built { output: flow.keep(codegen.edit(s.a, shape, formula.value(values, s.b))) } }
    if s.kind == blocks.RETURN { return Built { output: flow.returned(formula.value(values, s.a)) } }
    if s.kind == blocks.EVAL { return Built { output: flow.discard(formula.value(values, s.a)) } }
    if s.kind == blocks.FOR { return Built { output: loop_gen.initialize(loop_records.read(seq.get(loops, s.a)), s.a, shape, context) } }
    let yes = read(emitted, s.b)
    let mut no = Built { output: flow.keep(flow.axis(1)) }
    if (s.c == blocks.NONE) == false { no = read(emitted, s.c) }
    Built { output: flow.branch(formula.value(values, s.a), yes.output, no.output) }
}

#[pure]
fn chunk(statements: seq.Seq, values: seq.Seq, emitted: seq.Seq, shape: tree.Shape, input: Fold, depth_cap: U32, loops: seq.Seq, context: call_codegen.Context) -> Fold {
    let mut s = input
    for turn in 0..8 {
        if noun.eq(s.remaining, noun.atom(0)) { return s }
        let id = as_u32(noun.as_field(noun.head(s.remaining)))
        let current = statement(blocks.read_statement(seq.get(statements, id)), values, emitted, shape, loops, context)
        s.output = flow.then(current.output, s.output)
        s.remaining = noun.tail(s.remaining)
        if depth_cap < as_u32(as_field(s.output.depth) + 9) { s.failed = true return s }
    }
    s
}

#[pure]
fn block(body: blocks.Block, terminal: Bool, statements: seq.Seq, values: seq.Seq, emitted: seq.Seq, shape: tree.Shape, depth_cap: U32, loops: seq.Seq, context: call_codegen.Context) -> Fold {
    let mut output = flow.keep(flow.axis(1))
    if body.has_tail {
        output = flow.discard(formula.value(values, body.tail))
        if terminal { output = flow.returned(formula.value(values, body.tail)) }
    }
    let mut s = Fold { output, remaining: body.statements, failed: false }
    for turn in 0..512 {
        s = chunk(statements, values, emitted, shape, s, depth_cap, loops, context)
        if syntax.either(s.failed, noun.eq(s.remaining, noun.atom(0))) { return s }
    }
    s.failed = true
    s
}

#[pure]
fn block_chunk(bodies: seq.Seq, flags: Noun, statements: seq.Seq, values: seq.Seq, shape: tree.Shape, input: Emitted, depth_cap: U32, loops: seq.Seq, context: call_codegen.Context) -> Emitted {
    let mut s = input
    for turn in 0..8 {
        if s.next == seq.len(bodies) { return s }
        let terminal = noun.as_field(tree.get(flags, seq.len(bodies), s.next)) == 1
        let built = block(blocks.read(seq.get(bodies, s.next)), terminal, statements, values, s.values, shape, depth_cap, loops, context)
        if built.failed { s.failed = true return s }
        let output = noun.pair(noun.atom(as_field(built.output.depth)), built.output.formula)
        s.values = seq.push(s.values, output, seq.len(bodies))
        s.next = syntax.inc(s.next)
    }
    s
}

#[pure]
#[requires((syntax.SOURCE_CAP < seq.len(bodies)) == false)]
pub fn generate(bodies: seq.Seq, flags: Noun, statements: seq.Seq, values: seq.Seq, shape: tree.Shape, depth_cap: U32, loops: seq.Seq, context: call_codegen.Context) -> Emitted {
    let mut s = Emitted { values: seq.empty(), next: as_u32(0), failed: false }
    for turn in 0..512 {
        s = block_chunk(bodies, flags, statements, values, shape, s, depth_cap, loops, context)
        if syntax.either(s.failed, s.next == seq.len(bodies)) { return s }
    }
    s.failed = true
    s
}
