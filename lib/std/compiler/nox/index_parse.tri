module std.compiler.nox.index_parse

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.types
use std.compiler.nox.lexer
use std.compiler.nox.expression_state

// Index and call frames share a delimiter-owned stack. An index frame keeps
// [base-node saved-value-count]; the '[' marker owns its matching ']'.
#[pure]
pub fn enter(source: bytes.Bytes, input: expression_state.State) -> expression_state.State {
    let mut s = input
    if s.ops == s.capacity { s.error = ast.failed(s.token, 7) return s }
    s.vals = syntax.dec(s.vals)
    let base = seq.get(s.values, s.vals)
    let node = seq.get(s.nodes, as_u32(noun.as_field(base)))
    if noun.eq(ast.ty(node), noun.atom(types.DIGEST)) == false { s.error = ast.issue(5, node) return s }
    s.frames = noun.pair(noun.pair(base, noun.atom(as_field(s.vals))), s.frames)
    s.operators = ast.store(s.operators, s.ops, noun.atom(36), s.capacity)
    s.ops = syntax.inc(s.ops)
    s.token = lexer.next(source, s.token.end)
    s.operand = true
    s
}

#[pure]
pub fn finish(source: bytes.Bytes, input: expression_state.State) -> expression_state.State {
    let mut s = input
    let frame = noun.head(s.frames)
    let base = noun.as_field(noun.head(frame))
    let saved = as_u32(noun.as_field(noun.tail(frame)))
    if s.vals == syntax.inc(saved) {
        let index = noun.as_field(seq.get(s.values, saved))
        let node = seq.get(s.nodes, as_u32(index))
        let ty = ast.ty(node)
        if syntax.either(noun.eq(ty, noun.atom(types.FIELD)), noun.eq(ty, noun.atom(types.UINT32))) == false {
            s.error = ast.issue(5, node) return s
        }
        if seq.len(s.nodes) == s.node_cap { s.error = ast.failed(s.token, 7) return s }
        let id = seq.len(s.nodes)
        let start = ast.start(seq.get(s.nodes, as_u32(base)))
        s.nodes = seq.push(s.nodes, ast.typed(ast.DIGEST_INDEX, base, index, noun.atom(types.FIELD), start, s.token.end), s.node_cap)
        s.values = seq.set(s.values, saved, noun.atom(as_field(id)))
        s.ops = syntax.dec(s.ops)
        s.frames = noun.tail(s.frames)
        s.token = lexer.next(source, s.token.end)
        s.operand = false
        return s
    }
    s.error = ast.failed(s.token, 2)
    s
}
