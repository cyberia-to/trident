module std.compiler.nox.header_state

use vm.core.convert
use std.nox.seq
use std.compiler.nox.ast
use std.compiler.nox.syntax
use std.compiler.nox.signatures

pub struct State {
    pub functions: seq.Seq, pub params: seq.Seq, pub entry: U32,
    pub token: syntax.Token, pub current: signatures.Function,
    pub phase: Field, pub nesting: U32, pub error: syntax.Error, pub done: Bool
}

#[pure]
pub fn initial(token: syntax.Token) -> State {
    let zero = as_u32(0)
    State { functions: seq.empty(), params: seq.empty(), entry: signatures.NONE, token,
        current: signatures.Function { name: token, params: zero, count: zero, returns: ast.UNIT, open: zero, close: zero },
        phase: 0, nesting: zero, error: syntax.error(0, zero, zero), done: false }
}
