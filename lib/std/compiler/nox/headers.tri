module std.compiler.nox.headers

use std.compiler.nox.const_parse
use std.compiler.nox.constants
use std.compiler.nox.constant_imports
use std.compiler.nox.attributes
use vm.core.convert
use vm.core.field
use vm.nox.noun
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.lexer
use std.compiler.nox.symbols
use std.compiler.nox.signatures
use std.compiler.nox.header_state
use std.compiler.nox.types
use std.compiler.nox.struct_parse
use std.compiler.nox.type_parse
use std.compiler.nox.type_imports
use std.compiler.nox.intrinsic_abi
use std.compiler.nox.intrinsic_bindings

#[pure]
fn expected(token: syntax.Token) -> syntax.Error {
    if token.kind == as_u32(14) { return syntax.error(1, token.start, token.end) }
    if token.kind == as_u32(46) { return syntax.error(6, token.start, token.end) }
    if token.kind == as_u32(13) { return syntax.error(6, token.start, token.end) }
    syntax.error(2, token.start, token.end)
}

#[pure]
pub fn scalar(token: syntax.Token) -> Field { type_parse.scalar(token) }

// One completed signature occupies one global declaration ID. Cold metadata
// resets here so adjacent unannotated declarations cannot inherit an identity.
#[pure]
fn complete(input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    let id = seq.len(s.functions)
    if s.current.name.value == 1835100526 { s.entry = id }
    if s.metadata.pure { s.pure_functions = seq.push(s.pure_functions, noun.atom(as_field(id)), cap) }
    if s.metadata.exported { s.public_functions = seq.push(s.public_functions, noun.atom(as_field(id)), cap) }
    if s.metadata.intrinsic {
        s.intrinsics = intrinsic_bindings.append(s.intrinsics, id, s.metadata.identity, cap)
    }
    s.functions = seq.push(s.functions, signatures.pack(s.current), cap)
    s.metadata = header_state.metadata()
    s.phase = 0
    s
}

#[pure]
fn open(source: bytes.Bytes, input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    // Called at the closing parameter parenthesis, with an optional annotation.
    s.token = lexer.next(source, s.token.end)
    if s.token.kind == as_u32(9) {
        s.token = lexer.next(source, s.token.end)
        let parsed = type_parse.parse(source, s.token, s.types, cap)
        s.error = parsed.error
        if (s.error.code == syntax.ZERO) == false { return s }
        s.current.returns = parsed.ty
        s.token = parsed.token
    }
    if s.metadata.intrinsic {
        if s.token.kind == as_u32(7) {
            s.error = syntax.error(6, s.metadata.start, s.metadata.end) return s
        }
        if intrinsic_abi.valid(s.metadata.identity, s.current, s.params) == false {
            s.error = syntax.error(5, s.metadata.start, s.metadata.end) return s
        }
        s.current.close = s.token.start
        return complete(s, cap)
    }
    if (s.token.kind == as_u32(7)) == false { s.error = expected(s.token) return s }
    s.current.open = s.token.end
    s.phase = 2
    s.nesting = as_u32(1)
    s.token = lexer.next(source, s.token.end)
    s
}

#[pure]
fn parameter(source: bytes.Bytes, input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    if s.token.kind == as_u32(6) { return open(source, s, cap) }
    let name = s.token
    if (name.kind == as_u32(1)) == false { s.error = expected(name) return s }
    s.token = lexer.next(source, name.end)
    if (s.token.kind == as_u32(17)) == false { s.error = expected(s.token) return s }
    s.token = lexer.next(source, s.token.end)
    let parsed = type_parse.parse(source, s.token, s.types, cap)
    s.error = parsed.error
    if (s.error.code == syntax.ZERO) == false { return s }
    if seq.len(s.params) == cap { s.error = syntax.error(7, name.start, name.end) return s }
    s.params = seq.push(s.params, symbols.binding(name, false, parsed.ty), cap)
    s.current.count = syntax.inc(s.current.count)
    s.token = parsed.token
    if s.token.kind == as_u32(6) { return open(source, s, cap) }
    if (s.token.kind == as_u32(26)) == false { s.error = expected(s.token) return s }
    s.token = lexer.next(source, s.token.end)
    s
}

#[pure]
fn step(source: bytes.Bytes, input: header_state.State, cap: U32, type_limit: U32) -> header_state.State {
    let mut s = input
    if s.phase == 1 { return parameter(source, s, cap) }
    if s.phase == 2 {
        if s.token.kind == syntax.ZERO { s.error = expected(s.token) return s }
        if s.token.kind == as_u32(14) { s.error = ast.failed(s.token, 1) return s }
        if s.token.kind == as_u32(7) { s.nesting = syntax.inc(s.nesting) }
        if s.token.kind == as_u32(8) {
            s.nesting = syntax.dec(s.nesting)
            if s.nesting == syntax.ZERO {
                s.current.close = s.token.end
                s = complete(s, cap)
            }
        }
        s.token = lexer.next(source, s.token.end)
        return s
    }
    if s.token.kind == syntax.ZERO { s.done = true return s }
    let annotated = s.token.kind == attributes.HASH
    if annotated {
        let parsed = attributes.parse(source, s.token)
        s.token = parsed.token
        s.error = parsed.error
        if (s.error.code == syntax.ZERO) == false { return s }
        s.metadata = header_state.Metadata { pure: parsed.pure, exported: false,
            intrinsic: parsed.intrinsic, identity: parsed.identity,
            start: parsed.intrinsic_start, end: parsed.intrinsic_end }
    }
    let mut public = false
    if s.token.kind == as_u32(40) { public = true s.token = lexer.next(source, s.token.end) }
    if annotated {
        if (s.token.kind == as_u32(11)) == false {
            if s.token.kind == as_u32(14) { s.error = syntax.error(1, s.token.start, s.token.end) }
            else { s.error = syntax.error(2, s.token.start, s.token.end) }
            return s
        }
    }
    if s.token.kind == as_u32(45) {
        s.constants.owner = s.types.owner
        let parsed = const_parse.parse(source, s.token, s.constants, public, cap)
        s.constants = parsed.scope
        s.token = parsed.token
        s.error = parsed.error
        return s
    }
    if s.token.kind == as_u32(39) {
        if seq.len(s.types.records) == type_limit { s.error = ast.failed(lexer.next(source, s.token.end), 7) return s }
        let parsed = struct_parse.parse(source, s.token, s.types, public, cap)
        s.types = parsed.scope
        s.token = parsed.token
        s.error = parsed.error
        return s
    }
    if (s.token.kind == as_u32(11)) == false { s.error = expected(s.token) return s }
    if s.metadata.intrinsic {
        if intrinsic_abi.allowed_owner(s.types.owner) == false {
            s.error = syntax.error(5, s.metadata.start, s.metadata.end) return s
        }
        if s.metadata.identity == intrinsic_abi.NONE {
            s.error = syntax.error(6, s.metadata.start, s.metadata.end) return s
        }
    }
    if seq.len(s.functions) == cap { s.error = syntax.error(7, s.token.start, s.token.end) return s }
    let name = lexer.next(source, s.token.end)
    if (name.kind == as_u32(1)) == false { s.error = expected(name) return s }
    s.token = lexer.next(source, name.end)
    if syntax.both(s.metadata.intrinsic, s.token.kind == as_u32(29)) {
        s.error = syntax.error(6, s.metadata.start, s.metadata.end) return s
    }
    if (s.token.kind == as_u32(5)) == false { s.error = expected(s.token) return s }
    s.current = signatures.Function { name, params: seq.len(s.params), count: syntax.ZERO, returns: noun.atom(types.UNIT), open: syntax.ZERO, close: syntax.ZERO }
    s.metadata.exported = public
    s.phase = 1
    s.token = lexer.next(source, s.token.end)
    s
}

#[pure]
fn chunk(source: bytes.Bytes, input: header_state.State, cap: U32, type_limit: U32) -> header_state.State {
    let mut s = input
    for turn in 0..16 {
        s = step(source, s, cap, type_limit)
        if syntax.either(s.done, (s.error.code == syntax.ZERO) == false) { return s }
    }
    s
}

// Braces are tokens; braces inside comments never delimit bodies.
#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
#[requires((syntax.TABLE_CAP < cap) == false)]
pub fn parse(source: bytes.Bytes, start: U32, owner: bytes.Bytes, cap: U32) -> header_state.State {
    parse_imports(source, start, owner, constant_imports.empty(), cap)
}

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
#[requires((syntax.TABLE_CAP < cap) == false)]
pub fn parse_imports(source: bytes.Bytes, start: U32, owner: bytes.Bytes, imports: constant_imports.View, cap: U32) -> header_state.State {
    validate_entry(scan_module(source, start, owner, imports, type_imports.empty(), syntax.ZERO, seq.empty(), seq.empty(), cap))
}

// Shared tables retain prior owners' declarations. This scan records only the
// current owner's entry/purity/visibility and resolves all of its constants.
// Dependency Unit returns use the ordinary omitted return annotation.
#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
#[requires((syntax.TABLE_CAP < cap) == false)]
#[requires((cap < seq.len(functions)) == false)]
#[requires((cap < seq.len(params)) == false)]
#[requires((cap < type_start) == false)]
#[ensures((cap < seq.len(result.functions)) == false)]
#[ensures((cap < seq.len(result.params)) == false)]
#[ensures((cap < seq.len(result.public_functions)) == false)]
pub fn scan_module(source: bytes.Bytes, start: U32, owner: bytes.Bytes, imports: constant_imports.View,
    imported_types: type_imports.View, type_start: U32, functions: seq.Seq, params: seq.Seq, cap: U32) -> header_state.State {
    scan_with_intrinsics(source, start, owner, imports, imported_types, type_start,
        functions, params, cap, intrinsic_bindings.empty())
}

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
#[requires((syntax.TABLE_CAP < cap) == false)]
#[requires((cap < seq.len(functions)) == false)]
#[requires((cap < seq.len(params)) == false)]
#[requires((cap < type_start) == false)]
pub fn scan_with_intrinsics(source: bytes.Bytes, start: U32, owner: bytes.Bytes, imports: constant_imports.View,
    imported_types: type_imports.View, type_start: U32, functions: seq.Seq, params: seq.Seq, cap: U32,
    intrinsics: intrinsic_bindings.Bank) -> header_state.State {
    let mut s = header_state.initial(lexer.next(source, start))
    s.intrinsics = intrinsics
    s.functions = functions
    s.params = params
    s.types.owner = owner
    s.types.imports = imported_types
    assert((cap < type_start) == false)
    let type_limit = as_u32(field.sub(as_field(cap), as_field(type_start)))
    s.constants.imports = imports
    for turn in 0..512 {
        s = chunk(source, s, cap, type_limit)
        if (s.error.code == syntax.ZERO) == false { return s }
        if s.done {
            let resolved = constants.resolve(source, s.constants)
            s.constants = resolved.scope
            s.error = resolved.error
            return s
        }
    }
    s.error = syntax.error(7, s.token.start, s.token.end)
    s
}

// The entry check runs after a successful module scan, never for dependencies.
#[pure]
#[requires(syntax.either(input.entry == signatures.NONE, input.entry < seq.len(input.functions)))]
#[ensures(seq.len(result.functions) == seq.len(input.functions))]
#[ensures(seq.len(result.params) == seq.len(input.params))]
pub fn validate_entry(input: header_state.State) -> header_state.State {
    let mut s = input
    if (s.error.code == syntax.ZERO) == false { return s }
    if s.entry == signatures.NONE { s.error = syntax.error(3, s.token.start, s.token.end) return s }
    let entry = signatures.read(seq.get(s.functions, s.entry))
    if (intrinsic_bindings.kind(s.intrinsics, s.entry) == intrinsic_abi.NONE) == false {
        s.error = syntax.error(6, entry.name.start, entry.name.end) return s
    }
    if syntax.both(entry.count == syntax.ZERO, noun.eq(entry.returns, noun.atom(types.FIELD))) { return s }
    if syntax.both(entry.count == as_u32(1), noun.eq(entry.returns, noun.atom(types.NOUN))) {
        let parameter = seq.get(s.params, entry.params)
        if noun.eq(noun.tail(noun.tail(parameter)), noun.atom(types.NOUN)) { s.structured = true return s }
    }
    s.error = syntax.error(3, entry.name.start, entry.name.end)
    s
}

// The header has already passed the ordinary scalar/structured entry check.
// Compiler-profile output must preserve the entire JOB1 subject and RES1 value.
#[pure]
#[requires(syntax.either(profile == 0, profile == 1))]
pub fn require_profile(input: header_state.State, profile: Field) -> header_state.State {
    let mut s = input
    if (s.error.code == syntax.ZERO) == false { return s }
    if syntax.both(profile == 1, s.structured == false) {
        let entry = signatures.read(seq.get(s.functions, s.entry))
        s.error = syntax.error(3, entry.name.start, entry.name.end)
    }
    s
}
