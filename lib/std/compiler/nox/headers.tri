module std.compiler.nox.headers

use std.compiler.nox.const_parse
use std.compiler.nox.constants
use vm.core.convert
use vm.nox.noun
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.lexer
use std.compiler.nox.symbols
use std.compiler.nox.signatures
use std.compiler.nox.header_state
use std.compiler.nox.types
use std.compiler.nox.struct_parse
use std.compiler.nox.type_parse

#[pure]
fn expected(token: syntax.Token) -> syntax.Error {
    if token.kind == as_u32(14) { return syntax.error(1, token.start, token.end) }
    if token.kind == as_u32(13) { return syntax.error(6, token.start, token.end) }
    syntax.error(2, token.start, token.end)
}

#[pure]
pub fn scalar(token: syntax.Token) -> Field { type_parse.scalar(token) }

#[pure]
fn open(source: bytes.Bytes, input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    // Called at the closing parameter parenthesis, with an optional annotation.
    s.token = lexer.next(source, s.token.end)
    if s.token.kind == as_u32(9) {
        s.token = lexer.next(source, s.token.end)
        let parsed = type_parse.parse(source, s.token, s.types, cap)
        s.error = parsed.error
        if (s.error.code == syntax.ZERO) == false { return s }
        s.current.returns = parsed.ty
        s.token = parsed.token
    }
    if (s.token.kind == as_u32(7)) == false { s.error = expected(s.token) return s }
    s.current.open = s.token.end
    s.phase = 2
    s.nesting = as_u32(1)
    s.token = lexer.next(source, s.token.end)
    s
}

#[pure]
fn parameter(source: bytes.Bytes, input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    if s.token.kind == as_u32(6) { return open(source, s, cap) }
    let name = s.token
    if (name.kind == as_u32(1)) == false { s.error = expected(name) return s }
    s.token = lexer.next(source, name.end)
    if (s.token.kind == as_u32(17)) == false { s.error = expected(s.token) return s }
    s.token = lexer.next(source, s.token.end)
    let parsed = type_parse.parse(source, s.token, s.types, cap)
    s.error = parsed.error
    if (s.error.code == syntax.ZERO) == false { return s }
    if seq.len(s.params) == cap { s.error = syntax.error(7, name.start, name.end) return s }
    s.params = seq.push(s.params, symbols.binding(name, false, parsed.ty), cap)
    s.current.count = syntax.inc(s.current.count)
    s.token = parsed.token
    if s.token.kind == as_u32(6) { return open(source, s, cap) }
    if (s.token.kind == as_u32(26)) == false { s.error = expected(s.token) return s }
    s.token = lexer.next(source, s.token.end)
    s
}

#[pure]
fn step(source: bytes.Bytes, input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    if s.phase == 1 { return parameter(source, s, cap) }
    if s.phase == 2 {
        if s.token.kind == syntax.ZERO { s.error = expected(s.token) return s }
        if s.token.kind == as_u32(14) { s.error = ast.failed(s.token, 1) return s }
        if s.token.kind == as_u32(7) { s.nesting = syntax.inc(s.nesting) }
        if s.token.kind == as_u32(8) {
            s.nesting = syntax.dec(s.nesting)
            if s.nesting == syntax.ZERO {
                // Function count is checked before its header/body scan begins.
                if s.current.name.value == 1835100526 { s.entry = seq.len(s.functions) }
                s.current.close = s.token.end
                s.functions = seq.push(s.functions, signatures.pack(s.current), cap)
                s.phase = 0
            }
        }
        s.token = lexer.next(source, s.token.end)
        return s
    }
    if s.token.kind == syntax.ZERO { s.done = true return s }
    let mut public = false
    if s.token.kind == as_u32(40) { public = true s.token = lexer.next(source, s.token.end) }
    if s.token.kind == as_u32(45) {
        s.constants.owner = s.types.owner
        let parsed = const_parse.parse(source, s.token, s.constants, public, cap)
        s.constants = parsed.scope
        s.token = parsed.token
        s.error = parsed.error
        return s
    }
    if s.token.kind == as_u32(39) {
        let parsed = struct_parse.parse(source, s.token, s.types, public, cap)
        s.types = parsed.scope
        s.token = parsed.token
        s.error = parsed.error
        return s
    }
    if (s.token.kind == as_u32(11)) == false { s.error = expected(s.token) return s }
    if seq.len(s.functions) == cap { s.error = syntax.error(7, s.token.start, s.token.end) return s }
    let name = lexer.next(source, s.token.end)
    if (name.kind == as_u32(1)) == false { s.error = expected(name) return s }
    s.token = lexer.next(source, name.end)
    if (s.token.kind == as_u32(5)) == false { s.error = expected(s.token) return s }
    s.current = signatures.Function { name, params: seq.len(s.params), count: syntax.ZERO, returns: noun.atom(types.UNIT), open: syntax.ZERO, close: syntax.ZERO }
    s.phase = 1
    s.token = lexer.next(source, s.token.end)
    s
}

#[pure]
fn chunk(source: bytes.Bytes, input: header_state.State, cap: U32) -> header_state.State {
    let mut s = input
    for turn in 0..16 {
        s = step(source, s, cap)
        if syntax.either(s.done, (s.error.code == syntax.ZERO) == false) { return s }
    }
    s
}

// Braces are tokens; braces inside comments never delimit bodies.
#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
#[requires((syntax.SOURCE_CAP < cap) == false)]
pub fn parse(source: bytes.Bytes, start: U32, owner: bytes.Bytes, cap: U32) -> header_state.State {
    let mut s = header_state.initial(lexer.next(source, start))
    s.types.owner = owner
    for turn in 0..512 {
        s = chunk(source, s, cap)
        if (s.error.code == syntax.ZERO) == false { return s }
        if s.done {
            let resolved = constants.resolve(source, s.constants)
            s.constants = resolved.scope
            s.error = resolved.error
            if (s.error.code == syntax.ZERO) == false { return s }
            if s.entry == signatures.NONE { s.error = syntax.error(3, s.token.start, s.token.end) return s }
            let entry = signatures.read(seq.get(s.functions, s.entry))
            if syntax.both(entry.count == syntax.ZERO, noun.eq(entry.returns, noun.atom(types.FIELD))) { return s }
            if syntax.both(entry.count == as_u32(1), noun.eq(entry.returns, noun.atom(types.NOUN))) {
                let parameter = seq.get(s.params, entry.params)
                if noun.eq(noun.tail(noun.tail(parameter)), noun.atom(types.NOUN)) { s.structured = true return s }
            }
            s.error = syntax.error(3, entry.name.start, entry.name.end)
            return s
        }
    }
    s.error = syntax.error(7, s.token.start, s.token.end)
    s
}
