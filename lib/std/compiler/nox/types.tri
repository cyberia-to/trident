module std.compiler.nox.types

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.compiler.nox.syntax

pub const FIELD: Field = 0
pub const BOOL: Field = 1
pub const UNIT: Field = 2
pub const UINT32: Field = 3
pub const NOUN: Field = 4
pub const INVALID: Field = 5
pub const DIGEST: Field = 6
pub const TUPLE: Field = 16
pub const NOMINAL: Field = 17
pub const ARRAY: Field = 18
pub const MAX_ARITY: U32 = 16

pub struct Info { pub depth: U32, pub nodes: U32, pub contains_noun: Bool, pub valid: Bool }
pub struct Built { pub ty: Noun, pub failed: Bool }

// Descriptors are compiler-owned canonical values. Primitive types are atoms;
// tuple: [16 [children-Seq [logical-depth [logical-nodes contains-Noun-flag]]]].
// nominal.tri uses tag17 with the same metadata envelope and owned record identity.
// Accessors consume known primitive tags or descriptors from these constructors.
// Only constructors derive metadata. Source data never supplies descriptors.
#[pure]
pub fn info(ty: Noun) -> Info {
    for tag in 0..7 {
        if noun.eq(ty, noun.atom(as_field(tag))) {
            return Info { depth: syntax.ZERO, nodes: as_u32(1), contains_noun: as_field(tag) == NOUN, valid: (as_field(tag) == INVALID) == false }
        }
    }
    let metadata = noun.tail(noun.tail(ty))
    let extent = noun.tail(metadata)
    let kind = noun.as_field(noun.head(ty))
    Info { depth: as_u32(noun.as_field(noun.head(metadata))),
        nodes: as_u32(noun.as_field(noun.head(extent))),
        contains_noun: noun.as_field(noun.tail(extent)) == 1,
        valid: syntax.either(kind == ARRAY, syntax.either(kind == TUPLE, kind == NOMINAL)) }
}

#[pure]
pub fn contains_noun(ty: Noun) -> Bool { info(ty).contains_noun }

// Count logical type occurrences, including repeated children; sharing in the
// canonical DAG does not evade source complexity or nesting allowances.
#[pure]
#[requires((syntax.SOURCE_CAP < node_cap) == false)]
#[requires((syntax.STACK_CAP < depth_cap) == false)]
pub fn tuple(children: seq.Seq, node_cap: U32, depth_cap: U32) -> Built {
    let failure = Built { ty: noun.atom(INVALID), failed: true }
    let count = seq.len(children)
    if syntax.either(count == syntax.ZERO, MAX_ARITY < count) { return failure }
    let mut depth = syntax.ZERO
    let mut nodes: Field = 1
    let mut flag: Field = 0
    for id in 0..16 {
        if id < count {
            let child = info(seq.get(children, id))
            if child.valid == false { return failure }
            nodes = nodes + as_field(child.nodes)
            if node_cap < as_u32(nodes) { return failure }
            if depth < child.depth { depth = child.depth }
            if child.contains_noun { flag = 1 }
        }
    }
    depth = syntax.inc(depth)
    if depth_cap < depth { return failure }
    let metadata = noun.pair(noun.atom(as_field(depth)), noun.pair(noun.atom(nodes), noun.atom(flag)))
    Built { ty: noun.pair(noun.atom(TUPLE), noun.pair(seq.to_noun(children), metadata)), failed: false }
}


pub struct Parts { pub children: seq.Seq, pub count: U32, pub digest: Bool, pub valid: Bool }

// Known descriptors only. Decode the owned child sequence once per pattern.
#[pure]
pub fn parts(ty: Noun) -> Parts {
    let mut result = Parts { children: seq.empty(), count: syntax.ZERO, digest: false, valid: false }
    if noun.eq(ty, noun.atom(DIGEST)) {
        result.digest = true
        result.valid = true
        result.count = as_u32(4)
        return result
    }
    if info(ty).depth == syntax.ZERO { return result }
    if (noun.as_field(noun.head(ty)) == TUPLE) == false { return result }
    result.children = seq.from_noun(noun.head(noun.tail(ty)), MAX_ARITY, as_u32(31))
    result.count = seq.len(result.children)
    result.valid = true
    result
}

// Digest limbs have a fixed primitive type; they need no synthesized collection.
#[pure]
#[requires(index < parts.count)]
pub fn component(parts: Parts, index: U32) -> Noun {
    if parts.digest { return noun.atom(FIELD) }
    seq.get(parts.children, index)
}

// Fixed Field arrays use [18 [[element length] metadata]]. Logical occurrence
// count includes every element, even when their canonical type value is shared.
#[pure]
#[requires((syntax.SOURCE_CAP < node_cap) == false)]
#[requires((syntax.STACK_CAP < depth_cap) == false)]
pub fn array(length: U32, node_cap: U32, depth_cap: U32) -> Built {
    if syntax.either(depth_cap == syntax.ZERO, (length < node_cap) == false) {
        return Built { ty: noun.atom(INVALID), failed: true }
    }
    let data = noun.pair(noun.atom(FIELD), noun.atom(as_field(length)))
    let metadata = noun.pair(noun.atom(1), noun.pair(noun.atom(as_field(length) + 1), noun.atom(0)))
    Built { ty: noun.pair(noun.atom(ARRAY), noun.pair(data, metadata)), failed: false }
}

pub struct Array { pub length: U32, pub valid: Bool }

#[pure]
pub fn array_info(ty: Noun) -> Array {
    let absent = Array { length: syntax.ZERO, valid: false }
    if info(ty).depth == syntax.ZERO { return absent }
    if (noun.as_field(noun.head(ty)) == ARRAY) == false { return absent }
    Array { length: as_u32(noun.as_field(noun.tail(noun.head(noun.tail(ty))))), valid: true }
}
