module std.compiler.nox.body

use std.compiler.nox.constants
use std.compiler.nox.check_scope
use std.compiler.nox.function_imports
use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.type_registry
use std.compiler.nox.syntax
use std.compiler.nox.lexer
use std.compiler.nox.ast
use std.compiler.nox.expression
use std.compiler.nox.expression_state
use std.compiler.nox.blocks
use std.compiler.nox.body_state
use std.compiler.nox.declarations
use std.compiler.nox.control_parse
use std.compiler.nox.signatures
use std.compiler.nox.loop_parse
use std.compiler.nox.types
use std.compiler.nox.tuple_declarations
use std.compiler.nox.record_assign
use std.compiler.nox.halting

#[pure]
fn step(source: bytes.Bytes, input: body_state.State, cap: U32) -> body_state.State {
    let mut s = input
    // An else-if owns a synthetic block containing exactly the completed If.
    if syntax.both(s.synthetic, noun.eq(s.current, noun.atom(0)) == false) {
        return control_parse.close(source, s, cap, false)
    }
    if s.token.kind == as_u32(8) { return control_parse.close(source, s, cap, true) }
    if s.returned { s.error = syntax.error(5, s.token.start, s.token.end) return s }
    if s.token.kind == as_u32(15) { return declarations.parse(source, s, cap, s.token) }
    if s.token.kind == as_u32(1) {
        let next = lexer.next(source, s.token.end)
        if next.kind == as_u32(18) { return declarations.parse(source, s, cap, next) }
    }
    if s.token.kind == as_u32(23) { return control_parse.enter(source, s, cap) }
    if s.token.kind == as_u32(31) { return loop_parse.enter(source, s, cap) }
    let returning = s.token.kind == as_u32(25)
    if returning {
        s.token = lexer.next(source, s.token.end)
        if s.token.kind == as_u32(8) {
            if (noun.eq(s.returns, noun.atom(types.UNIT))) == false { s.error = syntax.error(5, s.token.start, s.token.end) return s }
            if seq.len(s.nodes) == cap { s.error = syntax.error(7, s.token.start, s.token.end) return s }
            let id = seq.len(s.nodes)
            s.nodes = seq.push(s.nodes, ast.typed(ast.UNIT_VALUE, 0, 0, noun.atom(types.UNIT), s.token.start, s.token.start), cap)
            s = body_state.append(s, blocks.statement(blocks.RETURN, id, syntax.ZERO, syntax.ZERO), cap)
            s.returned = true
            return s
        }
    }
    let value = expression.parse(source, s.token, expression_state.context(s.bindings, s.visible, s.scope), s.nodes, s.arguments, s.edges, cap, false)
    s.error = value.error
    if (s.error.code == syntax.ZERO) == false { return s }
    s.nodes = value.nodes
    s.arguments = value.arguments
    s.edges = value.edges
    if value.needs_get { s.needs_get = true }
    s.token = value.token
    if returning {
        let node = seq.get(s.nodes, value.value)
        if (noun.eq(ast.ty(node), s.returns)) == false {
            if halting.is_false_assert(node, s.nodes, s.arguments) == false { s.error = ast.issue(5, node) return s }
        }
        s = body_state.append(s, blocks.statement(blocks.RETURN, value.value, syntax.ZERO, syntax.ZERO), cap)
        s.returned = true
        return s
    }
    if s.token.kind == as_u32(18) {
        if ast.kind(seq.get(s.nodes, value.value)) == ast.PROJECT { return record_assign.assign(source, s, value.value, cap) }
        return tuple_declarations.assign(source, s, value.value, cap)
    }
    if s.token.kind == as_u32(8) {
        s.has_tail = true
        s.tail = value.value
        return control_parse.close(source, s, cap, true)
    }
    s.returned = halting.is_false_assert(seq.get(s.nodes, value.value), s.nodes, s.arguments)
    body_state.append(s, blocks.statement(blocks.EVAL, value.value, syntax.ZERO, syntax.ZERO), cap)
}

#[pure]
fn chunk(source: bytes.Bytes, input: body_state.State, cap: U32) -> body_state.State {
    let mut s = input
    for turn in 0..8 {
        s = step(source, s, cap)
        if syntax.either(s.done, (s.error.code == syntax.ZERO) == false) { return s }
    }
    s
}

#[pure]
fn drive(source: bytes.Bytes, input: body_state.State, cap: U32) -> body_state.State {
    let mut s = input
    if cap == syntax.ZERO { s.error = syntax.error(7, s.token.start, s.token.end) return s }
    for turn in 0..512 {
        s = chunk(source, s, cap)
        if syntax.either(s.done, (s.error.code == syntax.ZERO) == false) { return s }
    }
    s.error = syntax.error(7, s.token.start, s.token.end)
    s
}

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn parse(source: bytes.Bytes, start: U32, cap: U32) -> body_state.State {
    let mut s = body_state.initial(lexer.next(source, start))
    s.start = syntax.dec(start)
    s = drive(source, s, cap)
    if syntax.both(s.error.code == syntax.ZERO, (s.token.kind == syntax.ZERO) == false) { s.error = ast.failed(s.token, 2) }
    s
}

struct Parameters { body: body_state.State, next: U32 }

#[pure]
fn parameter_chunk(input: Parameters, signature: signatures.Function, cap: U32) -> Parameters {
    let mut s = input
    for turn in 0..8 {
        if s.next == signature.count { return s }
        if seq.len(s.body.bindings) == cap { s.body.error = syntax.error(7, signature.name.start, signature.name.end) return s }
        let binding = seq.get(s.body.scope.params, as_u32(as_field(signature.params) + as_field(s.next)))
        s.body.bindings = seq.push(s.body.bindings, binding, cap)
        s.body.visible = noun.pair(noun.atom(as_field(s.next)), s.body.visible)
        s.next = syntax.inc(s.next)
    }
    s
}

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn function(source: bytes.Bytes, signature: signatures.Function, functions: seq.Seq, params: seq.Seq, scope: type_registry.Scope, consts: constants.Scope, pure: Bool, cap: U32) -> body_state.State {
    function_in(source, signature, functions, params, scope, consts, pure, cap,
        syntax.ZERO, seq.len(functions), function_imports.empty())
}

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
#[requires((end < start) == false)]
#[requires((seq.len(functions) < end) == false)]
pub fn function_in(source: bytes.Bytes, signature: signatures.Function, functions: seq.Seq, params: seq.Seq, scope: type_registry.Scope, consts: constants.Scope, pure: Bool, cap: U32, start: U32, end: U32, imports: function_imports.View) -> body_state.State {
    let context = check_scope.Scope { pure, types: scope, functions, params, constants: consts,
        function_start: start, function_end: end, imported_functions: imports }
    let initial = body_state.scoped(lexer.next(source, signature.open), syntax.dec(signature.open), signature.returns, context)
    let mut s = Parameters { body: initial, next: syntax.ZERO }
    for turn in 0..512 {
        s = parameter_chunk(s, signature, cap)
        if (s.body.error.code == syntax.ZERO) == false { return s.body }
        if s.next == signature.count {
            s.body = drive(source, s.body, cap)
            if syntax.both(s.body.error.code == syntax.ZERO, (s.body.end == signature.close) == false) {
                s.body.error = syntax.error(2, s.body.start, s.body.end)
            }
            return s.body
        }
    }
    s.body.error = syntax.error(7, signature.name.start, signature.name.end)
    s.body
}
