module std.compiler.nox.signatures

use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.nox.bytes
use std.compiler.nox.syntax
use std.compiler.nox.symbols
use std.compiler.nox.types

pub const NONE: U32 = 4096
pub struct Function {
    pub name: syntax.Token, pub params: U32, pub count: U32,
    pub returns: Noun, pub open: U32, pub close: U32
}

// Parameter ranges are allocated by a flat header pass; nested call arguments
// use a separate ownership structure and never borrow these ranges.
#[pure]
pub fn pack(f: Function) -> Noun {
    let name = noun.pair(noun.atom(as_field(f.name.start)), noun.atom(as_field(f.name.end)))
    let params = noun.pair(noun.atom(as_field(f.params)), noun.atom(as_field(f.count)))
    let body = noun.pair(noun.atom(as_field(f.open)), noun.atom(as_field(f.close)))
    return noun.pair(name, noun.pair(params, noun.pair(f.returns, body)))
}

#[pure]
pub fn read(value: Noun) -> Function {
    let name = noun.head(value)
    let info = noun.tail(value)
    let params = noun.head(info)
    let result = noun.tail(info)
    let body = noun.tail(result)
    Function { name: syntax.token(1, as_u32(noun.as_field(noun.head(name))), as_u32(noun.as_field(noun.tail(name))), 0),
        params: as_u32(noun.as_field(noun.head(params))), count: as_u32(noun.as_field(noun.tail(params))),
        returns: noun.head(result), open: as_u32(noun.as_field(noun.head(body))),
        close: as_u32(noun.as_field(noun.tail(body))) }
}

struct Search { remaining: U32, found: U32 }

#[pure]
fn chunk(source: bytes.Bytes, name: syntax.Token, functions: seq.Seq, input: Search) -> Search {
    let mut s = input
    for turn in 0..8 {
        if s.remaining == as_u32(0) { return s }
        s.remaining = syntax.dec(s.remaining)
        let candidate = read(seq.get(functions, s.remaining))
        if symbols.same(source, name, symbols.binding(candidate.name, false, noun.atom(types.FIELD))) {
            s.found = s.remaining
            return s
        }
    }
    s
}

// Final callable bindings are independent of the current lexical local scope.
#[pure]
#[requires((syntax.SOURCE_CAP < seq.len(functions)) == false)]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn lookup(source: bytes.Bytes, name: syntax.Token, functions: seq.Seq) -> U32 {
    let mut s = Search { remaining: seq.len(functions), found: NONE }
    for turn in 0..512 {
        s = chunk(source, name, functions, s)
        if syntax.either((s.found == NONE) == false, s.remaining == as_u32(0)) { return s.found }
    }
    NONE
}
