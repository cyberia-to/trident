module std.compiler.nox.builtin_gen

use std.compiler.nox.syntax
use vm.nox.noun
use vm.core.convert
use std.nox.seq
use std.compiler.nox.builtins
use std.compiler.nox.formula
use std.compiler.nox.flow

#[pure]
fn binary(opcode: Field, left: formula.Value, right: formula.Value) -> formula.Value {
    formula.Value { formula: noun.pair(noun.atom(opcode), noun.pair(left.formula, right.formula)),
        depth: as_u32(as_field(formula.maximum(left.depth, right.depth)) + 2) }
}

// The checker owns arity and linked arguments. Links are reversed; a binary
// builtin reconstructs left/right explicitly to preserve evaluation order.
#[pure]
#[requires(syntax.ZERO < kind)]
#[requires(kind < builtins.COUNT)]
#[requires(head < seq.len(arguments))]
pub fn generate(kind: U32, values: seq.Seq, arguments: seq.Seq, head: U32) -> formula.Value {
    let link = seq.get(arguments, head)
    let right = formula.value(values, as_u32(noun.as_field(noun.head(link))))
    if builtins.arity(kind) == as_u32(2) {
        let first = seq.get(arguments, as_u32(noun.as_field(noun.tail(link))))
        let left = formula.value(values, as_u32(noun.as_field(noun.head(first))))
        if kind == builtins.NOUN_PAIR { return formula.pair(left, right) }
        if kind == builtins.NOUN_EQ { return binary(9, left, right) }
        return binary(6, left, right)
    }
    if kind == builtins.NOUN_IDENTITY { return flow.compose(right, flow.axis(0)) }
    if kind == builtins.NOUN_HEAD { return flow.compose(right, flow.axis(2)) }
    if kind == builtins.NOUN_TAIL { return flow.compose(right, flow.axis(3)) }
    if kind == builtins.NOUN_FIELD { return binary(5, right, flow.literal(0)) }
    if kind == builtins.NOUN_ATOM { return right }
    if kind == builtins.TO_FIELD { return right }
    let crash = formula.Value { formula: noun.pair(noun.atom(8), flow.literal(0).formula), depth: as_u32(2) }
    let condition = binary(10, flow.axis(1), flow.literal(4294967296))
    flow.compose(right, flow.branch(condition, flow.axis(1), crash))
}
