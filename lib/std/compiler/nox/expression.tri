module std.compiler.nox.expression

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.lexer
use std.compiler.nox.ast
use std.compiler.nox.ascii
use std.compiler.nox.symbols
use std.compiler.nox.expression_state
use std.compiler.nox.call_parse
use std.compiler.nox.types
use std.compiler.nox.index_parse

#[pure]
fn operator(s: expression_state.State) -> U32 {
    as_u32(noun.as_field(seq.get(s.operators, syntax.dec(s.ops))))
}

#[pure]
fn precedence(kind: U32) -> U32 {
    if kind == as_u32(30) { return as_u32(5) }
    if kind == as_u32(4) { return as_u32(4) }
    if kind == as_u32(3) { return as_u32(3) }
    if kind == as_u32(29) { return as_u32(2) }
    if kind == as_u32(19) { return as_u32(1) }
    as_u32(0)
}

#[pure]
fn reduce(input: expression_state.State) -> expression_state.State {
    let mut s = input
    if s.vals < as_u32(2) {
        s.error = ast.failed(s.token, 2)
        return s
    }
    let right = seq.get(s.values, syntax.dec(s.vals))
    let left = seq.get(s.values, syntax.dec(syntax.dec(s.vals)))
    if seq.len(s.nodes) == s.node_cap {
        s.error = syntax.error(7, s.token.start, s.token.end)
        return s
    }
    let lhs = seq.get(s.nodes, as_u32(noun.as_field(left)))
    let rhs = seq.get(s.nodes, as_u32(noun.as_field(right)))
    let op = operator(s)
    let mut kind = ast.ADD
    let mut ty = noun.atom(types.FIELD)
    if op == as_u32(4) { kind = ast.MUL }
    if op == as_u32(19) { kind = ast.EQUAL ty = noun.atom(types.BOOL) }
    let mut required = types.FIELD
    if op == as_u32(29) { kind = ast.LESS ty = noun.atom(types.BOOL) required = types.UINT32 }
    if op == as_u32(30) { kind = ast.BIT_AND ty = noun.atom(types.UINT32) required = types.UINT32 }
    if syntax.either((noun.eq(ast.ty(lhs), ast.ty(rhs))) == false,
        syntax.both((kind == ast.EQUAL) == false, (noun.eq(ast.ty(lhs), noun.atom(required))) == false)) {
        s.error = syntax.error(5, ast.start(lhs), ast.end(rhs))
        return s
    }
    if kind == ast.EQUAL {
        if types.contains_noun(ast.ty(lhs)) {
            s.error = syntax.error(5, ast.start(lhs), ast.end(rhs))
            return s
        }
    }
    let id = noun.atom(as_field(seq.len(s.nodes)))
    let node = ast.typed(kind, noun.as_field(left), noun.as_field(right), ty, ast.start(lhs), ast.end(rhs))
    s.nodes = seq.push(s.nodes, node, s.node_cap)
    s.vals = syntax.dec(s.vals)
    s.values = seq.set(s.values, syntax.dec(s.vals), id)
    s.ops = syntax.dec(s.ops)
    s
}

#[pure]
fn push_operator(input: expression_state.State) -> expression_state.State {
    let mut s = input
    if s.ops == s.capacity {
        s.error = syntax.error(7, s.token.start, s.token.end)
        return s
    }
    s.operators = ast.store(s.operators, s.ops, noun.atom(as_field(s.token.kind)), s.capacity)
    s.ops = syntax.inc(s.ops)
    s
}

#[pure]
fn boundary(kind: U32, before_block: Bool) -> Bool {
    if kind == as_u32(31) { return true }
    if syntax.either(syntax.either(kind == as_u32(8), kind == as_u32(15)), kind == as_u32(1)) { return true }
    if syntax.either(syntax.either(kind == as_u32(2), kind == as_u32(5)), kind == as_u32(25)) { return true }
    if syntax.either(syntax.either(kind == as_u32(21), kind == as_u32(22)), kind == as_u32(23)) { return true }
    syntax.both(before_block, kind == as_u32(7))
}

#[pure]
fn step(source: bytes.Bytes, input: expression_state.State) -> expression_state.State {
    let mut s = input
    let kind = s.token.kind
    if kind == as_u32(37) {
        if syntax.either(s.ops == as_u32(0), s.operand) { s.error = ast.failed(s.token, 2) return s }
        let top = operator(s)
        if top == as_u32(36) { return index_parse.finish(source, s) }
        if syntax.either(top == as_u32(5), top == expression_state.CALL_MARKER) { s.error = ast.failed(s.token, 2) return s }
        return reduce(s)
    }
    if syntax.either(kind == as_u32(6), kind == as_u32(26)) {
        if (s.ops == as_u32(0)) == false {
            let top = operator(s)
            if top == as_u32(36) { s.error = ast.failed(s.token, 2) return s }
            if top == expression_state.CALL_MARKER { return call_parse.finish(source, s, kind == as_u32(6)) }
            if syntax.both(s.operand == false, (top == as_u32(5)) == false) { return reduce(s) }
        }
        if syntax.either(s.operand, kind == as_u32(26)) {
            s.error = syntax.error(2, s.token.start, s.token.end)
            return s
        }
    }
    if s.operand {
        if syntax.either(syntax.either(kind == as_u32(2), kind == as_u32(1)), syntax.either(kind == as_u32(21), kind == as_u32(22))) {
            if syntax.either(s.vals == s.capacity, seq.len(s.nodes) == s.node_cap) {
                s.error = syntax.error(7, s.token.start, s.token.end)
                return s
            }
            let mut node = ast.typed(ast.LITERAL, s.token.value, 0, noun.atom(types.FIELD), s.token.start, s.token.end)
            if syntax.either(kind == as_u32(21), kind == as_u32(22)) {
                let mut value: Field = 0
                if kind == as_u32(22) { value = 1 }
                node = ast.typed(ast.BOOLEAN, value, 0, noun.atom(types.BOOL), s.token.start, s.token.end)
            }
            if kind == as_u32(1) {
                let following = lexer.next(source, s.token.end)
                if syntax.both(following.kind == as_u32(7), s.before_block == false) {
                    s.error = syntax.error(6, s.token.start, following.end)
                    return s
                }
                if following.kind == as_u32(5) {
                    if ascii.same_line(source, s.token.end, following.start) {
                        return call_parse.enter(source, following, s)
                    }
                }
                let binding = symbols.lookup(source, s.token, s.context.bindings, s.context.visible)
                if binding.exists == false {
                    s.error = syntax.error(5, s.token.start, s.token.end)
                    return s
                }
                node = ast.typed(ast.LOCAL, as_field(binding.slot), 0, binding.ty, s.token.start, s.token.end)
            }
            let id = noun.atom(as_field(seq.len(s.nodes)))
            s.nodes = seq.push(s.nodes, node, s.node_cap)
            s.values = ast.store(s.values, s.vals, id, s.capacity)
            s.vals = syntax.inc(s.vals)
            s.operand = false
        } else if kind == as_u32(5) { s = push_operator(s) }
        else if kind == as_u32(36) { s.error = syntax.error(6, s.token.start, s.token.end) return s }
        else {
            s.error = ast.failed(s.token, 2)
            return s
        }
    } else if kind == as_u32(36) { return index_parse.enter(source, s) }
    else if as_u32(0) < precedence(kind) {
        if (s.ops == as_u32(0)) == false {
            let top = operator(s)
            if syntax.both((top == as_u32(5)) == false, (precedence(top) < precedence(kind)) == false) { return reduce(s) }
        }
        s = push_operator(s)
        s.operand = true
    } else if kind == as_u32(6) {
        if s.ops == as_u32(0) {
            s.error = ast.failed(s.token, 2)
            return s
        }
        if (operator(s) == as_u32(5)) == false { return reduce(s) }
        s.ops = syntax.dec(s.ops)
    } else if boundary(kind, s.before_block) {
        if (s.ops == as_u32(0)) == false {
            if syntax.either(operator(s) == as_u32(36), syntax.either(operator(s) == as_u32(5), operator(s) == expression_state.CALL_MARKER)) {
                s.error = ast.failed(s.token, 2)
                return s
            }
            return reduce(s)
        }
        s.done = true
        return s
    } else {
        s.error = ast.failed(s.token, 2)
        return s
    }
    if s.error.code == as_u32(0) { s.token = lexer.next(source, s.token.end) }
    s
}

#[pure]
fn chunk(source: bytes.Bytes, input: expression_state.State) -> expression_state.State {
    let mut s = input
    for turn in 0..32 {
        s = step(source, s)
        if syntax.either(s.done, (s.error.code == as_u32(0)) == false) { return s }
    }
    s
}

#[pure]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn parse(source: bytes.Bytes, token: syntax.Token, context: expression_state.Context, nodes: seq.Seq, arguments: seq.Seq, edges: Noun, cap: U32, before_block: Bool) -> expression_state.Parsed {
    let zero = as_u32(0)
    let mut capacity = cap
    if syntax.STACK_CAP < capacity { capacity = syntax.STACK_CAP }
    let mut s = expression_state.State { operators: seq.empty(), values: seq.empty(), ops: zero, vals: zero,
        token, operand: true, done: false, error: syntax.error(0, zero, zero),
        capacity, node_cap: cap, nodes, context, before_block, arguments, edges, frames: noun.atom(0) }
    for block in 0..256 {
        s = chunk(source, s)
        if (s.error.code == zero) == false { return expression_state.Parsed { nodes: s.nodes, arguments: s.arguments, edges: s.edges, value: zero, token: s.token, error: s.error } }
        if s.done {
            assert_eq(as_field(s.vals), 1)
            return expression_state.Parsed { nodes: s.nodes, arguments: s.arguments, edges: s.edges, value: as_u32(noun.as_field(seq.get(s.values, zero))), token: s.token, error: s.error }
        }
    }
    expression_state.Parsed { nodes: s.nodes, arguments: s.arguments, edges: s.edges, value: zero, token: s.token, error: syntax.error(7, s.token.start, s.token.end) }
}
