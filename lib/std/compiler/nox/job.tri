module std.compiler.nox.job

use vm.nox.noun
use vm.core.convert
use vm.core.field
use std.nox.bytes
use std.nox.seq
use std.nox.tree
use std.compiler.nox.syntax

const INV2: Field = 9223372034707292161
const INV4: Field = 13835058052060938241

// All handles have already crossed their structural admission boundary.
// The remaining allowance follows every later lookup/open, never each record.
pub struct Package {
    pub modules: seq.Seq, pub read_cost: U32, pub remaining: U32,
    pub source_limit: U32, pub options: Noun
}
// Joy validates the complete JOB1 and compiler identity before this guest runs.
// This view validates the records/collections it consumes; it does no I/O.
pub struct View {
    pub source: bytes.Bytes, pub name: bytes.Bytes, pub index: U32,
    pub sequence_limit: U32, pub depth_limit: U32, pub error: syntax.Error,
    pub package: Package
}

pub struct Found { pub exists: Bool, pub index: U32, pub remaining: U32 }
pub struct Source { pub content: bytes.Bytes, pub remaining: U32, pub error: syntax.Error }

#[pure]
#[requires((remaining < cost) == false)]
fn charge(remaining: U32, cost: U32) -> U32 {
    assert((remaining < cost) == false)
    as_u32(field.sub(as_field(remaining), as_field(cost)))
}

// Exactly index tails and one head. The caller charges these projections.
#[pure]
#[requires(index < as_u32(11))]
fn slot(body: Noun, index: U32) -> Noun {
    let mut cursor = body
    for i in 0..11 {
        if i == index { return noun.head(cursor) }
        cursor = noun.tail(cursor)
    }
    assert_eq(0, 1)
    noun.atom(0)
}

// Tag head + atom + body tail, arity tails, and terminator atom = arity+4.
#[pure]
fn record(value: Noun, tag: Field, arity: U32, remaining: U32) -> (Noun, U32) {
    let left = charge(remaining, as_u32(as_field(arity) + 4))
    assert_eq(noun.as_field(noun.head(value)), tag)
    let body = noun.tail(value)
    let mut cursor = body
    for i in 0..12 {
        if i == arity {
            assert_eq(noun.as_field(cursor), 0)
            return (body, left)
        }
        cursor = noun.tail(cursor)
    }
    assert_eq(0, 1)
    (body, left)
}

#[pure]
fn reject(name: bytes.Bytes, index: U32, code: Field) -> View {
    let zero = syntax.ZERO
    View { source: bytes.empty(), name, index, sequence_limit: zero,
        depth_limit: zero, error: syntax.error(code, zero, zero),
        package: Package { modules: seq.empty(), read_cost: zero, remaining: zero,
            source_limit: zero, options: noun.atom(0) } }
}

#[pure]
fn byte_cost(value: bytes.Bytes) -> U32 {
    let length = bytes.len(value)
    let rest = length & as_u32(3)
    let mut words = as_u32(field.sub(as_field(length), as_field(rest)) * INV4)
    if (rest == syntax.ZERO) == false { words = as_u32(as_field(words) + 1) }
    as_u32(as_field(tree.shape(words).height) + 1)
}

// Both paths are validated; repeated comparison reads still spend admission work.
#[pure]
fn before(left: bytes.Bytes, right: bytes.Bytes, allowance: U32) -> (Bool, U32) {
    let mut remaining = allowance
    let cost = as_u32(as_field(byte_cost(left)) + as_field(byte_cost(right)))
    for index in 0..255 {
        if index == bytes.len(left) { return (index < bytes.len(right), remaining) }
        if index == bytes.len(right) { return (false, remaining) }
        remaining = charge(remaining, cost)
        let a = bytes.get(left, index)
        let b = bytes.get(right, index)
        if a < b { return (true, remaining) }
        if b < a { return (false, remaining) }
    }
    (false, remaining)
}

// Binary search the admitted ASCII-sorted table: at most seventeen probes for
// 65536 records. Package indices never use the source/AST capacity sentinel.
#[pure]
#[requires((as_u32(65536) < seq.len(package.modules)) == false)]
#[requires((as_u32(255) < bytes.len(name)) == false)]
pub fn find(package: Package, name: bytes.Bytes) -> Found {
    assert((as_u32(65536) < seq.len(package.modules)) == false)
    assert((as_u32(255) < bytes.len(name)) == false)
    let wanted = bytes.to_noun(name)
    let mut remaining = package.remaining
    let mut low = syntax.ZERO
    let mut high = seq.len(package.modules)
    for turn in 0..17 {
        if low == high { return Found { exists: false, index: seq.len(package.modules), remaining } }
        let sum = as_u32(as_field(low) + as_field(high))
        let index = as_u32(field.sub(as_field(sum), as_field(sum & as_u32(1))) * INV2)
        remaining = charge(remaining, package.read_cost)
        let (body, left) = record(seq.get(package.modules, index), 1297040433, as_u32(4), remaining)
        remaining = charge(left, as_u32(1))
        let path = slot(body, syntax.ZERO)
        if noun.eq(path, wanted) { return Found { exists: true, index, remaining } }
        let (candidate, left) = bytes.from_noun_budget(path, as_u32(255), remaining)
        let (earlier, left) = before(candidate, name, left)
        remaining = left
        if earlier { low = as_u32(as_field(index) + 1) }
        else { high = index }
    }
    Found { exists: false, index: seq.len(package.modules), remaining }
}

// The resolver calls this once per newly reached source, after lookup.
#[pure]
#[requires(index < seq.len(package.modules))]
pub fn open(package: Package, index: U32, source_capacity: U32) -> Source {
    assert(index < seq.len(package.modules))
    let remaining = charge(package.remaining, package.read_cost)
    let (body, left) = record(seq.get(package.modules, index), 1297040433, as_u32(4), remaining)
    let remaining = charge(left, as_u32(7))
    let source = slot(body, as_u32(3))
    let length = as_u32(noun.as_field(noun.head(noun.tail(source))))
    if source_capacity < length {
        return Source { content: bytes.empty(), remaining, error: syntax.error(7, syntax.ZERO, syntax.ZERO) }
    }
    let (content, remaining) = bytes.from_noun_budget(source, package.source_limit, remaining)
    Source { content, remaining, error: syntax.error(0, syntax.ZERO, syntax.ZERO) }
}

#[pure]
pub fn read(input: Noun) -> View {
    // Bootstrap: tail(JOB), slot5, tail(LIM), slot4, atom = 14 probes.
    let raw_limits = slot(noun.tail(input), as_u32(5))
    let allowance = as_u32(noun.as_field(slot(noun.tail(raw_limits), as_u32(4))))
    let mut remaining = charge(allowance, as_u32(14))
    let (job, r0) = record(input, 1246708273, as_u32(6), remaining)
    let (limits, r1) = record(raw_limits, 1279872305, as_u32(11), r0)
    // Slots 0,3,7, with scalar projection for each: 2+5+9.
    remaining = charge(r1, as_u32(16))
    let source_limit = as_u32(noun.as_field(slot(limits, syntax.ZERO)))
    let sequence_limit = as_u32(noun.as_field(slot(limits, as_u32(3))))
    let depth_limit = as_u32(noun.as_field(slot(limits, as_u32(7))))
    // JOB entry name, function, options and package slots: 3+4+5+2.
    remaining = charge(remaining, as_u32(14))
    let entry = slot(job, as_u32(2))
    let function = slot(job, as_u32(3))
    let opts = slot(job, as_u32(4))
    let package = slot(job, as_u32(1))
    let (name, r2) = bytes.from_noun_budget(entry, as_u32(255), remaining)
    let (entry_function, r3) = bytes.from_noun_budget(function, as_u32(255), r2)
    let (options, r4) = record(opts, 1330664497, as_u32(5), r3)
    // Generated profile slots1/2 and their scalar projections: 3+4.
    remaining = charge(r4, as_u32(7))
    let input_profile = noun.as_field(slot(options, as_u32(1)))
    let output_profile = noun.as_field(slot(options, as_u32(2)))
    let (pkg, r5) = record(package, 1347110705, as_u32(1), remaining)
    remaining = charge(r5, as_u32(1))
    let (modules, r6) = seq.from_noun_budget(slot(pkg, syntax.ZERO), sequence_limit, remaining)
    remaining = r6
    let geometry = tree.shape(seq.len(modules))
    let read_cost = as_u32(as_field(geometry.height) + 1)
    for index in 0..65536 {
        if index == seq.len(modules) {
            assert_eq(0, 1)
            return reject(name, syntax.ZERO, 3)
        }
        // Indexed reads charge their complete path (height+1).
        // Bound is computed from the canonical occupied-leaf length.
        remaining = charge(remaining, read_cost)
        let (entry_record, left) = record(seq.get(modules, index), 1297040433, as_u32(4), remaining)
        remaining = charge(left, as_u32(1))
        if noun.eq(slot(entry_record, syntax.ZERO), entry) {
            if syntax.either((input_profile == 0) == false, (output_profile == 0) == false) { return reject(name, index, 6) }
            if (bytes.len(entry_function) == as_u32(4)) == false { return reject(name, index, 6) }
            // Four reads in the one-word entry-function payload.
            remaining = charge(remaining, as_u32(4))
            if syntax.either(syntax.either(syntax.either((bytes.get(entry_function, syntax.ZERO) == as_u32(109)) == false, (bytes.get(entry_function, as_u32(1)) == as_u32(97)) == false), (bytes.get(entry_function, as_u32(2)) == as_u32(105)) == false), (bytes.get(entry_function, as_u32(3)) == as_u32(110)) == false) { return reject(name, index, 6) }
            // Slot3 plus raw BYT1 length tail/head/atom: 4+3 probes.
            remaining = charge(remaining, as_u32(7))
            let source = slot(entry_record, as_u32(3))
            let source_length = as_u32(noun.as_field(noun.head(noun.tail(source))))
            if syntax.SOURCE_CAP < source_length { return reject(name, index, 7) }
            let (content, left) = bytes.from_noun_budget(source, source_limit, remaining)
            return View { source: content, name, index, sequence_limit, depth_limit,
                error: syntax.error(0, syntax.ZERO, syntax.ZERO),
                package: Package { modules, read_cost, remaining: left, source_limit, options: opts } }
        }
    }
    // The host contract guarantees a matching entry module.
    assert_eq(0, 1)
    reject(name, syntax.ZERO, 3)
}
