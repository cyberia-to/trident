module std.compiler.nox.record_frames

use vm.nox.noun
use vm.core.convert
use std.nox.seq

pub struct Frame { pub ty: Noun, pub fields: seq.Seq, pub values: seq.Seq,
    pub start: U32, pub base: U32, pub count: U32, pub pending: U32 }

#[pure]
pub fn pack(f: Frame) -> Noun {
    let position = noun.pair(noun.atom(as_field(f.start)), noun.atom(as_field(f.base)))
    let progress = noun.pair(noun.atom(as_field(f.count)), noun.atom(as_field(f.pending)))
    let data = noun.pair(f.ty, noun.pair(seq.to_noun(f.fields), seq.to_noun(f.values)))
    noun.pair(data, noun.pair(position, progress))
}

#[pure]
pub fn read(value: Noun) -> Frame {
    let data = noun.head(value)
    let meta = noun.tail(value)
    let position = noun.head(meta)
    let progress = noun.tail(meta)
    Frame { ty: noun.head(data), fields: seq.from_noun(noun.head(noun.tail(data)), as_u32(32), as_u32(63)),
        values: seq.from_noun(noun.tail(noun.tail(data)), as_u32(32), as_u32(63)),
        start: as_u32(noun.as_field(noun.head(position))), base: as_u32(noun.as_field(noun.tail(position))),
        count: as_u32(noun.as_field(noun.head(progress))), pending: as_u32(noun.as_field(noun.tail(progress))) }
}
