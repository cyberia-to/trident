module std.compiler.nox.record_assign

use vm.nox.noun
use vm.core.convert
use std.nox.bytes
use std.nox.seq
use std.compiler.nox.syntax
use std.compiler.nox.ast
use std.compiler.nox.lexer
use std.compiler.nox.expression
use std.compiler.nox.expression_state
use std.compiler.nox.body_state
use std.compiler.nox.blocks

struct Root { node: Noun, error: syntax.Error }

// Every accepted projection is a static field selection. Its stable LOCAL
// slot identifies the binding even when another name shadows an older slot.
#[pure]
fn root(nodes: seq.Seq, bindings: seq.Seq, lhs: U32) -> Root {
    let target = seq.get(nodes, lhs)
    let mut current = target
    for step in 0..65 {
        if ast.kind(current) == ast.LOCAL {
            let binding = seq.get(bindings, as_u32(ast.left(current)))
            if (noun.as_field(noun.head(noun.tail(binding))) == 1) == false {
                return Root { node: current, error: ast.issue(5, target) }
            }
            return Root { node: current, error: syntax.error(0, as_u32(0), as_u32(0)) }
        }
        if (ast.kind(current) == ast.PROJECT) == false { return Root { node: current, error: ast.issue(5, target) } }
        current = seq.get(nodes, as_u32(ast.left(current)))
    }
    Root { node: current, error: ast.issue(7, target) }
}

#[pure]
#[requires(lhs < seq.len(input.nodes))]
#[requires((syntax.SOURCE_CAP < bytes.len(source)) == false)]
pub fn assign(source: bytes.Bytes, input: body_state.State, lhs: U32, cap: U32) -> body_state.State {
    let mut s = input
    let target = seq.get(s.nodes, lhs)
    let selected = root(s.nodes, s.bindings, lhs)
    s.error = selected.error
    if (s.error.code == as_u32(0)) == false { return s }
    if seq.len(s.statements) == cap { s.error = ast.issue(7, target) return s }
    let rhs = expression.parse(source, lexer.next(source, s.token.end), expression_state.context(s.bindings, s.visible, s.functions, s.params, s.types), s.nodes, s.arguments, s.edges, cap, false)
    s.error = rhs.error
    if (s.error.code == as_u32(0)) == false { return s }
    let value = seq.get(rhs.nodes, rhs.value)
    if noun.eq(ast.ty(value), ast.ty(target)) == false { s.error = ast.issue(5, value) return s }
    if seq.len(rhs.nodes) == cap { s.error = ast.issue(7, value) return s }
    let edit = seq.len(rhs.nodes)
    s.nodes = seq.push(rhs.nodes, ast.typed(ast.RECORD_EDIT, as_field(lhs), as_field(rhs.value), ast.ty(selected.node), ast.start(target), ast.end(value)), cap)
    s.arguments = rhs.arguments
    s.edges = rhs.edges
    if rhs.needs_get { s.needs_get = true }
    s.token = rhs.token
    body_state.append(s, blocks.statement(blocks.WRITE, as_u32(ast.left(selected.node)), edit, as_u32(0)), cap)
}
